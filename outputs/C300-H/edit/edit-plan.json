        "file": "vo.mp3",
        "in": 111.94,
        "out": 115.18
      },
      "shots": [
        {
          "clip": "clip_29",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg29",
      "role": "body",
      "line": "Into something worse than the truth… and the worst was yet to show",
