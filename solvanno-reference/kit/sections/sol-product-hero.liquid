    <img id="visitor-flag" class="country-flag" alt="flag">
    <span id="estimated-delivery-window"></span>
  </div>
</div>
<script>
  (function(){
    var today = new Date();
    var startDate = new Date(today); startDate.setDate(today.getDate() + 4);
    var endDate = new Date(today); endDate.setDate(today.getDate() + 10);
    var showYear = startDate.getFullYear() !== endDate.getFullYear();
    var formatOptions = showYear
      ? { day: 'numeric', month: 'short', year: 'numeric' }
      : { day: 'numeric', month: 'short' };
    var startFormatted = startDate.toLocaleDateString('en-IN', formatOptions);
    var endFormatted = endDate.toLocaleDateString('en-IN', formatOptions);
    var win = document.getElementById('estimated-delivery-window');
    if (win) win.textContent = 'Estimated delivery between ' + startFormatted + ' and ' + endFormatted;
    fetch('/browsing_context_suggestions.json')
      .then(function(res){ return res.json(); })
      .then(function(data){
        var dv = data && data.detected_values;
        var code = (dv && dv.country && dv.country.handle ? dv.country.handle : '').toLowerCase();
        if (code) {
          var flag = document.getElementById('visitor-flag');
          if (flag) { flag.src = 'https://flagcdn.com/w40/' + code + '.png'; flag.alt = code.toUpperCase() + ' flag'; flag.style.display = 'inline-block'; }
        }
      })
      .catch(function(){});
  })();
</script>{%- endcapture -%}
