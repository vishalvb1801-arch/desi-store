{%- comment -%}
  EIS — payment brand mark.

  Renders a compact, recognisable mark for one payment brand inside a 48x32
  tile. These are simplified marks, not the brands' official artwork: drop an
  official PNG/SVG into the matching image setting on the hero section and it
  replaces the mark here.

  Usage: {% render 'eis-pay-mark', mark: 'visa' %}
{%- endcomment -%}
{%- case mark -%}

  {%- when 'gpay' -%}
    {%- comment -%}
      Google's own G: a ring with a bar into the centre, in four colours. The
      previous hand-drawn wedges filled the whole disc, so it read as a plain
      coloured circle rather than a G. Drawn here in Google's native 48x48 box
      and scaled into place, so the proportions stay right.
    {%- endcomment -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="Google Pay">
      <g transform="translate(0.4 7.8) scale(0.26)">
        <path d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.5 2.8-2.2 5.1-4.7 6.7v5.6h7.6c4.4-4.1 7-10.1 7-16.3z" fill="#4285F4"/>
        <path d="M24 47c6.3 0 11.6-2.1 15.5-5.7l-7.6-5.6c-2.1 1.4-4.8 2.2-7.9 2.2-6.1 0-11.2-4.1-13.1-9.6H3.1v6C7 42.1 14.9 47 24 47z" fill="#34A853"/>
        <path d="M10.9 28.3c-.5-1.4-.8-2.9-.8-4.4s.3-3 .8-4.4v-6H3.1C1.5 16.6.6 20.2.6 23.9s.9 7.3 2.5 10.4l7.8-6z" fill="#FBBC04"/>
        <path d="M24 9.9c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 3 30.3.8 24 .8 14.9.8 7 5.7 3.1 13.5l7.8 6c1.9-5.5 7-9.6 13.1-9.6z" fill="#EA4335"/>
      </g>
      <path d="M15.6 15.2v3.5h-1.4v-8.6h2.9c.7 0 1.3.2 1.8.7.5.5.8 1 .8 1.7s-.3 1.3-.8 1.8c-.5.5-1.1.7-1.8.7h-1.5zm0-3.7v2.4h1.6c.4 0 .8-.1 1-.4.3-.3.4-.6.4-.9s-.1-.6-.4-.9c-.3-.3-.6-.4-1-.4h-1.6z" fill="#5F6368"/>
      <path d="M22.6 12.5c1 0 1.8.3 2.4.8.6.5.9 1.3.9 2.2v3.2h-1.3v-1h-.1c-.4.7-1.1 1.1-1.9 1.1-.7 0-1.3-.2-1.7-.6-.5-.4-.7-.9-.7-1.5 0-.6.2-1.1.7-1.5.5-.4 1.1-.6 1.9-.6.7 0 1.2.1 1.7.4v-.3c0-.4-.2-.8-.5-1.1-.3-.3-.7-.4-1.2-.4-.7 0-1.2.3-1.6.9l-1.2-.8c.6-.6 1.4-.8 2.6-.8zm-1.8 4.3c0 .3.1.6.4.7.2.2.5.3.9.3.5 0 .9-.2 1.3-.5.4-.4.6-.8.6-1.2-.4-.3-.9-.4-1.5-.4-.5 0-.9.1-1.2.3-.3.2-.5.5-.5.8z" fill="#5F6368"/>
      <path d="M33.6 12.7l-3.7 8.5h-1.4l1.4-3-2.4-5.5h1.5l1.7 4.2h.1l1.7-4.2z" fill="#5F6368"/>
    </svg>

  {%- when 'phonepe' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="PhonePe">
      <rect x="17" y="9" width="14" height="14" rx="4" fill="#5F259F"/>
      <text x="24" y="20" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="10" font-weight="700" fill="#fff">&#8377;</text>
    </svg>

  {%- when 'paytm' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="Paytm">
      <text x="24" y="20" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" fill="#00BAF2">Pay<tspan fill="#20336B">tm</tspan></text>
    </svg>

  {%- when 'bhim' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="BHIM UPI">
      <text x="24" y="15" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="9" font-weight="700" fill="#00655B">BHIM</text>
      <text x="24" y="24" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="8" font-weight="700" fill="#E8740C">UPI</text>
    </svg>

  {%- when 'amazonpay' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="Amazon Pay">
      <text x="24" y="17" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="8.5" font-weight="700" fill="#232F3E">amazon</text>
      <path d="M14 20.5c3.2 1.8 7 2.6 10.4 2.6 2.4 0 5-.5 7.4-1.5.4-.2.7.2.4.5-2 1.7-5.2 2.6-8 2.6-3.9 0-7.4-1.4-10-3.8-.2-.2 0-.5.3-.4h-.5z" fill="#FF9900"/>
      <path d="M33.2 19.6c-.4-.5-2.6-.3-3.6-.1-.3 0-.3-.2-.1-.4 1.7-1.2 4.6-.8 4.9-.5.3.4-.1 3.2-1.7 4.5-.2.2-.5.1-.4-.2.4-.9 1.2-3 .9-3.3z" fill="#FF9900"/>
    </svg>

  {%- when 'visa' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="Visa">
      <text x="24" y="21" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="13" font-weight="700" font-style="italic" fill="#1A1F71">VISA</text>
    </svg>

  {%- when 'mastercard' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="Mastercard">
      <circle cx="20" cy="16" r="8" fill="#EB001B"/>
      <circle cx="28" cy="16" r="8" fill="#F79E1B"/>
      <path d="M24 9.9a8 8 0 0 0 0 12.2 8 8 0 0 0 0-12.2z" fill="#FF5F00"/>
    </svg>

  {%- when 'rupay' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="RuPay">
      <text x="23" y="20" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" font-style="italic" fill="#097E40">Ru<tspan fill="#F26F21">Pay</tspan></text>
      <path d="M38 11l3 5-3 5z" fill="#097E40"/>
      <path d="M34.5 11l3 5-3 5z" fill="#F26F21"/>
    </svg>

  {%- when 'amex' -%}
    <svg viewBox="0 0 48 32" role="img" aria-label="American Express">
      <rect x="8" y="8" width="32" height="16" rx="2" fill="#006FCF"/>
      <text x="24" y="18.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="7.5" font-weight="700" fill="#fff">AMEX</text>
    </svg>

{%- endcase -%}
