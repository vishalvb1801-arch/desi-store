{%- comment -%}
  EIS — Timeline ("What to expect")
  ------------------------------------------------------------------
  Stages down a connecting rail. Each stage is a full-width card whose top
  edge is straddled by a round photo on the left and a stage pill on the
  right; a hairline runs between consecutive cards. Empty image slots keep
  the design's striped placeholder so the rhythm is right before real
  photos land.
{%- endcomment -%}

{% render 'eis-fonts' %}

{% style %}
  {% render 'eis-tokens', id: section.id, s: section.settings %}

  .eis-time {
    background: var(--eis-maroon-deep);
    font-family: var(--eis-sans);
  }
  .eis-time__inner {
    max-width: var(--eis-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .eis-time__title {
    font-family: var(--eis-serif);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    color: var(--eis-cream-light);
    text-align: center;
    margin: 0 0 24px;
    line-height: 1.18;
  }
  .eis-time__list {
    --eis-marker: {{ section.settings.marker_size }}px;
    --eis-gap: {{ section.settings.stage_gap }}px;
    display: flex;
    flex-direction: column;
    gap: var(--eis-gap);
    /* room for the first card's circle, which hangs above it */
    padding-top: calc(var(--eis-marker) * .46);
  }
  .eis-time__row { position: relative; }
  /* The rail: one hairline per gap, centred on the circle below it. That
     circle covers the line's lower end, so it reads as running into the photo
     rather than through it. */
  .eis-time__row + .eis-time__row::before {
    content: "";
    position: absolute;
    left: calc(16px + var(--eis-marker) / 2);
    top: calc(-1 * var(--eis-gap));
    width: 1px;
    height: var(--eis-gap);
    background: rgba(246, 231, 200, .35);
  }
  .eis-time__card {
    background: #FFFDF8;
    border-radius: 14px;
    /* top padding clears the circle that overlaps this edge */
    padding: calc(var(--eis-marker) * .58) 16px 16px;
    position: relative;
  }
  .eis-time__marker {
    position: absolute;
    top: calc(var(--eis-marker) * -.46);
    left: 16px;
    width: var(--eis-marker);
    height: var(--eis-marker);
    border-radius: 999px;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #EDE1CE 0 6px, #F9F1E4 6px 12px);
    box-shadow: 0 0 0 3px var(--eis-maroon-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 7px ui-monospace, monospace;
    color: var(--eis-soft);
    text-align: center;
    padding: 4px;
  }
  .eis-time__marker img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .eis-time__badge {
    position: absolute;
    top: -11px;
    right: 16px;
    background: var(--eis-green);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .eis-time__point {
    display: flex;
    gap: 9px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--eis-ink);
  }
  .eis-time__point + .eis-time__point { margin-top: 9px; }
  .eis-time__tick {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    border-radius: 5px;
    background: var(--eis-green);
    color: #fff;
    font-size: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .eis-time__note {
    font-size: 12px;
    line-height: 1.55;
    color: #D9C6A2;
    text-align: center;
    margin: 26px 0 0;
  }
{% endstyle %}

<div class="eis-time">
  <div class="eis-time__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="eis-time__title">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}

    <div class="eis-time__list">
      {%- for block in section.blocks -%}
        <div class="eis-time__row" {{ block.shopify_attributes }}>
          <div class="eis-time__card">
            <div class="eis-time__marker" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 220
                  | image_tag: widths: '110, 160, 220', sizes: '72px', loading: 'lazy', alt: ''
                }}
              {%- else -%}
                {{ block.settings.placeholder_note }}
              {%- endif -%}
            </div>
            {%- if block.settings.badge != blank -%}
              <div class="eis-time__badge">{{ block.settings.badge }}</div>
            {%- endif -%}
            {%- if block.settings.point_1 != blank -%}
              <div class="eis-time__point">
                <span class="eis-time__tick" aria-hidden="true">✓</span>
                <span>{{ block.settings.point_1 }}</span>
              </div>
            {%- endif -%}
            {%- if block.settings.point_2 != blank -%}
              <div class="eis-time__point">
                <span class="eis-time__tick" aria-hidden="true">✓</span>
                <span>{{ block.settings.point_2 }}</span>
              </div>
            {%- endif -%}
            {%- if block.settings.point_3 != blank -%}
              <div class="eis-time__point">
                <span class="eis-time__tick" aria-hidden="true">✓</span>
                <span>{{ block.settings.point_3 }}</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="eis-time__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "EIS — Timeline",
  "tag": "section",
  "class": "eis-section eis-section--timeline",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "What to Expect\nWhen You Start\nUsing EIS Nightly"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Photo circle size",
      "min": 48,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "stage_gap",
      "label": "Space between stages",
      "info": "The connecting hairline fills this gap.",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "text",
      "id": "note",
      "label": "Closing note",
      "default": "Customers report their best results after 3–4 weeks of nightly use — consistency is the key."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_maroon_deep",
      "label": "Background",
      "default": "#5C0D0F"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Heading",
      "default": "#F6E7C8"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Card text",
      "default": "#2A1C18"
    },
    {
      "type": "color",
      "id": "color_green",
      "label": "Badge & ticks",
      "default": "#1E7A4D"
    },
    {
      "type": "color",
      "id": "color_soft",
      "label": "Placeholder text",
      "default": "#8A7A63"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Stage badge",
          "default": "NIGHT 1–2"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "placeholder_note",
          "label": "Placeholder note",
          "info": "Shown in the circle until you add a photo.",
          "default": "night massage"
        },
        {
          "type": "text",
          "id": "point_1",
          "label": "Line 1",
          "default": "Warm it, massage it in before bed."
        },
        {
          "type": "text",
          "id": "point_2",
          "label": "Line 2"
        },
        {
          "type": "text",
          "id": "point_3",
          "label": "Line 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EIS — Timeline",
      "blocks": [
        {
          "type": "stage",
          "settings": {
            "badge": "NIGHT 1–2",
            "placeholder_note": "night massage",
            "point_1": "Warm it, massage it in before bed.",
            "point_2": "The area feels lighter and stiffness starts to ease."
          }
        },
        {
          "type": "stage",
          "settings": {
            "badge": "DAY 3–7",
            "placeholder_note": "morning stretch",
            "point_1": "Morning stiffness eases.",
            "point_2": "You wake up moving more freely."
          }
        },
        {
          "type": "stage",
          "settings": {
            "badge": "WEEK 2–4",
            "placeholder_note": "walk / stairs",
            "point_1": "Relief lasts longer through the day.",
            "point_2": "Back on your walks, stairs and daily activities."
          }
        },
        {
          "type": "stage",
          "settings": {
            "badge": "WEEK 4+",
            "placeholder_note": "family photo",
            "point_1": "Consistent nightly use keeps joints loose and comfortable long-term."
          }
        }
      ]
    }
  ]
}
{% endschema %}
