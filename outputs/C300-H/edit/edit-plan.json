        "file": "vo.mp3",
        "in": 108.59,
        "out": 111.94
      },
      "shots": [
        {
          "clip": "clip_28",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg29",
      "role": "body",
      "line": "And I stood there in that hallway, watching my little lie grow",
