        "file": "vo.mp3",
        "in": 146.96,
        "out": 149.94
      },
      "shots": [
        {
          "clip": "clip_42",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg41",
      "role": "body",
      "line": "That night there was something on my pillow, and a promise she would keep",
