{%- comment -%}
  SOL — Stats block
  ------------------------------------------------------------------
  Survey figures on deep maroon, each with a gold progress line that fills
  when it scrolls into view.
{%- endcomment -%}

{% render 'sol-fonts' %}

{% style %}
  {% render 'sol-tokens', id: section.id, s: section.settings %}

  .sol-stats {
    background-color: #364811;
    font-family: var(--sol-sans);
  }
  .sol-stats__inner {
    max-width: var(--sol-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }
  .sol-stats__title {
    font-family: var(--sol-serif);
    font-size: 29px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 26px;
    line-height: 1.15;
  }
  .sol-stats__value {
    font-family: var(--sol-serif);
    font-style: italic;
    font-size: 52px;
    color: #FFD166;
    line-height: 1;
  }
  .sol-stats__label {
    font-size: 13px;
    color: #FFF1C7;
    line-height: 1.5;
    margin-top: 6px;
  }
  .sol-stats__track {
    height: 2px;
    background: rgba(255, 241, 199, .24);
    border-radius: 2px;
    margin: 16px 0 26px;
    position: relative;
  }
  .sol-stats__fill {
    height: 2px;
    background: var(--sol-gold-light);
    border-radius: 2px;
    width: 0;
    transition: width 1.2s ease;
  }
  .sol-stats__knob {
    position: absolute;
    top: -9px;
    left: 0;
    transform: translateX(-50%);
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--sol-gold-light);
    color: #2c4a2a;
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: left 1.2s ease;
  }
  .sol-stats.is-in .sol-stats__fill { width: var(--sol-pct); }
  .sol-stats.is-in .sol-stats__knob { left: var(--sol-pct); }
  @media (prefers-reduced-motion: reduce) {
    .sol-stats__fill,
    .sol-stats__knob { transition: none; }
  }
  .sol-stats__foot {
    font-family: var(--sol-serif);
    font-style: italic;
    font-size: 12px;
    color: #FFD166;
  }
  .sol-stats__image-slot {
    display: none;
  }
  .sol-stats__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 16px;
  }
  .sol-stats__image-placeholder {
    width: 100%;
    height: 100%;
    border: 2px dashed rgba(90, 53, 31, .35);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2c4a2a;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    background: rgba(255, 143, 101, .08);
  }
  .sol-stats__curve {
    display: block;
    width: 100%;
    height: {{ section.settings.curve_height }}px;
    margin-bottom: -1px;
  }

  /* ---------- desktop & iPad ---------- */
  @media (min-width: 750px) {
    .sol-stats__inner {
      max-width: 976px;
      display: grid;
      grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
      column-gap: 40px;
      align-items: start;
    }
    .sol-stats__title { grid-column: 1; font-size: 34px; }
    .sol-stats__row, .sol-stats__foot { grid-column: 2; }
    .sol-stats__image-slot {
      display: block;
      grid-column: 1;
      grid-row: 2 / span 99;
      width: min(100%, 420px);
      height: min(300px, 71.43vw);
      max-height: 300px;
      margin: 6px auto 0;
    }
  }
  @media (min-width: 1200px) {
    .sol-stats__inner { max-width: 1280px; grid-template-columns: minmax(0, 588px) minmax(0, 1fr); column-gap: 72px; }
    .sol-stats__title { font-size: 42px; }
  }
{% endstyle %}

<div class="sol-stats" data-sol-stats>
  <div class="sol-stats__inner">
    {%- assign desktop_photo_block = section.blocks | where: 'type', 'desktop_image' | first -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="sol-stats__title">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}

    {%- if desktop_photo_block != blank -%}
      <div class="sol-stats__image-slot" {{ desktop_photo_block.shopify_attributes }}>
        {%- assign stats_alt = desktop_photo_block.settings.image_alt | escape -%}
        {%- if desktop_photo_block.settings.image != blank -%}
          {{
            desktop_photo_block.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '450, 588, 900, 1200',
              sizes: '(min-width: 750px) 420px, 44vw',
              loading: 'lazy',
              class: 'sol-stats__image',
              alt: stats_alt
          }}
        {%- else -%}
          <img class="sol-stats__image" src="https://cdn.shopify.com/s/files/1/0779/1601/2763/files/Transparent_Product.png?v=1788651458" loading="lazy" alt="{{ stats_alt }}">
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="sol-stats__row" {{ block.shopify_attributes }}>
          <div class="sol-stats__value">{{ block.settings.value }}</div>
          <div class="sol-stats__label">{{ block.settings.label }}</div>
          <div class="sol-stats__track" style="--sol-pct: {{ block.settings.percent }}%">
            <div class="sol-stats__fill"></div>
            <div class="sol-stats__knob" aria-hidden="true">{{ block.settings.icon }}</div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.footnote != blank -%}
      <div class="sol-stats__foot">{{ section.settings.footnote }}</div>
    {%- endif -%}


  </div>

  {%- unless section.settings.curve_style == 'none' -%}
    <svg
      class="sol-stats__curve"
      viewBox="0 0 1200 100"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {%- if section.settings.curve_style == 'concave' -%}
        <path d="M0,100 Q600,-100 1200,100 Z" fill="{{ section.settings.curve_color }}"></path>
      {%- else -%}
        <path d="M0,0 Q600,200 1200,0 L1200,100 L0,100 Z" fill="{{ section.settings.curve_color }}"></path>
      {%- endif -%}
    </svg>
  {%- endunless -%}
</div>

<script>
  (function () {
    var el = document.querySelector('#shopify-section-{{ section.id }} [data-sol-stats]');
    if (!el) return;

    /* No IntersectionObserver (old Android WebViews): just show the filled state. */
    if (!('IntersectionObserver' in window)) {
      el.classList.add('is-in');
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            entries[i].target.classList.add('is-in');
            io.unobserve(entries[i].target);
          }
        }
      },
      { threshold: 0.25 }
    );
    io.observe(el);
  })();
</script>

{% schema %}
{
  "name": "SOL — Stats block",
  "tag": "section",
  "class": "sol-section sol-section--stats",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "After 36,243 Bottles,\nThe Results Are In."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Based on customer survey data*"
    },
    {
      "type": "header",
      "content": "Bottom edge"
    },
    {
      "type": "select",
      "id": "curve_style",
      "label": "Shape",
      "options": [
        { "value": "convex", "label": "Curved down" },
        { "value": "concave", "label": "Curved up" },
        { "value": "none", "label": "Straight" }
      ],
      "default": "convex"
    },
    {
      "type": "range",
      "id": "curve_height",
      "label": "Curve depth",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "curve_color",
      "label": "Colour below the curve",
      "info": "Match the next section's background.",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_maroon_deep",
      "label": "Background",
      "default": "#1e3a16"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Heading",
      "default": "#edf3d6"
    },
    {
      "type": "color",
      "id": "color_gold_light",
      "label": "Figures & bar",
      "default": "#c3d34a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "default": "89%" },
        { "type": "text", "id": "label", "label": "Description", "default": "reported less stiffness and pain within the first week" },
        { "type": "range", "id": "percent", "label": "Bar fill", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 89 },
        { "type": "text", "id": "icon", "label": "Marker character", "default": "☾" }
      ]
    },
    {
      "type": "desktop_image",
      "name": "Desktop image",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Choose or upload image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Magnetic Sensor Light glowing in a modern home" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOL — Stats block",
      "blocks": [
        { "type": "stat", "settings": { "value": "89%", "label": "reported less stiffness and pain within the first week", "percent": 89, "icon": "☾" } },
        { "type": "stat", "settings": { "value": "92%", "label": "noticed relief lasting longer than balms or sprays", "percent": 92, "icon": "❍" } },
        { "type": "stat", "settings": { "value": "86%", "label": "said they moved more easily within 30 days", "percent": 86, "icon": "✦" } }
      ]
    }
  ]
}
{% endschema %}
