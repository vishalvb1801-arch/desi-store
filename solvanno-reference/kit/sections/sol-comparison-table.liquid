          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "shield",
            "label": "No burning, no numbing"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "families",
            "label": "Gentle for nightly use"
          }
        },
        {
          "type": "row",
          "settings": {
