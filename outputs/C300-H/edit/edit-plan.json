        "file": "vo.mp3",
        "in": 40.22,
        "out": 44.84
      },
      "shots": [
        {
          "clip": "clip_12",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg13",
      "role": "body",
      "line": "I kept one secret in my glovebox, another in my office drawer",
