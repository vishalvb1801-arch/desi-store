          "clip": "clip_39",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg38",
      "role": "body",
      "line": "Next morning she called her mother back in Nashik on the phone",
