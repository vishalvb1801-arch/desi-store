        "file": "vo.mp3",
        "in": 101.92,
        "out": 105.16
      },
      "shots": [
        {
          "clip": "clip_26",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg26",
      "role": "body",
      "line": "He's on that balcony at 2 AM, on his phone… and I know who",
