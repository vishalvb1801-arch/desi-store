          "clip": "clip_34",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg33",
      "role": "body",
      "line": "\"Back pain only at night\"… \"How do I hide it from my wife?\"",
