        "file": "vo.mp3",
        "in": 44.84,
        "out": 49.06
      },
      "shots": [
        {
          "clip": "clip_13",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg13",
      "role": "body",
      "line": "And every night by ten-fifteen, I was \"too tired\" once more",
