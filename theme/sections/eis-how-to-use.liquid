{%- comment -%}
  EIS — How to use
  ------------------------------------------------------------------
  New section, not in the original prototype. Numbered application steps in
  the house style, closed by a safety note.
{%- endcomment -%}

{% render 'eis-fonts' %}

{%- liquid
  assign safety_count = 0
  assign media_count = 0
  for block in section.blocks
    if block.type == 'safety_note'
      assign safety_count = safety_count | plus: 1
    endif
    if block.type == 'step'
      assign media_count = media_count | plus: 1
    endif
  endfor
-%}

{% style %}
  {% render 'eis-tokens', id: section.id, s: section.settings %}

  .eis-how {
    background: var(--eis-cream);
    font-family: var(--eis-sans);
    color: var(--eis-ink);
  }
  .eis-how__inner {
    max-width: var(--eis-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .eis-how__head { text-align: center; }
  .eis-how__eyebrow {
    display: inline-block;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;
    letter-spacing: .18em;
    color: var(--eis-soft);
    border: 1px solid var(--eis-soft);
    border-radius: 999px;
    /* tight vertical padding: the pill hugs the word rather than framing it */
    padding: {{ section.settings.eyebrow_padding }}px 13px;
  }
  .eis-how__title {
    font-family: var(--eis-serif);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    color: var(--eis-maroon);
    margin: 10px 0 8px;
    line-height: 1.18;
  }
  .eis-how__intro {
    font-size: 13px;
    line-height: 1.55;
    color: var(--eis-muted);
    margin: 0 0 20px;
  }
  .eis-how__steps {
    display: flex;
    align-items: stretch;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .eis-how__steps::-webkit-scrollbar { display: none; }
  .eis-how__step {
    /* square by default; a card whose copy needs more room grows past it
       rather than clipping */
    flex: 0 0 calc((100% - ({{ section.settings.cards_in_view }} - 1) * 10px) / {{ section.settings.cards_in_view }});
    aspect-ratio: 1 / 1;
    height: auto;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    background: #FFFDF8;
    border: 1px solid #EFE0C9;
    border-radius: 12px;
    padding: 14px;
    position: relative;
  }
  /* Once any step carries a photo the cards stop forcing themselves square and
     size to their content instead, stretching to match the tallest. */
  .eis-how--media .eis-how__step { aspect-ratio: auto; }
  .eis-how__step-media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.step_image_ratio }};
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
  }
  /* No photo yet: keep the square reserved and show where one goes, rather
     than collapsing the card and shifting the layout when images land. */
  .eis-how__step-media--empty {
    background: repeating-linear-gradient(135deg, #EDE1CE 0 8px, #F9F1E4 8px 16px);
    display: flex;
    align-items: flex-end;
    padding: 8px;
  }
  .eis-how__step-media--empty span {
    font: 9px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #8A7A63;
    line-height: 1.3;
  }
  .eis-how__step-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .eis-how__num {
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 999px;
    background: var(--eis-maroon);
    color: var(--eis-cream-light);
    font-family: var(--eis-serif);
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .eis-how__num span {
    position: absolute;
    right: -4px;
    bottom: -4px;
    width: 17px;
    height: 17px;
    border-radius: 999px;
    background: var(--eis-gold);
    color: #3B0E0F;
    font-family: var(--eis-sans);
    font-size: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Declared after .eis-how__num: same specificity, so it has to come later to
     beat that rule's position: relative. Pinned to the card, not the photo, so
     it laps over the photo's corner. */
  .eis-how__num--over {
    position: absolute;
    top: 7px;
    left: 7px;
    z-index: 1;
    box-shadow: 0 0 0 2px #FFFDF8, 0 2px 8px rgba(0, 0, 0, .35);
  }
  .eis-how__step-media + .eis-how__step-title { margin-top: 0; }
  .eis-how__step-title {
    margin-top: 11px;
    font-size: 14px;
    font-weight: 700;
    font-family: var(--eis-serif);
    color: var(--eis-maroon);
  }
  .eis-how__step-text {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--eis-muted);
    margin-top: 4px;
  }
  .eis-how__step-time {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .07em;
    color: #3B0E0F;
    background: var(--eis-gold);
    border-radius: 5px;
    padding: 3px 8px;
    margin-top: auto;
  }
  .eis-how__safety {
    border: 1px dashed var(--eis-gold);
    border-radius: 11px;
    background: #FDF9F1;
    padding: 14px;
    margin-top: 16px;
  }
  .eis-how__safety-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    color: var(--eis-maroon);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .eis-how__safety-list {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .eis-how__safety-list li {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--eis-muted);
  }
  .eis-how__safety-list b { color: var(--eis-ink); font-weight: 700; }
  .eis-how__tick {
    color: var(--eis-green);
    font-size: 12px;
    flex: none;
    margin-top: 2px;
  }

  /* ---------- desktop & iPad ---------- */
  @media (min-width: 750px) {
    .eis-how__inner {
      max-width: 976px;
      display: grid;
      grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
      grid-template-rows: min-content 1fr;
      column-gap: 32px;
      align-items: start;
    }
    .eis-how__head { grid-column: 1; grid-row: 1; }
    .eis-how__safety { grid-column: 1; grid-row: 2; }
    .eis-how__steps {
      grid-column: 2;
      grid-row: 1 / span 2;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      overflow: visible;
    }
    .eis-how__step { flex: initial; width: auto; min-width: 0; scroll-snap-align: none; }
    .eis-how__title { font-size: 34px; }
  }
  @media (min-width: 1200px) {
    .eis-how__inner { max-width: 1280px; grid-template-columns: minmax(0, 512px) minmax(0, 1fr); column-gap: 56px; }
    .eis-how__steps { gap: 24px; }
    .eis-how__title { font-size: 42px; }
  }
{% endstyle %}

<div class="eis-how{% if media_count > 0 %} eis-how--media{% endif %}">
  <div class="eis-how__inner">
    <div class="eis-how__head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="eis-how__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="eis-how__title">{{ section.settings.heading | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="eis-how__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="eis-how__steps">
      {%- assign step_number = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          {%- assign step_number = step_number | plus: 1 -%}
          <div class="eis-how__step" {{ block.shopify_attributes }}>
            {%- capture step_num -%}
              {{ step_number }}
              {%- if block.settings.icon != blank -%}
                <span>{{ block.settings.icon }}</span>
              {%- endif -%}
            {%- endcapture -%}
            {%- if block.settings.image != blank -%}
              <div class="eis-how__step-media">
                {{
                  block.settings.image
                  | image_url: width: 480
                  | image_tag: widths: '160, 240, 320, 480', sizes: '55vw', loading: 'lazy', alt: ''
                }}
              </div>
            {%- else -%}
              <div class="eis-how__step-media eis-how__step-media--empty">
                {%- if block.settings.placeholder_note != blank -%}
                  <span>{{ block.settings.placeholder_note }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="eis-how__num eis-how__num--over" aria-hidden="true">{{ step_num }}</div>
            <div class="eis-how__step-title">{{ block.settings.title }}</div>
            {%- if block.settings.text != blank -%}
              <div class="eis-how__step-text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.time_label != blank -%}
              <div class="eis-how__step-time">{{ block.settings.time_label }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if safety_count > 0 -%}
      <div class="eis-how__safety">
        {%- if section.settings.safety_title != blank -%}
          <div class="eis-how__safety-title">
            <span aria-hidden="true">{{ section.settings.safety_icon }}</span>
            {{ section.settings.safety_title }}
          </div>
        {%- endif -%}
        <ul class="eis-how__safety-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'safety_note' -%}
              <li {{ block.shopify_attributes }}>
                <span class="eis-how__tick" aria-hidden="true">✓</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "EIS — How to use",
  "tag": "section",
  "class": "eis-section eis-section--how",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HOW TO USE"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_padding",
      "label": "Eyebrow padding",
      "info": "Space between the word and the pill's edge.",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "4 Steps,\nEvery Day"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 46,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "Takes about ten minutes. Do it consistently and the results build week on week."
    },
    {
      "type": "range",
      "id": "cards_in_view",
      "label": "Step cards in view",
      "info": "The steps scroll sideways; a part-shown card is what signals that.",
      "min": 1.1,
      "max": 2.6,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "select",
      "id": "step_image_ratio",
      "label": "Step photo shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "Safety note"
    },
    {
      "type": "text",
      "id": "safety_icon",
      "label": "Icon character",
      "default": "✷"
    },
    {
      "type": "text",
      "id": "safety_title",
      "label": "Title",
      "default": "GOOD TO KNOW"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Background",
      "default": "#FBF3E7"
    },
    {
      "type": "color",
      "id": "color_maroon",
      "label": "Headings",
      "default": "#7B1315"
    },
    {
      "type": "color",
      "id": "color_gold",
      "label": "Gold accent",
      "default": "#C9A24A"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Number text",
      "default": "#F6E7C8"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#2A1C18"
    },
    {
      "type": "color",
      "id": "color_muted",
      "label": "Muted text",
      "default": "#5E5147"
    },
    {
      "type": "color",
      "id": "color_soft",
      "label": "Eyebrow",
      "default": "#B3161A"
    },
    {
      "type": "color",
      "id": "color_green",
      "label": "Tick green",
      "default": "#1E7A4D"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Warm it"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Rub a little between your palms until it feels warm — never hot."
        },
        {
          "type": "text",
          "id": "placeholder_note",
          "label": "Placeholder note",
          "info": "Only shown while no photo is set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (optional)",
          "info": "Cropped to the shape set on the section. Cards stay square until at least one step has a photo."
        },
        {
          "type": "text",
          "id": "time_label",
          "label": "Badge (optional)"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Corner icon (optional)"
        }
      ]
    },
    {
      "type": "safety_note",
      "name": "Safety line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Basic HTML like <b> works.",
          "default": "<b>External use only.</b> Do not swallow."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EIS — How to use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Warm it",
            "text": "Rub a little between your palms until it feels warm — never hot.",
            "icon": "☾"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Apply to the sore area",
            "text": "Knee, back, shoulder, neck or calf. Enough for a thin film.",
            "icon": "❍"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Massage in circular motion",
            "text": "Slow, firm circles until it absorbs and the area feels warm.",
            "time_label": "5–10 MINUTES",
            "icon": "✦"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Nightly, before bed",
            "text": "Best at night, so it works while you sleep. Twice daily in a flare-up.",
            "time_label": "EVERY NIGHT",
            "icon": "☘"
          }
        },
        {
          "type": "safety_note",
          "settings": {
            "text": "<b>External use only.</b> Do not swallow. Keep away from eyes and broken skin."
          }
        },
        {
          "type": "safety_note",
          "settings": {
            "text": "<b>Safe for daily use.</b> Gentle enough to apply every night, long-term."
          }
        },
        {
          "type": "safety_note",
          "settings": {
            "text": "<b>Made specially for sensitive skin.</b>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
