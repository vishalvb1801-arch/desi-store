{%- comment -%}
  EIS — Offer repeat
  ------------------------------------------------------------------
  The second ask, further down the page. Like the hero, the ladder itself is
  an app-block slot — drop the MoonBundle block in here too.

  The countdown counts to a real deadline you set, to midnight each day, or
  down a fixed number of minutes per visitor. That last one is a scarcity
  timer, not a real deadline: it starts when the visitor lands, survives a
  refresh (it is held in sessionStorage), and restarts in a new session.
{%- endcomment -%}

{% render 'eis-fonts' %}

{%- liquid
  assign eis_product = section.settings.product | default: product

  assign app_block_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_block_count = app_block_count | plus: 1
    endif
  endfor
-%}

{% style %}
  {% render 'eis-tokens', id: section.id, s: section.settings %}

  .eis-repeat {
    background: var(--eis-cream);
    font-family: var(--eis-sans);
    color: var(--eis-ink);
  }
  .eis-repeat__inner {
    max-width: var(--eis-max);
    margin: 0 auto;
    padding: 0 16px {{ section.settings.padding_bottom }}px;
  }
  .eis-repeat__urgency {
    background: var(--eis-maroon-deep);
    color: var(--eis-cream-light);
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    padding: 10px;
    border-radius: 0 0 10px 10px;
  }
  .eis-repeat__title {
    font-family: var(--eis-serif);
    font-size: 28px;
    font-weight: 600;
    color: var(--eis-maroon);
    text-align: center;
    margin: 24px 0 10px;
    line-height: 1.18;
  }
  .eis-repeat__intro {
    font-size: 13px;
    line-height: 1.5;
    color: var(--eis-muted);
    text-align: center;
    margin: 0 0 16px;
  }
  /* Without the heading the intro is the first thing under the bar, so it
     carries the top margin the heading used to. */
  .eis-repeat__intro:first-child { margin-top: 24px; }
  .eis-repeat__image {
    display: block;
    width: {{ section.settings.image_width }}%;
    margin: 0 auto;
    height: {{ section.settings.image_height }}px;
    object-fit: contain;
  }
  .eis-repeat__offers-title {
    font-family: var(--eis-serif);
    font-size: 21px;
    font-weight: 600;
    color: var(--eis-ink);
    margin: 8px 0 12px;
  }
  .eis-repeat__app-block + .eis-repeat__app-block { margin-top: 12px; }
  .eis-repeat__slot-empty {
    border: 1px dashed var(--eis-gold);
    border-radius: 11px;
    background: #FDF9F1;
    padding: 18px 16px;
    text-align: center;
  }
  .eis-repeat__slot-empty b { display: block; font-size: 13px; margin-bottom: 6px; color: var(--eis-maroon); }
  .eis-repeat__slot-empty span { font-size: 11.5px; line-height: 1.5; color: var(--eis-muted); }
  .eis-repeat__stock {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-top: 12px;
    font-size: 11.5px;
    color: var(--eis-muted);
  }
  .eis-repeat__dot { color: var(--eis-green); }

  /* ---------- desktop & iPad ---------- */
  @media (min-width: 750px) {
    .eis-repeat__inner { max-width: 976px; padding-left: 12px; padding-right: 12px; }
  }
  @media (min-width: 1200px) {
    .eis-repeat__inner { max-width: 1280px; }
  }
{% endstyle %}

<div class="eis-repeat">
  {%- if section.settings.show_urgency -%}
    <div
      class="eis-repeat__urgency"
      data-eis-countdown
      data-mode="{{ section.settings.countdown_mode }}"
      data-deadline="{{ section.settings.countdown_deadline }}"
      data-minutes="{{ section.settings.countdown_minutes }}"
      data-key="{{ section.id }}"
      data-prefix="{{ section.settings.urgency_text | escape }}"
      data-ended="{{ section.settings.urgency_ended_text | escape }}"
    >
      {{ section.settings.urgency_text }}
    </div>
  {%- endif -%}

  <div class="eis-repeat__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="eis-repeat__title">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="eis-repeat__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    {%- liquid
      if section.settings.image != blank
        assign repeat_image = section.settings.image
      else
        assign repeat_image = eis_product.featured_image
      endif
      assign repeat_alt = section.settings.image_alt | escape
    -%}
    {%- if repeat_image != blank -%}
      {{
        repeat_image
        | image_url: width: 800
        | image_tag:
          widths: '280, 400, 560, 800',
          sizes: '70vw',
          loading: 'lazy',
          class: 'eis-repeat__image',
          alt: repeat_alt
      }}
    {%- endif -%}

    <div class="eis-repeat__offers" id="EisRepeatOffers-{{ section.id }}">
      {%- if section.settings.offers_heading != blank -%}
        <h3 class="eis-repeat__offers-title">{{ section.settings.offers_heading }}</h3>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="eis-repeat__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      {%- if app_block_count == 0 and request.design_mode -%}
        <div class="eis-repeat__slot-empty">
          <b>Offer ladder slot — empty</b>
          <span>
            Click <em>Add block</em> on this section and choose your MoonBundle block, the same
            one you used in the hero. Only you can see this message.
          </span>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.stock_text != blank -%}
      <div class="eis-repeat__stock">
        <span class="eis-repeat__dot" aria-hidden="true">●</span>{{ section.settings.stock_text }}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_urgency -%}
  <script>
    (function () {
      var el = document.querySelector('#shopify-section-{{ section.id }} [data-eis-countdown]');
      if (!el) return;

      var mode = el.getAttribute('data-mode');
      var prefix = el.getAttribute('data-prefix') || '';
      var ended = el.getAttribute('data-ended') || '';
      var deadlineAttr = el.getAttribute('data-deadline');
      var minutes = parseFloat(el.getAttribute('data-minutes'));
      var storeKey = 'eis-countdown-' + el.getAttribute('data-key');

      function readStored() {
        try { return parseInt(window.sessionStorage.getItem(storeKey), 10); } catch (e) { return NaN; }
      }
      function writeStored(t) {
        try { window.sessionStorage.setItem(storeKey, String(t)); } catch (e) {}
      }

      function nextDeadline() {
        if (mode === 'date') {
          var t = Date.parse(deadlineAttr);
          return isNaN(t) ? null : t;
        }

        if (mode === 'minutes') {
          if (!minutes) return null;
          /* Held in sessionStorage so a refresh continues the same countdown
             rather than snapping back to the full duration. */
          var stored = readStored();
          if (isNaN(stored) || stored <= Date.now()) {
            stored = Date.now() + minutes * 60000;
            writeStored(stored);
          }
          return stored;
        }

        /* Daily: midnight tonight in the visitor's own timezone. */
        var d = new Date();
        d.setHours(24, 0, 0, 0);
        return d.getTime();
      }

      var target = nextDeadline();
      if (target === null) {
        el.textContent = prefix;
        return;
      }

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function tick() {
        var left = target - Date.now();
        if (left <= 0) {
          if (mode === 'date') {
            el.textContent = ended;
            clearInterval(timer);
            return;
          }
          target = nextDeadline();
          left = target - Date.now();
        }
        var s = Math.floor(left / 1000);
        var h = Math.floor(s / 3600);
        /* Under an hour, drop the empty hours segment — a 58-minute timer
           reading 00:57:12 looks broken. */
        el.textContent =
          prefix + ' ' + (h > 0 ? pad(h) + ':' : '') + pad(Math.floor((s % 3600) / 60)) + ':' + pad(s % 60);
      }

      tick();
      var timer = setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "EIS — Offer repeat",
  "tag": "section",
  "class": "eis-section eis-section--repeat",
  "max_blocks": 6,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty on a product template to use the current product."
    },
    {
      "type": "header",
      "content": "Urgency bar"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show urgency bar",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Text before the timer",
      "default": "LIMITED TIME OFFER |"
    },
    {
      "type": "select",
      "id": "countdown_mode",
      "label": "Counts down to",
      "options": [
        {
          "value": "minutes",
          "label": "A set number of minutes (per visitor)"
        },
        {
          "value": "daily",
          "label": "Midnight tonight (resets each day)"
        },
        {
          "value": "date",
          "label": "A fixed date and time"
        }
      ],
      "default": "minutes"
    },
    {
      "type": "range",
      "id": "countdown_minutes",
      "label": "Minutes",
      "info": "Only used for 'a set number of minutes'. Starts when the visitor lands and survives a refresh; a new session starts it over. This is a scarcity timer, not a real deadline.",
      "min": 5,
      "max": 105,
      "step": 1,
      "unit": "min",
      "default": 58
    },
    {
      "type": "text",
      "id": "countdown_deadline",
      "label": "Deadline",
      "info": "Only used for 'a fixed date and time'. Format: 2026-09-30T23:59:59+05:30"
    },
    {
      "type": "text",
      "id": "urgency_ended_text",
      "label": "Text once the deadline passes",
      "default": "THIS OFFER HAS ENDED"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept. Leave empty to run straight from the urgency bar into the copy."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "info": "Basic HTML like <strong> works.",
      "default": "Most customers see their best results between <strong>week 3 and week 4</strong>. Stock up once and stay consistent."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Falls back to the product's featured image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "EIS Ayurvedic Pain Relief Oil"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 230
    },
    {
      "type": "header",
      "content": "Offer ladder (MoonBundle)"
    },
    {
      "type": "paragraph",
      "content": "Add your MoonBundle app block here as well, so the second ask has the same ladder as the hero."
    },
    {
      "type": "text",
      "id": "offers_heading",
      "label": "Offers heading",
      "default": "Choose Your Supply"
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Stock line",
      "default": "IN STOCK — Delivery in 3–5 days across India"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Background",
      "default": "#FBF3E7"
    },
    {
      "type": "color",
      "id": "color_maroon_deep",
      "label": "Urgency bar",
      "default": "#5C0D0F"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Urgency text",
      "default": "#F6E7C8"
    },
    {
      "type": "color",
      "id": "color_maroon",
      "label": "Heading",
      "default": "#7B1315"
    },
    {
      "type": "color",
      "id": "color_gold",
      "label": "Gold accent",
      "default": "#C9A24A"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#2A1C18"
    },
    {
      "type": "color",
      "id": "color_muted",
      "label": "Muted text",
      "default": "#5E5147"
    },
    {
      "type": "color",
      "id": "color_green",
      "label": "Stock dot",
      "default": "#1E7A4D"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "EIS — Offer repeat"
    }
  ]
}
{% endschema %}
