{%- comment -%}
  SOL — Product Hero
  ------------------------------------------------------------------
  Gallery + rating + title + benefit list + offer slot + trust strip,
  plus the mobile sticky Add-to-Cart bar.

  The offer ladder (1 / 3 / 5 bottles) is NOT hard-coded here. The section
  exposes an app-block slot inside "Choose Your Supply" — add the MoonBundle
  block there in the theme customizer and it owns offer selection + Add to Cart.
  The native Add-to-Cart button below it is off by default and exists only as a
  fallback for merchants who aren't running the app.
{%- endcomment -%}

{%- liquid
  assign eis_product = section.settings.product | default: product
  assign eis_variant = eis_product.selected_or_first_available_variant

  comment
    media, not images: images excludes video, and a silent looping MP4 is how
    an animation belongs on a product page — the same clip as a GIF runs about
    a tenth the bytes. Order follows whatever the merchant sets in Shopify.
  endcomment
  assign gallery_media = eis_product.media
  if section.settings.featured_image != blank
    assign hero_image = section.settings.featured_image
  else
    assign hero_image = eis_product.featured_image
  endif
  comment
    The product carries no media yet, so the sticky bar's thumbnail would be
    an empty black square. Fall back to the first gallery block.
  endcomment
  if hero_image == blank
    for block in section.blocks
      if block.type == 'gallery_image' and block.settings.image != blank
        assign hero_image = block.settings.image
        break
      endif
    endfor
  endif
  assign sticky_image = section.settings.sticky_image | default: hero_image

  assign pill_count = 0
  assign benefit_count = 0
  assign badge_count = 0
  assign gallery_block_count = 0
  assign bfaq_count = 0
  for block in section.blocks
    case block.type
      when 'feature_pill'
        assign pill_count = pill_count | plus: 1
      when 'benefit'
        assign benefit_count = benefit_count | plus: 1
      when 'payment_badge'
        assign badge_count = badge_count | plus: 1
      when 'gallery_image'
        if block.settings.image != blank
          assign gallery_block_count = gallery_block_count | plus: 1
        endif
      when 'buybox_faq'
        assign bfaq_count = bfaq_count | plus: 1
    endcase
  endfor

  comment
    The gallery reads the product's own media first — that is what Shopify
    uses everywhere else, so it has to win. Gallery-image blocks are the
    fallback for a product whose media is not up yet; they disappear on
    their own the moment real media exists.
  endcomment
  assign use_gallery_blocks = false
  assign gallery_count = gallery_media.size
  if gallery_count == 0 and gallery_block_count > 0
    assign use_gallery_blocks = true
    assign gallery_count = gallery_block_count
  endif

  assign has_compare_at = false
  if eis_variant.compare_at_price > eis_variant.price
    assign has_compare_at = true
  endif

  comment
    Filters can't be chained inside an image_tag argument, so alt text and the
    sizes hint are worked out up front.
  endcomment
  assign image_alt = eis_product.title
  assign hero_alt = image_alt | escape
  assign img_sizes ='(min-width: ' | append: section.settings.content_width | append: 'px) ' | append: section.settings.content_width | append: 'px, 100vw'
-%}

{% render 'sol-fonts' %}

{% style %}
  #shopify-section-{{ section.id }} {
    --sol-maroon: {{ section.settings.color_maroon }};
    --sol-maroon-deep: {{ section.settings.color_maroon_deep }};
    --sol-gold: {{ section.settings.color_gold }};
    --sol-cream: {{ section.settings.color_cream }};
    --sol-ink: {{ section.settings.color_text }};
    --sol-muted: {{ section.settings.color_muted }};
    --sol-green: {{ section.settings.color_green }};
    --sol-line: {{ section.settings.color_border }};
    --sol-max: {{ section.settings.content_width }}px;
    --sol-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --sol-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, system-ui, sans-serif;
  }

  .sol-hero {
    max-width: var(--sol-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px;
    background: #fff;
    font-family: var(--sol-sans);
    color: var(--sol-ink);
    -webkit-font-smoothing: antialiased;
  }
  .sol-hero *, .sol-sticky * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} { background: #fff; }

  /* The two column wrappers exist only so desktop can flow the buy box
     independently of the gallery. display:contents means they generate no
     box, so on mobile the children lay out exactly as if the wrappers were
     not there — that is what keeps the mobile fingerprint identical. */
  .sol-hero__media,
  .sol-hero__buy { display: contents; }


  /* ---------- gallery ---------- */
  .sol-hero__stage {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #dde7c2;
  }
  .sol-hero__slides { display: block; }
  .sol-hero__slide { display: none; }
  .sol-hero__slide[data-active] { display: block; }
  .sol-hero__slide img,
  .sol-hero__slide svg,
  .sol-hero__slide video,
  .sol-hero__slide iframe {
    display: block;
    width: 100%;
    /* Square at every width, whatever the source image is. contain letterboxes
       a non-square photo against the stage rather than cropping it, so a 4:5
       or 16:9 upload still shows whole. */
    aspect-ratio: 1 / 1;
    height: auto;
    object-fit: contain;
    object-position: {{ section.settings.image_position }};
  }
  .sol-hero__pills {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
    pointer-events: none;
  }
  .sol-hero__pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,.94);
    border-radius: 999px;
    padding: 6px 11px 6px 7px;
    max-width: 172px;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  .sol-hero__pill-icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--sol-maroon);
    color: #edf3d6;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .sol-hero__pill-text { font-size: 9.5px; line-height: 1.25; font-weight: 500; color: var(--sol-ink); }
  .sol-hero__nav {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: flex;
    gap: 8px;
    z-index: 2;
  }
  .sol-hero__nav button {
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 999px;
    background: rgba(255,255,255,.9);
    color: var(--sol-ink);
    font-size: 13px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .sol-hero__thumbs {
    display: flex;
    gap: 7px;
    margin-top: 9px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    /* no bar: the arrows on the main image drive this row, and a half-thumb
       at the edge is what tells people it keeps going */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .sol-hero__thumbs::-webkit-scrollbar { display: none; }
  .sol-hero__thumb {
    flex: 0 0 calc((100% - ({{ section.settings.thumb_columns }} - 1) * 7px) / {{ section.settings.thumb_columns }});
    scroll-snap-align: start;
    aspect-ratio: 1;
    border-radius: 8px;
    border: 1px solid var(--sol-line);
    overflow: hidden;
    background: #150606;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .sol-hero__thumb[aria-current="true"] { border: 2px solid var(--sol-maroon); }
  .sol-hero__thumb { position: relative; }
  /* Marks a thumbnail whose slide is a video. Drawn rather than an icon file
     so it inherits the gallery's own colours and costs no extra request. */
  .sol-hero__thumb-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(21, 6, 6, .62);
    border: 1px solid rgba(246, 231, 200, .85);
    pointer-events: none;
  }
  .sol-hero__thumb-play::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    border-left: 7px solid #edf3d6;
    border-top: 4.5px solid transparent;
    border-bottom: 4.5px solid transparent;
    transform: translateX(1px);
  }
  .sol-hero__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }

  /* ---------- rating ---------- */
  .sol-hero__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: {{ section.settings.rating_gap }}px;
    flex-wrap: wrap;
    font-family: 'Manrope', var(--sol-sans);
  }
  .sol-stars { display: flex; gap: 2px; }
  .sol-stars i {
    font-style: normal;
    font-size: {{ section.settings.rating_star_size }}px;
    line-height: 1;
    color: {{ section.settings.color_star }};
    display: inline-block;
    text-shadow: 0 0 8px {{ section.settings.color_star | color_modify: 'alpha', 0.7 }};
    animation: eisStarPulse 2s ease-in-out infinite;
  }
  .sol-stars i:nth-child(1) { animation-delay: 0s; }
  .sol-stars i:nth-child(2) { animation-delay: .15s; }
  .sol-stars i:nth-child(3) { animation-delay: .3s; }
  .sol-stars i:nth-child(4) { animation-delay: .45s; }
  .sol-stars i:nth-child(5) { animation-delay: .6s; }
  @keyframes eisStarPulse {
    0%, 100% { transform: scale(1); filter: brightness(1); }
    50% { transform: scale(1.2); filter: brightness(1.4); }
  }
  /* A pulsing row is decoration, not information — hold it still for anyone
     who has asked the OS for less motion. */
  @media (prefers-reduced-motion: reduce) {
    .sol-stars i { animation: none; }
  }
  .sol-hero__rating-text {
    font-size: {{ section.settings.rating_text_size }}px;
    font-weight: 400;
    color: {{ section.settings.color_rating_text }};
    white-space: nowrap;
  }
  .sol-hero__rating-text strong { font-weight: 600; }
  .sol-hero__rating-count { font-size: 12px; color: #8A7A63; width: 100%; }

  /* Stars + text sit on one line down to 375px. Below that the row would wrap
     and the copy would drop under the stars, so step both down instead. */
  @media (max-width: 389px) {
    .sol-hero__rating { gap: 6px; }
    .sol-stars i { font-size: {{ section.settings.rating_star_size | times: 0.9 | round: 1 }}px; }
    .sol-hero__rating-text { font-size: {{ section.settings.rating_text_size | times: 0.94 | round: 1 }}px; }
  }
  @media (max-width: 339px) {
    .sol-hero__rating { gap: 5px; }
    .sol-stars i { font-size: {{ section.settings.rating_star_size | times: 0.78 | round: 1 }}px; }
    .sol-hero__rating-text { font-size: {{ section.settings.rating_text_size | times: 0.84 | round: 1 }}px; }
  }

  /* The review card lower down reuses .sol-stars; keep those small, still and
     green rather than inheriting the hero row's gold pulse. */
  .sol-hero__review .sol-stars i {
    width: 15px;
    height: 15px;
    font-size: 10px;
    color: #fff;
    background: var(--sol-green);
    text-shadow: none;
    animation: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- copy ---------- */
  .sol-hero__title {
    font-family: var(--sol-serif);
    font-size: 31px;
    line-height: 1.12;
    font-weight: 600;
    color: #2c4a2a;
    text-align: center;
    margin: {{ section.settings.title_gap }}px 0 12px;
  }
  .sol-hero__subtitle { font-size: 14px; line-height: 1.5; color: var(--sol-muted); margin: {{ section.settings.subtitle_gap }}px 0 0; }

  /* ---------- doctors' choice badge ---------- */
  .sol-docs { display: flex; justify-content: center; width: 100%; padding: 6px 0; margin-top: {{ section.settings.doctors_gap }}px; }
  .sol-docs__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: {{ section.settings.doctors_bg }};
    border: 1.5px solid {{ section.settings.doctors_border }};
    border-radius: 50px;
    padding: 5px 14px 5px 6px;
    font-family: 'Manrope', var(--sol-sans);
    max-width: 100%;
  }
  .sol-docs__avatars { display: flex; align-items: center; flex-shrink: 0; }
  .sol-docs__avatars img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 2px solid #fff;
    margin-left: -8px;
    display: block;
  }
  .sol-docs__avatars img:first-child { margin-left: 0; }
  .sol-docs__text { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; white-space: nowrap; }
  .sol-docs__stars { display: inline-flex; align-items: center; gap: 1px; margin-left: 38px; }
  .sol-docs__stars span { color: #F5A623; font-size: 11px; line-height: 1; }
  .sol-docs__row { display: flex; align-items: center; gap: 6px; }
  .sol-docs__count { font-size: 13px; font-weight: 700; color: {{ section.settings.doctors_ink }}; }
  .sol-docs__label { font-size: 13px; font-weight: 500; color: {{ section.settings.doctors_label_ink }}; }
  .sol-docs__verified {
    font-size: 10px;
    background: {{ section.settings.doctors_ink }};
    color: #fff;
    border-radius: 50px;
    padding: 2px 7px;
    font-weight: 600;
    letter-spacing: .3px;
  }
  /* The pill is one unbreakable line; below ~360px it would push past the
     gutter, so shrink it rather than let it overflow. */
  @media (max-width: 359px) {
    .sol-docs__pill { gap: 8px; padding: 4px 11px 4px 5px; }
    .sol-docs__avatars img { width: 30px; height: 30px; }
    .sol-docs__stars { margin-left: 32px; }
    .sol-docs__count, .sol-docs__label { font-size: 12px; }
  }

  .sol-hero__benefits {
    background: var(--sol-cream);
    border: 1px solid #EFE0C9;
    border-radius: 12px;
    padding: 16px;
    /* Without the bottom margin the cream edge butted straight into the
       offer ladder the bundle app injects below. 24px at every width: the
       same value the offers heading already uses, and enough to survive
       collapsing against the button's own 14px top margin, which a 16px
       bottom margin would not have. */
    margin: 16px 0 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sol-hero__benefit { display: flex; gap: 11px; align-items: flex-start; }
  .sol-hero__check {
    width: 19px;
    height: 19px;
    border-radius: 999px;
    background: var(--sol-green);
    color: #fff;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    margin-top: 1px;
  }
  .sol-hero__benefit-text { font-size: 13px; line-height: 1.45; }
  .sol-hero__benefit-text span { color: var(--sol-muted); }

  /* ---------- price + offers ---------- */
  .sol-hero__price { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .sol-hero__price-now { font-size: 26px; font-weight: 700; color: var(--sol-maroon); font-family: var(--sol-serif); }
  .sol-hero__price-was { font-size: 14px; color: #A79684; text-decoration: line-through; }
  .sol-hero__price-save {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    color: #14260f;
    background: var(--sol-gold);
    border-radius: 4px;
    padding: 3px 8px;
  }
  .sol-hero__price-unit { font-size: 11.5px; color: #8A7A63; width: 100%; }

  .sol-hero__offers-title {
    font-family: var(--sol-serif);
    font-size: 21px;
    font-weight: 600;
    color: var(--sol-ink);
    margin: 24px 0 12px;
  }
  .sol-hero__app-block + .sol-hero__app-block { margin-top: 12px; }
  .sol-hero__slot-empty {
    border: 1px dashed var(--sol-gold);
    border-radius: 11px;
    background: #FDF9F1;
    padding: 18px 16px;
    text-align: center;
  }
  .sol-hero__slot-empty b { display: block; font-size: 13px; margin-bottom: 6px; color: var(--sol-maroon); }
  .sol-hero__slot-empty span { font-size: 11.5px; line-height: 1.5; color: var(--sol-muted); }

  /* ---------- stock + cart ---------- */
  .sol-hero__stock {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--sol-ink);
  }
  .sol-dot { color: var(--sol-green); font-size: 14px; line-height: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .sol-dot--pulse { animation: eisPulse 2s infinite; }
  }
  @keyframes eisPulse { 0%, 100% { opacity: 1 } 50% { opacity: .35 } }
  .sol-hero__stock--out .sol-dot { color: #B0413A; }

  .sol-btn {
    display: block;
    width: 100%;
    border: 0;
    background: #b7ce2e;
    color: #2c4a2a;
    font-family: var(--sol-sans);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: .14em;
    text-align: center;
    padding: 19px;
    border-radius: 10px;
    margin-top: 14px;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(123,19,21,.28);
    -webkit-tap-highlight-color: transparent;
  }
  .sol-btn:hover { background: #b7ce2e; }
  .sol-btn[disabled] { background: #c43d2e; box-shadow: none; cursor: not-allowed; }

  /* ---------- social proof row ---------- */
  /* .sol-sp is already taken by the sol-social-proof section, whose styles
     are page-wide — hence the sol-hsp prefix and the explicit background. */
  .sol-hsp {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: {{ section.settings.sp_gap }}px;
    /* No bottom padding: the space under this row is the title's title_gap,
       so one setting controls the gap instead of two stacked values. */
    padding: 0;
    background: transparent;
    font-family: 'Manrope', var(--sol-sans);
  }
  .sol-hsp__row { display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: nowrap; width: 100%; max-width: 100%; }
  .sol-hsp__avatars { display: flex; align-items: center; flex-shrink: 0; }
  .sol-hsp__avatars img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2.5px solid {{ section.settings.sp_accent }};
    object-fit: cover;
    margin-left: -10px;
    display: block;
    transition: transform .3s ease;
  }
  .sol-hsp__avatars img:first-child { margin-left: 0; }
  .sol-hsp__avatars img:hover { transform: scale(1.1); z-index: 10; position: relative; }
  .sol-hsp__text { display: flex; align-items: center; gap: 6px; row-gap: 2px; font-size: 17px; font-weight: 600; color: #333; flex-wrap: wrap; white-space: nowrap; }
  .sol-hsp__count { font-weight: 800; color: {{ section.settings.sp_accent }}; font-size: 18px; font-variant-numeric: tabular-nums; }
  .sol-hsp__dot { color: #ccc; font-size: 16px; margin: 0 2px; }
  .sol-hsp__stars { display: inline-flex; align-items: center; gap: 1px; }
  .sol-hsp__stars span { color: {{ section.settings.sp_accent }}; font-size: 18px; line-height: 1; }
  .sol-hsp__rating { font-weight: 700; color: #333; font-size: 17px; margin-left: 3px; }
  .sol-hsp__score { display: inline-flex; align-items: center; gap: 3px; flex-basis: 100%; }
  /* The pasted design is one unbroken line, which needs ~505px of column.
     The buy box is capped at 480px, so that line can never fit at any
     viewport — the stars and rating always take their own row, and the
     separator dot that divided them goes away with it. */
  .sol-hsp__dot { display: none; }
  @media (max-width: 429px) {
    .sol-hsp__row { gap: 9px; }
    .sol-hsp__avatars img { width: 38px; height: 38px; border-width: 2px; margin-left: -9px; }
    .sol-hsp__text { font-size: 14px; gap: 4px; }
    .sol-hsp__count { font-size: 15px; }
    .sol-hsp__stars span { font-size: 14px; }
    .sol-hsp__rating { font-size: 14px; }
  }
  @media (max-width: 359px) {
    .sol-hsp__avatars img { width: 33px; height: 33px; margin-left: -8px; }
    .sol-hsp__text { font-size: 12.5px; }
    .sol-hsp__count { font-size: 13.5px; }
    .sol-hsp__stars span { font-size: 12.5px; }
    .sol-hsp__rating { font-size: 12.5px; }
  }

  /* ---------- payment methods ---------- */
  .sol-pm { margin-top: 6px; }
  .sol-pm__row { display: flex; align-items: center; justify-content: space-between; gap: 3px; }
  .sol-pm__tile {
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--sol-line);
    border-radius: 5px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    overflow: hidden;
  }
  .sol-pm__tile svg, .sol-pm__tile img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .sol-pm__note { font-size: 11px; color: var(--sol-muted); text-align: center; margin: 7px 0 0; }

  /* ---------- low stock + delivery ---------- */
  /* ---------- Cashfree money-back promise ---------- */
  /* sol-mbp prefix: section styles are page-wide, so the class names have to
     be unique across every section on the template, not just this one. */
  .sol-mbp { margin-top: 14px; }
  .sol-mbp__banner {
    background: linear-gradient(135deg, #E8E0F4 0%, #DDD3F0 100%);
    border-radius: 12px;
    padding: 16px 18px;
    position: relative;
  }
  .sol-mbp__badge {
    position: absolute;
    top: 12px;
    right: 14px;
    background: #C9B8E8;
    color: #2D1A6E;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
  }
  .sol-mbp__header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .sol-mbp__logo {
    width: 36px;
    height: 36px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .1);
    flex-shrink: 0;
    overflow: hidden;
  }
  .sol-mbp__logo svg { width: 22px; height: 22px; }
  .sol-mbp__brand { font-size: 15px; font-weight: 700; color: #2D1A6E; margin: 0 0 1px; }
  .sol-mbp__promise { font-size: 20px; font-weight: 700; color: #1A0E45; line-height: 1.2; margin: 0; }
  .sol-mbp__verified {
    font-size: 12px;
    color: #2D1A6E;
    margin: 4px 0 0;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sol-mbp__tick {
    width: 14px;
    height: 14px;
    background: #6C3FC4;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sol-mbp__tick svg { width: 9px; height: 9px; fill: none; stroke: #fff; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .sol-mbp__refund {
    background: #F0EAF8;
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #C9B8E8;
  }
  .sol-mbp__refund-icon {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, #6C3FC4 0%, #5A2DAF 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sol-mbp__refund-icon svg { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .sol-mbp__refund-text { color: #2D1A6E; font-size: 13px; font-weight: 500; }
  .sol-mbp__refund-text p { margin: 0; }
  /* Shopify's richtext editor rewrites <b> as <strong>, so match both. */
  .sol-mbp__refund-text b,
  .sol-mbp__refund-text strong { color: #6C3FC4; font-weight: 700; }
  @media (max-width: 640px) {
    .sol-mbp__banner { border-radius: 10px; padding: 12px 14px; }
    .sol-mbp__badge { top: 10px; right: 12px; padding: 3px 10px; font-size: 10px; border-radius: 10px; }
    .sol-mbp__header { gap: 8px; margin-bottom: 10px; }
    .sol-mbp__logo { width: 30px; height: 30px; }
    .sol-mbp__logo svg { width: 18px; height: 18px; }
    .sol-mbp__brand { font-size: 12px; }
    .sol-mbp__promise { font-size: 15px; }
    .sol-mbp__verified { font-size: 9px; margin-top: 2px; gap: 3px; white-space: nowrap; }
    .sol-mbp__tick { width: 11px; height: 11px; }
    .sol-mbp__tick svg { width: 6px; height: 6px; }
    .sol-mbp__refund { border-radius: 8px; padding: 9px 11px; gap: 8px; }
    .sol-mbp__refund-icon { width: 26px; height: 26px; }
    .sol-mbp__refund-icon svg { width: 14px; height: 14px; }
    .sol-mbp__refund-text { font-size: 10px; line-height: 1.3; }
  }

  .sol-stockbar { margin-top: 16px; }
  .sol-stockbar__head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
  .sol-stockbar__label { font-size: 13px; font-weight: 700; color: #A11B1B; }
  .sol-stockbar__pct { font-size: 11.5px; color: var(--sol-muted); }
  .sol-stockbar__track { height: 9px; border-radius: 999px; background: #F0E4E4; overflow: hidden; }
  .sol-stockbar__fill {
    height: 100%;
    width: {{ section.settings.stock_percent }}%;
    border-radius: 999px;
    background: linear-gradient(90deg, #D63232, #A11B1B);
    animation: eisStockPulse 2.2s ease-in-out infinite;
  }
  @keyframes eisStockPulse { 0%, 100% { opacity: 1; } 50% { opacity: .62; } }
  @media (prefers-reduced-motion: reduce) { .sol-stockbar__fill { animation: none; } }
  .sol-deliv {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 11px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--sol-ink);
  }
  .sol-deliv__icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--sol-green);
    color: #fff;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .sol-deliv b { font-weight: 700; }
  .sol-deliv__note { display: block; font-size: 12px; color: var(--sol-muted); margin-top: 1px; }

  /* ---------- counterfeit warning ---------- */
  .sol-warn {
    background: #FDF2F2;
    border: 2px dashed #D37373;
    padding: 16px;
    border-radius: 4px;
    margin: 15px 0 0;
    font-family: var(--sol-sans);
  }
  .sol-warn__head {
    display: flex;
    align-items: center;
    margin-bottom: 8px;
    color: #A94442;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: .5px;
  }
  .sol-warn__icon {
    background: #A94442;
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    font-size: 12px;
    flex: none;
  }
  .sol-warn__body p { margin: 0 0 8px; font-size: 14px; line-height: 1.5; color: #834040; }
  .sol-warn__body p:last-child { margin-bottom: 0; }
  .sol-warn__body strong { color: #A94442; }
  .sol-warn__body a { color: #834040; text-decoration: underline; font-weight: 500; }

  /* ---------- buy-box FAQ ---------- */
  /* Full-bleed cream: pull back out through the hero's side padding so the
     background runs the width of the buy box, then put the padding back on
     so the cards still line up with everything above them. */
  .sol-bfaq {
    margin: 16px -{{ section.settings.padding_x }}px 0;
    padding: 16px {{ section.settings.padding_x }}px 0;
    background: var(--sol-cream);
    border: 0;
    border-radius: 0;
  }
  .sol-bfaq__title {
    font-family: var(--sol-serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--sol-maroon);
    margin: 2px 0 12px;
    text-align: center;
  }
  .sol-bfaq__item {
    background: #fff;
    border: 1px solid #EFE0C9;
    border-radius: 11px;
    margin-bottom: 10px;
    overflow: hidden;
  }
  .sol-bfaq__item:last-child { margin-bottom: 0; }
  .sol-bfaq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 15px;
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--sol-ink);
    -webkit-tap-highlight-color: transparent;
  }
  .sol-bfaq__item summary::-webkit-details-marker { display: none; }
  .sol-bfaq__sign {
    flex: none;
    width: 18px;
    text-align: center;
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
    color: var(--sol-maroon);
  }
  .sol-bfaq__sign::after { content: '+'; }
  .sol-bfaq__item[open] .sol-bfaq__sign::after { content: '\00D7'; }
  .sol-bfaq__answer { padding: 0 15px 14px; }
  .sol-bfaq__answer p { margin: 0 0 8px; font-size: 13.5px; line-height: 1.55; color: var(--sol-muted); }
  .sol-bfaq__answer p:last-child { margin-bottom: 0; }
  @media (max-width: 359px) {
    .sol-bfaq__item summary { padding: 12px 12px; font-size: 14px; }
    .sol-bfaq__answer { padding: 0 12px 12px; }
  }

  .sol-pay { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
  .sol-pay span {
    border: 1px solid var(--sol-line);
    border-radius: 4px;
    padding: 4px 7px;
    font-size: 8px;
    font-weight: 700;
    color: var(--sol-muted);
    letter-spacing: .04em;
  }
  .sol-pay span.is-highlight { border-color: var(--sol-green); color: var(--sol-green); }
  .sol-hero__cod {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--sol-green);
  }

  .sol-hero__guarantee {
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid #EFE0C9;
    border-radius: 10px;
    padding: 13px;
    margin-top: 14px;
    background: var(--sol-cream);
  }
  .sol-hero__guarantee-icon {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--sol-gold);
    color: #14260f;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex: none;
  }
  .sol-hero__guarantee b { font-size: 12.5px; display: block; }
  .sol-hero__guarantee a { font-size: 11px; color: var(--sol-maroon); }

  /* ---------- hero review ---------- */
  .sol-hero__review { border: 1px solid #EFE3D2; border-radius: 11px; padding: 14px; margin-top: 14px; }
  .sol-hero__review .sol-stars { margin-bottom: 9px; }
  .sol-hero__review-quote { font-size: 13px; line-height: 1.5; color: #3B322C; }
  .sol-hero__review-by { display: flex; align-items: center; gap: 9px; margin-top: 11px; }
  .sol-hero__avatar {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    flex: none;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #EDE1CE 0 5px, #F9F1E4 5px 10px);
  }
  .sol-hero__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sol-hero__review-name-row { display: flex; align-items: center; gap: 5px; }
  .sol-hero__review-name { font-size: 12px; font-weight: 700; }
  .sol-hero__google { width: 14px; height: 14px; flex: none; display: block; }
  .sol-hero__review-meta { font-size: 10.5px; color: var(--sol-green); }

  /* ---------- sticky bar ---------- */
  .sol-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .sol-sticky__inner {
    width: 100%;
    max-width: var(--sol-max);
    background: rgba(255,255,255,.98);
    border-top: 1px solid #EFE0C9;
    padding: 11px 14px;
    padding-bottom: calc(11px + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 11px;
    box-shadow: 0 -8px 22px rgba(59,14,15,.1);
    pointer-events: auto;
    transform: translateY(120%);
    transition: transform .25s ease;
    font-family: var(--sol-sans);
  }
  @media (prefers-reduced-motion: reduce) { .sol-sticky__inner { transition: none; } }
  .sol-sticky.is-visible .sol-sticky__inner { transform: translateY(0); }
  .sol-sticky__row { display: contents; }
  /* The thumbnail costs 57px that the title and rating need. Above 390px
     there is room for both; below it the copy wins. */
  @media (max-width: 389px) {
    .sol-sticky__thumb {
      display: block;
      width: 40px;
      height: 40px;
    }
  }
  .sol-sticky__thumb {
    width: 46px;
    height: 46px;
    border-radius: 9px;
    overflow: hidden;
    background: #150606;
    flex: none;
    align-self: center;
  }
  .sol-sticky__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .sol-sticky__copy { flex: 1; min-width: 0; }
  .sol-sticky__name {
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--sol-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sol-sticky__price { font-size: 11px; color: #8A7A63; }
  .sol-sticky__price s { color: #B7A692; }
  .sol-sticky__rating {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-top: 1px;
    min-width: 0;
  }
  .sol-sticky__rating i {
    font-style: normal;
    font-size: 10px;
    line-height: 1;
    color: {{ section.settings.color_star }};
    letter-spacing: 0;
    flex: none;
  }
  .sol-sticky__rating span {
    font-size: 10px;
    line-height: 1.25;
    color: #6A5B4D;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* a flex item won't shrink past its own text without this, and would
       run out under the button instead of ellipsising */
    min-width: 0;
  }
  @media (max-width: 389px) {
    .sol-sticky__rating i { font-size: 9px; }
    .sol-sticky__rating span { font-size: 9.5px; }
  }
  .sol-sticky__btn {
    position: relative;
    overflow: hidden;
    background: #b7ce2e;
    color: #2c4a2a;
    border: 0;
    font-family: var(--sol-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .07em;
    padding: 15px 16px;
    border-radius: 9px;
    cursor: pointer;
    flex: none;
    align-self: center;
    white-space: nowrap;
    animation: eisCtaPulse 2.6s ease-in-out infinite;
    transition: background .2s ease, transform .2s cubic-bezier(.34,1.56,.64,1);
    -webkit-tap-highlight-color: transparent;
  }
  .sol-sticky__btn:hover { background: #b7ce2e; }
  .sol-sticky__btn:active { transform: scale(.96); }
  .sol-sticky__btn[disabled] { background: #c43d2e; cursor: not-allowed; animation: none; }
  .sol-sticky__sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    background: linear-gradient(90deg, rgba(255,247,230,0), rgba(255,247,230,.28), rgba(255,247,230,0));
    animation: eisCtaSheen 3.4s ease-in-out infinite;
    pointer-events: none;
  }
  .sol-sticky__btn span:not(.sol-sticky__sheen) { position: relative; }
  @keyframes eisCtaPulse {
    0%, 100% { box-shadow: 0 5px 14px rgba(123,19,21,.30), 0 0 0 0 rgba(201,162,74,0); }
    50% { box-shadow: 0 7px 20px rgba(123,19,21,.38), 0 0 0 5px rgba(201,162,74,.22); }
  }
  @keyframes eisCtaSheen {
    0% { transform: translateX(-130%) skewX(-18deg); }
    55% { transform: translateX(240%) skewX(-18deg); }
    100% { transform: translateX(240%) skewX(-18deg); }
  }
  /* The pulse and sheen are decoration; hold them still on request. */
  @media (prefers-reduced-motion: reduce) {
    .sol-sticky__btn { animation: none; transition: none; }
    .sol-sticky__sheen { animation: none; opacity: 0; }
  }
  {%- if section.settings.sticky_on_desktop %}
  /* Desktop drops the thumbnail and lets the title carry the bar. */
  @media (min-width: 750px) {
    .sol-sticky__inner { max-width: 1240px; padding: 14px 28px; gap: 22px; }
    .sol-sticky__inner .sol-sticky__thumb { width: 54px; height: 54px; border-radius: 10px; }
    .sol-sticky__name { font-family: var(--sol-serif); font-size: 19px; font-weight: 600; line-height: 1.2; color: var(--sol-maroon); }
    .sol-sticky__rating i { font-size: 12px; }
    .sol-sticky__rating span { font-size: 12px; }
    .sol-sticky__btn { font-size: 15px; letter-spacing: .13em; padding: 19px 42px; border-radius: 10px; }
    .sol-sticky__btn:hover { transform: translateY(-2px) scale(1.02); }
    .sol-sticky__btn:active { transform: translateY(0) scale(.98); }
  }
  {%- else %}
  @media (min-width: 750px) { .sol-sticky { display: none; } }
  {%- endif %}

  /* ---------- larger screens: same layout, a touch more air ---------- */
  @media (min-width: 560px) {
    .sol-hero__title { font-size: 34px; }
    .sol-hero__subtitle { font-size: 15px; }
    .sol-hero__benefit-text { font-size: 13.5px; }
  }

  {% render 'sol-hero-desktop' %}
{% endstyle %}

<div class="sol-hero" id="EisHero-{{ section.id }}" data-sol-hero>
  {%- if eis_product == blank -%}
    <div class="sol-hero__slot-empty">
      <b>No product selected</b>
      <span>Open this section in the theme customizer and pick a product, or add the section to a product template.</span>
    </div>
  {%- else -%}

    {%- comment -%} ---------- gallery ---------- {%- endcomment -%}
    <div class="sol-hero__media">
    <div class="sol-hero__stage">
      {%- if pill_count > 0 -%}
        <div class="sol-hero__pills">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature_pill' -%}
              <div class="sol-hero__pill" {{ block.shopify_attributes }}>
                <div class="sol-hero__pill-icon" aria-hidden="true">{{ block.settings.icon }}</div>
                <div class="sol-hero__pill-text">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="sol-hero__slides" data-sol-slides>
        {%- if use_gallery_blocks -%}
          {%- assign slide_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
              <div class="sol-hero__slide" data-sol-slide="{{ slide_i }}" {% if slide_i == 0 %}data-active{% endif %} {{ block.shopify_attributes }}>
                {{
                  block.settings.image
                  | image_url: width: 1080
                  | image_tag:
                    widths: '360, 480, 720, 900, 1080',
                    sizes: img_sizes,
                    loading: 'lazy',
                    alt: hero_alt
                }}
              </div>
              {%- assign slide_i = slide_i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif gallery_media.size > 0 -%}
          {%- for media in gallery_media -%}
            {%- liquid
              # only the first frame is part of the initial paint
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
              endif
              assign slide_alt = media.alt | default: image_alt | escape
            -%}
            <div
              class="sol-hero__slide"
              data-sol-slide="{{ forloop.index0 }}"
              data-media-type="{{ media.media_type }}"
              {% if forloop.first %}data-active{% endif %}
            >
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  {%- comment -%}
                    Shopify's own filter rather than a hand-rolled <video>: it
                    picks the right source from media.sources, which carries
                    several encodings, and writes the poster. Muted so autoplay
                    is allowed at all, looping and chrome-free so it reads as
                    an animation rather than something to press play on.
                  {%- endcomment -%}
                  {{
                    media
                    | video_tag:
                      image_size: '1080x',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false
                  }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: loading: 'lazy' }}
                {%- else -%}
                  {%- comment -%}
                    Covers image and 3D model alike: every media type carries a
                    preview_image, so an unsupported type still shows a frame
                    instead of a hole.
                  {%- endcomment -%}
                  {{
                    media.preview_image
                    | image_url: width: 1080
                    | image_tag:
                      widths: '360, 480, 720, 900, 1080',
                      sizes: img_sizes,
                      loading: img_loading,
                      fetchpriority: img_priority,
                      alt: slide_alt
                  }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- elsif hero_image != blank -%}
          <div class="sol-hero__slide" data-sol-slide="0" data-active>
            {{
              hero_image
              | image_url: width: 1080
              | image_tag:
                widths: '360, 480, 720, 900, 1080',
                sizes: img_sizes,
                loading: 'eager',
                fetchpriority: 'high',
                alt: hero_alt
            }}
          </div>
        {%- else -%}
          <div class="sol-hero__slide" data-sol-slide="0" data-active>
            {{ 'product-1' | placeholder_svg_tag: 'sol-placeholder' }}
          </div>
        {%- endif -%}
      </div>

      {%- if gallery_count > 1 -%}
        <div class="sol-hero__nav">
          <button type="button" data-sol-prev aria-label="Previous image">&lsaquo;</button>
          <button type="button" data-sol-next aria-label="Next image">&rsaquo;</button>
        </div>
      {%- endif -%}
    </div>

    {%- if gallery_count > 1 -%}
      <div class="sol-hero__thumbs" role="group" aria-label="Product images">
        {%- if use_gallery_blocks -%}
          {%- assign thumb_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
              <button
                type="button"
                class="sol-hero__thumb"
                data-sol-thumb="{{ thumb_i }}"
                aria-current="{% if thumb_i == 0 %}true{% else %}false{% endif %}"
                aria-label="Show image {{ thumb_i | plus: 1 }}"
              >
                {{ block.settings.image | image_url: width: 200 | image_tag: widths: '100, 160, 200', sizes: '20vw', loading: 'lazy', alt: '' }}
              </button>
              {%- assign thumb_i = thumb_i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for media in gallery_media -%}
            <button
              type="button"
              class="sol-hero__thumb"
              data-sol-thumb="{{ forloop.index0 }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{% if media.media_type == 'image' %}Show image {{ forloop.index }}{% else %}Show video {{ forloop.index }}{% endif %}"
            >
              {{ media.preview_image | image_url: width: 200 | image_tag: widths: '100, 160, 200', sizes: '20vw', loading: 'lazy', alt: '' }}
              {%- unless media.media_type == 'image' -%}
                <span class="sol-hero__thumb-play" aria-hidden="true"></span>
              {%- endunless -%}
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- rating ---------- {%- endcomment -%}
    {%- if section.settings.show_rating -%}
      <div class="sol-hero__rating">
        <div class="sol-stars" aria-hidden="true">
          {%- for i in (1..section.settings.rating_stars) -%}<i>★</i>{%- endfor -%}
        </div>
        {%- if section.settings.rating_text != blank -%}
          <div class="sol-hero__rating-text">{{ section.settings.rating_text }}</div>
        {%- endif -%}
