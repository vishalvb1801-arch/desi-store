        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOL — Ingredients grid",
      "blocks": [
        { "type": "herb", "settings": { "name": "Nirgundi", "role": "the anti-inflammatory herb", "detail": "<p>Calms swelling and dulls the throb in stiff joints and the lower back.</p>", "color_from": "#7e8c1a", "color_to": "#24330f" } },
        { "type": "herb", "settings": { "name": "Rasna", "role": "the joint-mobility herb", "detail": "<p>The classical joint herb, used where movement feels restricted or creaky.</p>", "color_from": "#5e7345", "color_to": "#1e3a16" } },
        { "type": "herb", "settings": { "name": "Ashwagandha", "role": "the muscle-recovery herb", "detail": "<p>Helps tired, overworked muscle recover overnight.</p>", "color_from": "#6e8452", "color_to": "#24330f" } },
        { "type": "herb", "settings": { "name": "Nilgiri", "role": "the warming relief herb", "detail": "<p>Creates the warm, opening sensation that lets the massage reach deeper.</p>", "color_from": "#4a8b2c", "color_to": "#14260f" } },
        { "type": "herb", "settings": { "name": "Gandhapura", "role": "the deep-penetration herb", "detail": "<p>Carries the formula past the skin barrier and into the aching tissue.</p>", "color_from": "#9cae01", "color_to": "#24330f" } },
        { "type": "herb", "settings": { "name": "Pudina", "role": "the cooling comfort herb", "detail": "<p>Balances the warmth with a clean cooling finish so nothing feels harsh.</p>", "color_from": "#4a8b2c", "color_to": "#1e3a16" } }
      ]
