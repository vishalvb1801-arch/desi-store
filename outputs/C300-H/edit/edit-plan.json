        "out": 128.88
      },
      "shots": [
        {
          "clip": "clip_35",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg34",
      "role": "body",
      "line": "She stood there in the doorway, held that phone up to my face",
