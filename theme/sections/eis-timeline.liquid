{%- comment -%}
  EIS — Timeline ("What to expect")
  ------------------------------------------------------------------
  Stages down a connecting rail. Each stage is a full-width card whose top
  edge is straddled by a round photo on the left and a stage pill on the
  right; a hairline runs down the centre between consecutive cards and
  fills with gold as each stage scrolls into view. Empty image slots keep
  the design's striped placeholder so the rhythm is right before real
  photos land.
{%- endcomment -%}

{% render 'eis-fonts' %}

{% style %}
  {% render 'eis-tokens', id: section.id, s: section.settings %}

  .eis-time {
    background: var(--eis-maroon-deep);
    font-family: var(--eis-sans);
  }
  .eis-time__inner {
    max-width: var(--eis-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .eis-time__title {
    font-family: var(--eis-serif);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    color: var(--eis-cream-light);
    text-align: center;
    margin: 0 0 24px;
    line-height: 1.18;
  }
  /* "Pain Relief Oil Nightly" is a long last line: at full size it breaks to a
     fourth row on 360px phones, so trim the type there rather than the copy. */
  @media (max-width: 389px) {
    .eis-time__title { font-size: {{ section.settings.heading_size | times: 88 | divided_by: 100 }}px; }
  }
  .eis-time__list {
    --eis-marker: {{ section.settings.marker_size }}px;
    --eis-gap: {{ section.settings.stage_gap }}px;
    display: flex;
    flex-direction: column;
    gap: var(--eis-gap);
    /* room for the first card's circle, which hangs above it */
    padding-top: calc(var(--eis-marker) * .46);
  }
  .eis-time__row { position: relative; }
  /* The rail: one bar per gap, down the centre of the card. Two stacked
     backgrounds - a gold layer whose height animates from 0, over a dim base -
     so it fills downward as the stage below it comes into view. */
  .eis-time__row + .eis-time__row::before {
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: calc(-1 * var(--eis-gap));
    width: {{ section.settings.rail_width }}px;
    height: var(--eis-gap);
    border-radius: 999px;
    background:
      linear-gradient(var(--eis-gold-light), var(--eis-gold-light)) no-repeat top center,
      rgba(246, 231, 200, .28);
    background-size: 100% 0, auto;
    transition: background-size {{ section.settings.light_speed }}ms ease;
  }
  /* Same specificity as the rule above, so it has to come after it. */
  .eis-time__row.is-lit::before { background-size: 100% 100%, auto; }
  .eis-time__card {
    background: #FFFDF8;
    border-radius: 14px;
    /* top padding clears the circle that overlaps this edge */
    padding: calc(var(--eis-marker) * .58) 16px 16px;
    position: relative;
  }
  .eis-time__marker {
    position: absolute;
    top: calc(var(--eis-marker) * -.46);
    left: 16px;
    width: var(--eis-marker);
    height: var(--eis-marker);
    border-radius: 999px;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #EDE1CE 0 6px, #F9F1E4 6px 12px);
    box-shadow: 0 0 0 3px var(--eis-maroon-deep);
    transition: box-shadow {{ section.settings.light_speed }}ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 7px ui-monospace, monospace;
    color: var(--eis-soft);
    text-align: center;
    padding: 4px;
  }
  .eis-time__marker img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .eis-time__row.is-lit .eis-time__marker {
    box-shadow: 0 0 0 3px var(--eis-maroon-deep), 0 0 0 5px var(--eis-gold-light);
  }
  @media (prefers-reduced-motion: reduce) {
    .eis-time__row::before,
    .eis-time__marker { transition: none; }
  }
  .eis-time__badge {
    position: absolute;
    top: -11px;
    right: 16px;
    background: var(--eis-green);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .eis-time__point {
    display: flex;
    gap: 9px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--eis-ink);
  }
  .eis-time__point + .eis-time__point { margin-top: 9px; }
  .eis-time__tick {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    border-radius: 5px;
    background: var(--eis-green);
    color: #fff;
    font-size: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .eis-time__note {
    font-size: 12px;
    line-height: 1.55;
    color: #D9C6A2;
    text-align: center;
    margin: 26px 0 0;
  }

  /* ---------- desktop & iPad ---------- */
  @media (min-width: 750px) {
    .eis-time__inner { max-width: 976px; }
    .eis-time__title { font-size: 34px; }
    .eis-time__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; align-items: start; }
    /* One continuous rail behind the whole row of markers, rather than a
       segment per gap. The markers sit centred on it, half above their card. */
    /* The markers clear the cards entirely so the rail reads as one line
       across the section rather than disappearing behind each card. */
    .eis-time__list { position: relative; padding-top: calc(var(--eis-marker) + 14px); }
    .eis-time__list::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: calc(var(--eis-marker) * .5);
      height: {{ section.settings.rail_width }}px;
      border-radius: 999px;
      background: var(--eis-gold-light);
      opacity: .5;
    }
    .eis-time__row + .eis-time__row::before { display: none; }
    .eis-time__card {
      padding-top: 38px;
      overflow: visible;
    }
    .eis-time__marker {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      top: calc((var(--eis-marker) + 14px) * -1);
      border-radius: 16px;
      z-index: 1;
    }
    .eis-time__badge {
      top: 10px;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
    }
  }
  @media (min-width: 1200px) {
    .eis-time__inner { max-width: 1280px; }
    .eis-time__title { font-size: 42px; }
    .eis-time__list { gap: 24px; }
  }
{% endstyle %}

<div class="eis-time">
  <div class="eis-time__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="eis-time__title">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}

    <div class="eis-time__list">
      {%- for block in section.blocks -%}
        <div
          class="eis-time__row{% unless section.settings.animate %} is-lit{% endunless %}"
          {{ block.shopify_attributes }}
        >
          <div class="eis-time__card">
            <div class="eis-time__marker" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 220
                  | image_tag: widths: '110, 160, 220', sizes: '72px', loading: 'lazy', alt: ''
                }}
              {%- else -%}
                {{ block.settings.placeholder_note }}
              {%- endif -%}
            </div>
            {%- if block.settings.badge != blank -%}
              <div class="eis-time__badge">{{ block.settings.badge }}</div>
            {%- endif -%}
            {%- if block.settings.point_1 != blank -%}
              <div class="eis-time__point">
                <span class="eis-time__tick" aria-hidden="true">✓</span>
                <span>{{ block.settings.point_1 }}</span>
              </div>
            {%- endif -%}
            {%- if block.settings.point_2 != blank -%}
              <div class="eis-time__point">
                <span class="eis-time__tick" aria-hidden="true">✓</span>
                <span>{{ block.settings.point_2 }}</span>
              </div>
            {%- endif -%}
            {%- if block.settings.point_3 != blank -%}
              <div class="eis-time__point">
                <span class="eis-time__tick" aria-hidden="true">✓</span>
                <span>{{ block.settings.point_3 }}</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="eis-time__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.animate -%}
  <script>
    (function () {
      var list = document.querySelector('#shopify-section-{{ section.id }} .eis-time__list');
      if (!list) return;
      var rows = list.querySelectorAll('.eis-time__row');

      /* No IntersectionObserver (old Android WebViews): show the lit state. */
      if (!('IntersectionObserver' in window)) {
        for (var i = 0; i < rows.length; i++) rows[i].classList.add('is-lit');
        return;
      }

      var io = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.classList.add('is-lit');
              io.unobserve(entries[i].target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -12% 0px' }
      );

      for (var j = 0; j < rows.length; j++) io.observe(rows[j]);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "EIS — Timeline",
  "tag": "section",
  "class": "eis-section eis-section--timeline",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "What to Expect\nWhen You Start Using\nPain Relief Oil Nightly"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Photo circle size",
      "min": 48,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "stage_gap",
      "label": "Space between stages",
      "info": "The connecting rail fills this gap.",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "rail_width",
      "label": "Rail thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Light the rail up as it scrolls",
      "info": "Off renders every stage already lit.",
      "default": true
    },
    {
      "type": "range",
      "id": "light_speed",
      "label": "Light-up speed",
      "min": 200,
      "max": 1600,
      "step": 50,
      "unit": "ms",
      "default": 800
    },
    {
      "type": "text",
      "id": "note",
      "label": "Closing note",
      "default": "Customers report their best results after 3–4 weeks of nightly use — consistency is the key."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_maroon_deep",
      "label": "Background",
      "default": "#5C0D0F"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Heading",
      "default": "#F6E7C8"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Card text",
      "default": "#2A1C18"
    },
    {
      "type": "color",
      "id": "color_green",
      "label": "Badge & ticks",
      "default": "#1E7A4D"
    },
    {
      "type": "color",
      "id": "color_gold_light",
      "label": "Rail light-up",
      "default": "#E3C46F"
    },
    {
      "type": "color",
      "id": "color_soft",
      "label": "Placeholder text",
      "default": "#8A7A63"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Stage badge",
          "default": "NIGHT 1–2"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "placeholder_note",
          "label": "Placeholder note",
          "info": "Shown in the circle until you add a photo.",
          "default": "night massage"
        },
        {
          "type": "text",
          "id": "point_1",
          "label": "Line 1",
          "default": "Warm it, massage it in before bed."
        },
        {
          "type": "text",
          "id": "point_2",
          "label": "Line 2"
        },
        {
          "type": "text",
          "id": "point_3",
          "label": "Line 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EIS — Timeline",
      "blocks": [
        {
          "type": "stage",
          "settings": {
            "badge": "NIGHT 1–2",
            "placeholder_note": "night massage",
            "point_1": "Warm it, massage it in before bed.",
            "point_2": "The area feels lighter and stiffness starts to ease."
          }
        },
        {
          "type": "stage",
          "settings": {
            "badge": "DAY 3–7",
            "placeholder_note": "morning stretch",
            "point_1": "Morning stiffness eases.",
            "point_2": "You wake up moving more freely."
          }
        },
        {
          "type": "stage",
          "settings": {
            "badge": "WEEK 2–4",
            "placeholder_note": "walk / stairs",
            "point_1": "Relief lasts longer through the day.",
            "point_2": "Back on your walks, stairs and daily activities."
          }
        },
        {
          "type": "stage",
          "settings": {
            "badge": "WEEK 4+",
            "placeholder_note": "family photo",
            "point_1": "Consistent nightly use keeps joints loose and comfortable long-term."
          }
        }
      ]
    }
  ]
}
{% endschema %}
