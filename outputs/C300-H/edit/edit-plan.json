      "shots": [
        {
          "clip": "clip_18",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg18",
      "role": "body",
      "line": "I'm just tired, jaan…",
