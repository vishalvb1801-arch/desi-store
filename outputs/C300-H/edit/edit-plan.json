        "file": "vo.mp3",
        "in": 49.06,
        "out": 52.28
      },
      "shots": [
        {
          "clip": "clip_14",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg14",
      "role": "body",
      "line": "Sat out my nephew's wedding while she danced and looked at my chair",
