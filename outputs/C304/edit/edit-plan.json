      {
        "segment": "seg05",
        "start": 0.07,
        "end": 0.92,
        "text": "You're *leaning*"
      },
      {
        "segment": "seg05",
        "start": 0.92,
        "end": 2.18,
        "text": "for a goodnight *kiss*,"
      },
      {
        "segment": "seg05",
        "start": 2.18,
        "end": 3.03,
        "text": "my *shoulder*"
      },
      {
        "segment": "seg05",
        "start": 3.03,
        "end": 4.35,
        "text": "pulls me away"
      },
      {
        "segment": "seg06",
        "start": 0.0,
        "end": 1.01,
        "text": "We said we'd leave"
      },
      {
        "segment": "seg06",
        "start": 1.01,
        "end": 1.86,
        "text": "at *seven*,"
      },
      {
        "segment": "seg06",
        "start": 1.86,
        "end": 2.71,
        "text": "but my *knees*"
      },
      {
        "segment": "seg06",
        "start": 2.71,
        "end": 3.96,
        "text": "just made me stay"
      },
      {
        "segment": "seg07",
        "start": 0.15,
        "end": 1.31,
        "text": "Your *jacket's* gone,"
      },
      {
        "segment": "seg07",
        "start": 1.31,
        "end": 2.55,
        "text": "I'm still in *bed*,"
      },
      {
        "segment": "seg07",
        "start": 2.55,
        "end": 3.4,
        "text": "another *night*"
      },
      {
        "segment": "seg07",
        "start": 3.4,
        "end": 4.26,
        "text": "slips by"
      },
      {
        "segment": "seg08",
        "start": 0.0,
        "end": 1.09,
        "text": "I scroll through"
      },
      {
        "segment": "seg08",
        "start": 1.09,
        "end": 2.39,
        "text": "\"*pain relief* at night\""
      },
      {
        "segment": "seg08",
        "start": 2.39,
        "end": 3.83,
        "text": "till *two*,"
      },
      {
        "segment": "seg08",
        "start": 3.83,
        "end": 5.49,
        "text": "and *wonder why*"
      },
      {
        "segment": "seg09",
        "start": 0.0,
        "end": 1.82,
        "text": "You say you're *tired*"
      },
      {
        "segment": "seg09",
        "start": 1.82,
        "end": 3.18,
        "text": "of reaching for"
      },
      {
        "segment": "seg09",
        "start": 3.18,
        "end": 4.7,
        "text": "someone *never there*"
      },
      {
        "segment": "seg10",
        "start": 0.01,
        "end": 1.74,
        "text": "You say it's *over*,"
      },
      {
        "segment": "seg10",
        "start": 1.74,
        "end": 2.6,
        "text": "I look up,"
      },
      {
        "segment": "seg10",
        "start": 2.6,
        "end": 3.45,
        "text": "he's *waiting*"
      },
      {
        "segment": "seg10",
        "start": 3.45,
        "end": 4.5,
        "text": "on the stairs"
      },
      {
        "segment": "seg11",
        "start": 0.0,
        "end": 1.46,
        "text": "I ask if we can"
      },
      {
        "segment": "seg11",
        "start": 1.46,
        "end": 2.32,
        "text": "*talk* this through,"
      },
      {
        "segment": "seg11",
        "start": 2.32,
        "end": 3.42,
        "text": "you say you made"
      },
      {
        "segment": "seg11",
        "start": 3.42,
        "end": 4.33,
        "text": "your *choice*"
      },
      {
        "segment": "seg12",
        "start": 0.0,
        "end": 1.37,
        "text": "You roll your *suitcase*"
      },
      {
        "segment": "seg12",
        "start": 1.37,
        "end": 2.41,
        "text": "out the *door*,"
      },
      {
        "segment": "seg12",
        "start": 2.41,
        "end": 5.29,
        "text": "I can't find my *voice*"
      },
      {
        "segment": "seg13",
        "start": 0.0,
        "end": 1.04,
        "text": "I'm *scrolling* through"
      },
      {
        "segment": "seg13",
        "start": 1.04,
        "end": 1.89,
        "text": "your pictures,"
      },
      {
        "segment": "seg13",
        "start": 1.89,
        "end": 2.74,
        "text": "you're out with *him*,"
      },
      {
        "segment": "seg13",
        "start": 2.74,
        "end": 4.05,
        "text": "so *carefree*"
      },
      {
        "segment": "seg14",
        "start": 0.15,
        "end": 1.41,
        "text": "I *wince* just tying"
      },
      {
        "segment": "seg14",
        "start": 1.41,
        "end": 2.69,
        "text": "up my shoes,"
      },
      {
        "segment": "seg14",
        "start": 2.69,
        "end": 3.54,
        "text": "when did this"
      },
      {
        "segment": "seg14",
        "start": 3.54,
        "end": 4.4,
        "text": "*become me*?"
      },
      {
        "segment": "seg15",
        "start": 0.15,
        "end": 1.11,
        "text": "The *boss* says,"
      },
      {
        "segment": "seg15",
        "start": 1.11,
        "end": 2.69,
        "text": "\"Too many *sick days*,"
      },
      {
        "segment": "seg15",
        "start": 2.69,
        "end": 3.54,
        "text": "*Raj*, we're letting"
      },
      {
        "segment": "seg15",
        "start": 3.54,
        "end": 4.6,
        "text": "you go\""
      },
      {
        "segment": "seg16",
        "start": 0.0,
        "end": 0.89,
        "text": "I pack my *desk*"
      },
      {
        "segment": "seg16",
        "start": 0.89,
        "end": 1.91,
        "text": "into a *box*"
      },
      {
        "segment": "seg16",
        "start": 1.91,
        "end": 2.91,
        "text": "and carry it"
      },
      {
        "segment": "seg16",
        "start": 2.91,
        "end": 4.66,
        "text": "*home* slow"
      },
      {
        "segment": "seg17",
        "start": 0.15,
        "end": 1.27,
        "text": "I go home"
      },
      {
        "segment": "seg17",
        "start": 1.27,
        "end": 2.72,
        "text": "to my *Nani's* house,"
      },
      {
        "segment": "seg17",
        "start": 2.72,
        "end": 3.57,
        "text": "she sees me *wince*"
      },
      {
        "segment": "seg17",
        "start": 3.57,
        "end": 4.42,
        "text": "and stop"
      },
      {
        "segment": "seg18",
        "start": 0.0,
        "end": 0.85,
        "text": "She says,"
      },
      {
        "segment": "seg18",
        "start": 0.85,
        "end": 2.21,
        "text": "\"*EIS* Pain Relief Oil."
      },
      {
        "segment": "seg18",
        "start": 2.21,
        "end": 3.19,
        "text": "Every *night*,"
      },
      {
        "segment": "seg18",
        "start": 3.19,
        "end": 4.31,
        "text": "just *warm a drop*\""
      },
      {
        "segment": "seg19",
        "start": 0.0,
        "end": 1.22,
        "text": "She *warms* it"
      },
      {
        "segment": "seg19",
        "start": 1.22,
        "end": 2.07,
        "text": "in her *palms*"
      },
      {
        "segment": "seg19",
        "start": 2.07,
        "end": 3.06,
        "text": "and *rubs* it deep"
      },
      {
        "segment": "seg19",
        "start": 3.06,
        "end": 4.43,
        "text": "into my *knee*"
      },
      {
        "segment": "seg20",
        "start": 0.15,
        "end": 1.97,
        "text": "*Fifteen* Ayurvedic"
      },
      {
        "segment": "seg20",
        "start": 1.97,
        "end": 3.15,
        "text": "*herbs* inside,"
      },
      {
        "segment": "seg20",
        "start": 3.15,
        "end": 4.84,
        "text": "*Mahanarayan*,"
      },
      {
        "segment": "seg20",
        "start": 4.84,
        "end": 6.63,
        "text": "*Nirgundi*"
      },
      {
        "segment": "seg21",
        "start": 0.0,
        "end": 0.85,
        "text": "It *soaks* in"
      },
      {
        "segment": "seg21",
        "start": 0.85,
        "end": 1.78,
        "text": "past the skin,"
      },
      {
        "segment": "seg21",
        "start": 1.78,
        "end": 2.94,
        "text": "right down to"
      },
      {
        "segment": "seg21",
        "start": 2.94,
        "end": 4.15,
        "text": "where it's *sore*"
      },
      {
        "segment": "seg22",
        "start": 0.0,
        "end": 0.85,
        "text": "It *calms*"
      },
      {
        "segment": "seg22",
        "start": 0.85,
        "end": 1.7,
        "text": "the swelling,"
      },
      {
        "segment": "seg22",
        "start": 1.7,
        "end": 2.55,
        "text": "*warms* the joint,"
      },
      {
        "segment": "seg22",
        "start": 2.55,
        "end": 3.4,
        "text": "I *read* and read"
      },
      {
        "segment": "seg22",
        "start": 3.4,
        "end": 4.46,
        "text": "some more"
      },
      {
        "segment": "seg23",
        "start": 0.0,
        "end": 0.85,
        "text": "*Week 1*,"
      },
      {
        "segment": "seg23",
        "start": 0.85,
        "end": 2.15,
        "text": "I warm it every *night*,"
      },
      {
        "segment": "seg23",
        "start": 2.15,
        "end": 3.0,
        "text": "and *sleep* straight"
      },
      {
        "segment": "seg23",
        "start": 3.0,
        "end": 4.06,
        "text": "through till *dawn*"
      },
      {
        "segment": "seg24",
        "start": 0.0,
        "end": 1.43,
        "text": "I make my *list*,"
      },
      {
        "segment": "seg24",
        "start": 1.43,
        "end": 2.33,
        "text": "I *tick* one off,"
      },
      {
        "segment": "seg24",
        "start": 2.33,
        "end": 3.37,
        "text": "then one more thing"
      },
      {
        "segment": "seg24",
        "start": 3.37,
        "end": 5.37,
        "text": "is *done*"
      },
      {
        "segment": "seg25",
        "start": 0.0,
        "end": 0.85,
        "text": "*Week 2*,"
      },
      {
        "segment": "seg25",
        "start": 0.85,
        "end": 1.7,
        "text": "I'm *taking on*"
      },
      {
        "segment": "seg25",
        "start": 1.7,
        "end": 2.62,
        "text": "the things I used to"
      },
      {
        "segment": "seg25",
        "start": 2.62,
        "end": 4.1,
        "text": "leave for *another day*"
      },
      {
        "segment": "seg26",
        "start": 0.0,
        "end": 1.26,
        "text": "I *sketch* the plan"
      },
      {
        "segment": "seg26",
        "start": 1.26,
        "end": 2.74,
        "text": "for my own *business*,"
      },
      {
        "segment": "seg26",
        "start": 2.74,
        "end": 4.23,
        "text": "push my *doubts* away"
      },
      {
        "segment": "seg27",
        "start": 0.0,
        "end": 1.51,
        "text": "*Week 3*, I'm working"
      },
      {
        "segment": "seg27",
        "start": 1.51,
        "end": 2.36,
        "text": "on my *body*,"
      },
      {
        "segment": "seg27",
        "start": 2.36,
        "end": 3.21,
        "text": "*Nani* claps,"
      },
      {
        "segment": "seg27",
        "start": 3.21,
        "end": 4.42,
        "text": "\"Ready? *Here we go*\""
      },
      {
        "segment": "seg28",
        "start": 0.0,
        "end": 1.31,
        "text": "One more *squat*,"
      },
      {
        "segment": "seg28",
        "start": 1.31,
        "end": 2.35,
        "text": "my *knees* don't scream,"
      },
      {
        "segment": "seg28",
        "start": 2.35,
        "end": 3.25,
        "text": "I'm *laughing*,"
      },
      {
        "segment": "seg28",
        "start": 3.25,
        "end": 4.51,
        "text": "bending low"
      },
      {
        "segment": "seg29",
        "start": 0.15,
        "end": 1.0,
        "text": "One *morning*,"
      },
      {
        "segment": "seg29",
        "start": 1.0,
        "end": 2.12,
        "text": "I walk in *tall*,"
      },
      {
        "segment": "seg29",
        "start": 2.12,
        "end": 2.97,
        "text": "the *gym* feels"
      },
      {
        "segment": "seg29",
        "start": 2.97,
        "end": 4.11,
        "text": "like my home"
      },
      {
        "segment": "seg30",
        "start": 0.0,
        "end": 1.25,
        "text": "A *girl* walks up"
      },
      {
        "segment": "seg30",
        "start": 1.25,
        "end": 2.19,
        "text": "and *smiles* at me,"
      },
      {
        "segment": "seg30",
        "start": 2.19,
        "end": 3.04,
        "text": "she asks,"
      },
      {
        "segment": "seg30",
        "start": 3.04,
        "end": 4.22,
        "text": "\"You train *alone*?\""
      },
      {
        "segment": "seg31",
        "start": 0.0,
        "end": 1.31,
        "text": "My first big *order*"
      },
      {
        "segment": "seg31",
        "start": 1.31,
        "end": 2.21,
        "text": "comes in,"
      },
      {
        "segment": "seg31",
        "start": 2.21,
        "end": 3.41,
        "text": "I *launched* my shop"
      },
      {
        "segment": "seg31",
        "start": 3.41,
        "end": 4.53,
        "text": "last week"
      },
      {
        "segment": "seg32",
        "start": 0.0,
        "end": 0.85,
        "text": "*Week 4*,"
      },
      {
        "segment": "seg32",
        "start": 0.85,
        "end": 1.7,
        "text": "we're *laughing*,"
      },
      {
        "segment": "seg32",
        "start": 1.7,
        "end": 2.7,
        "text": "walking *hand in hand*"
      },
      {
        "segment": "seg32",
        "start": 2.7,
        "end": 4.29,
        "text": "along the street"
      },
      {
        "segment": "seg33",
        "start": 0.0,
        "end": 1.03,
        "text": "You stop and *stare*,"
      },
      {
        "segment": "seg33",
        "start": 1.03,
        "end": 2.17,
        "text": "say \"Is that *you*?\""
      },
      {
        "segment": "seg33",
        "start": 2.17,
        "end": 3.02,
        "text": "I smile,"
      },
      {
        "segment": "seg33",
        "start": 3.02,
        "end": 4.2,
        "text": "\"I'm *doing fine*\""
      },
      {
        "segment": "seg34",
        "start": 0.0,
        "end": 0.91,
        "text": "\"Hope you're"
      },
      {
        "segment": "seg34",
        "start": 0.91,
        "end": 1.76,
        "text": "doing *well*.\""
      },
      {
        "segment": "seg34",
        "start": 1.76,
        "end": 2.61,
        "text": "We *laugh*"
      },
      {
        "segment": "seg34",
        "start": 2.61,
        "end": 3.46,
        "text": "and walk away,"
      },
      {
        "segment": "seg34",
        "start": 3.46,
        "end": 5.63,
        "text": "her *hand in mine*"
      },
      {
        "segment": "seg35",
        "start": 0.0,
        "end": 1.49,
        "text": "Now I *see* what's right"
      },
      {
        "segment": "seg35",
        "start": 1.49,
        "end": 2.39,
        "text": "in front of me,"
      },
      {
        "segment": "seg35",
        "start": 2.39,
        "end": 3.24,
        "text": "and what I *want*"
      },
      {
        "segment": "seg35",
        "start": 3.24,
        "end": 4.38,
        "text": "my *life* to be"
      },
      {
        "segment": "seg36",
        "start": 0.0,
        "end": 1.37,
        "text": "I'm making *plans*"
      },
      {
        "segment": "seg36",
        "start": 1.37,
        "end": 2.53,
        "text": "and *keeping* them,"
      },
      {
        "segment": "seg36",
        "start": 2.53,
        "end": 3.38,
        "text": "I'm *moving*"
      },
      {
        "segment": "seg36",
        "start": 3.38,
        "end": 4.43,
        "text": "like I'm *free*"
      },
      {
        "segment": "seg37",
        "start": 0.0,
        "end": 1.16,
        "text": "End the night"
      },
      {
        "segment": "seg37",
        "start": 1.16,
        "end": 2.48,
        "text": "with *EIS*,"
      },
      {
        "segment": "seg37",
        "start": 2.48,
        "end": 4.02,
        "text": "make a little *room*"
      },
      {
        "segment": "seg37",
        "start": 4.02,
        "end": 5.48,
        "text": "for me"
      }
    ]
  },
