      },
      "shots": [
        {
          "clip": "clip_53",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg52",
      "role": "body",
      "line": "She came out in that red saree, nervous like our first night again",
