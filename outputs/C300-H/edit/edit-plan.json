        "file": "vo.mp3",
        "in": 115.18,
        "out": 118.64
      },
      "shots": [
        {
          "clip": "clip_30",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg31",
      "role": "body",
      "line": "She scrolled through every message, every call, and found no name",
