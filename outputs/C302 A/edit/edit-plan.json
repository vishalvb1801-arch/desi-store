        "segment": "seg37",
        "start": 2.1,
        "end": 3.33,
        "text": "start for you"
      },
      {
        "segment": "seg38",
        "start": 0.0,
        "end": 2.01,
        "text": "It's called *EIS*"
      },
      {
        "segment": "seg38",
        "start": 2.01,
        "end": 2.86,
        "text": "*Ayurvedic*"
      },
      {
        "segment": "seg38",
        "start": 2.86,
        "end": 4.57,
        "text": "Pain Relief *Oil*"
      },
      {
        "segment": "seg39",
        "start": 0.0,
        "end": 1.01,
        "text": "*Mahanarayan*"
      },
      {
        "segment": "seg39",
        "start": 1.01,
        "end": 1.86,
        "text": "*Nirgundi*"
      },
      {
        "segment": "seg39",
        "start": 1.86,
        "end": 3.12,
        "text": "*Ashwagandha*"
      },
      {
        "segment": "seg40",
        "start": 0.0,
        "end": 1.67,
        "text": "Week one"
      },
      {
        "segment": "seg40",
        "start": 1.67,
        "end": 2.97,
        "text": "I *slept* straight"
      },
      {
        "segment": "seg40",
        "start": 2.97,
        "end": 4.77,
        "text": "through the *night*"
      },
      {
        "segment": "seg40",
        "start": 4.77,
        "end": 6.37,
        "text": "Week two"
      },
      {
        "segment": "seg40",
        "start": 6.37,
        "end": 7.47,
        "text": "the morning *stiffness*"
      },
      {
        "segment": "seg40",
        "start": 7.47,
        "end": 8.53,
        "text": "started feeling"
      },
      {
        "segment": "seg40",
        "start": 8.53,
        "end": 9.38,
        "text": "*light*"
      },
      {
        "segment": "seg41",
        "start": 0.0,
        "end": 2.03,
        "text": "Week three"
      },
      {
        "segment": "seg41",
        "start": 2.03,
        "end": 2.91,
        "text": "the *stairs* stopped"
      },
      {
        "segment": "seg41",
        "start": 2.91,
        "end": 4.3,
        "text": "*scaring* me"
      },
      {
        "segment": "seg42",
        "start": 0.0,
        "end": 1.81,
        "text": "A *month* in"
      },
      {
        "segment": "seg42",
        "start": 1.81,
        "end": 2.85,
        "text": "cross-legged"
      },
      {
        "segment": "seg42",
        "start": 2.85,
        "end": 3.7,
        "text": "at *puja*"
      },
      {
        "segment": "seg42",
        "start": 3.7,
        "end": 4.55,
        "text": "I got up *free*"
      },
      {
        "segment": "seg42",
        "start": 4.55,
        "end": 5.93,
        "text": "didn't even"
      },
      {
        "segment": "seg42",
        "start": 5.93,
        "end": 7.03,
        "text": "hold the *wall*"
      },
      {
        "segment": "seg43",
        "start": 0.0,
        "end": 1.9,
        "text": "Six *weeks* in"
      },
      {
        "segment": "seg43",
        "start": 1.9,
        "end": 4.08,
        "text": "the society *match*"
      },
      {
        "segment": "seg43",
        "start": 4.08,
        "end": 5.3,
        "text": "twenty *overs*"
      },
      {
        "segment": "seg43",
        "start": 5.3,
        "end": 6.5,
        "text": "played it *all*"
      },
      {
        "segment": "seg43",
        "start": 6.5,
        "end": 9.57,
        "text": "Not the *old* me"
      },
      {
        "segment": "seg44",
        "start": 0.0,
        "end": 2.28,
        "text": "The me I was"
      },
      {
        "segment": "seg44",
        "start": 2.28,
        "end": 4.45,
        "text": "*supposed* to be"
      },
      {
        "segment": "seg45",
        "start": 0.0,
        "end": 1.94,
        "text": "Next society function"
      },
      {
        "segment": "seg45",
        "start": 1.94,
        "end": 2.94,
        "text": "*first* one"
      },
      {
        "segment": "seg45",
        "start": 2.94,
        "end": 3.79,
        "text": "on the *floor*"
      },
      {
        "segment": "seg45",
        "start": 3.79,
        "end": 5.06,
        "text": "in that same"
      },
      {
        "segment": "seg45",
        "start": 5.06,
        "end": 6.42,
        "text": "*Diwali* kurta"
      },
      {
        "segment": "seg45",
        "start": 6.42,
        "end": 7.27,
        "text": "standing *tall*"
      },
      {
        "segment": "seg45",
        "start": 7.27,
        "end": 8.12,
        "text": "once more"
      },
      {
        "segment": "seg46",
        "start": 0.0,
        "end": 1.42,
        "text": "Nothing *extra*"
      },
      {
        "segment": "seg46",
        "start": 1.42,
        "end": 2.56,
        "text": "No *belt*"
      },
      {
        "segment": "seg46",
        "start": 2.56,
        "end": 3.88,
        "text": "No *painkiller*"
      },
      {
        "segment": "seg47",
        "start": 0.0,
        "end": 2.46,
        "text": "And there's *Priya*"
      },
      {
        "segment": "seg47",
        "start": 2.46,
        "end": 5.69,
        "text": "*Kunal* next to her"
      },
      {
        "segment": "seg48",
        "start": 0.0,
        "end": 1.55,
        "text": "My *nani* walks in"
      },
      {
        "segment": "seg48",
        "start": 1.55,
        "end": 2.4,
        "text": "I bend"
      },
      {
        "segment": "seg48",
        "start": 2.4,
        "end": 3.25,
        "text": "touch her *feet*"
      },
      {
        "segment": "seg48",
        "start": 3.25,
        "end": 4.22,
        "text": "come up *smooth*"
      },
      {
        "segment": "seg49",
        "start": 0.0,
        "end": 2.04,
        "text": "Priya's face *changed*"
      },
      {
        "segment": "seg50",
        "start": 0.0,
        "end": 1.92,
        "text": "that's a *bonus*, see"
      },
      {
        "segment": "seg51",
        "start": 0.0,
        "end": 0.95,
        "text": "but it's not"
      },
      {
        "segment": "seg51",
        "start": 0.95,
        "end": 2.45,
        "text": "for her *anymore*"
      },
      {
        "segment": "seg51",
        "start": 2.45,
        "end": 4.88,
        "text": "It's for *me*"
      }
    ]
  },
