<script>
  (function () {
    var root = document.getElementById('EisHero-{{ section.id }}');
    var sticky = document.querySelector('[data-sol-sticky][data-offers="EisOffers-{{ section.id }}"]');
    if (!root) return;

    /* ---- gallery ---- */
    var slides = root.querySelectorAll('[data-sol-slide]');
    var thumbs = root.querySelectorAll('[data-sol-thumb]');
    var index = 0;
    var motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(next) {
      if (!slides.length) return;
      index = (next + slides.length) % slides.length;
      for (var i = 0; i < slides.length; i++) {
        if (i === index) {
          slides[i].setAttribute('data-active', '');
        } else {
          slides[i].removeAttribute('data-active');
        }
      }
      for (var t = 0; t < thumbs.length; t++) {
        thumbs[t].setAttribute('aria-current', t === index ? 'true' : 'false');
      }
      warm(index + 1);
      warm(index - 1);
      playActive();
      trackThumb();
    }

    /* Every video is marked autoplay so it still runs with JS disabled, which
       left to itself would have several slides decoding at once. Only the one
       on screen plays; a reduced-motion preference stops all of them. */
    function playActive() {
      for (var i = 0; i < slides.length; i++) {
        var video = slides[i].querySelector('video');
        if (!video) continue;
        if (i === index && motionOK) {
          var playing = video.play();
          /* Browsers reject play() for reasons outside our control — a data
             saver, a power-saving mode. An unhandled rejection is noisy and
             there is nothing to recover, so swallow it. */
          if (playing && playing.catch) playing.catch(function () {});
        } else {
          video.pause();
        }
      }
    }

    /* Slides are display:none, so a lazy image in one is never in the viewport
       and does not start downloading until the customer lands on it — which on
       a heavy frame reads as a broken slide. Flipping the neighbours to eager
       fetches them in the background: an eager image loads whether or not it is
       displayed, so the next slide is usually ready before it is asked for. */
    function warm(i) {
      /* Deliberately does not wrap the way show() does: from the first slide
         that would warm the last one, and the last slide is exactly where a
         heavy frame tends to sit. */
      if (i < 0 || i >= slides.length) return;
      var slide = slides[i];
      var img = slide.querySelector('img');
      if (img && img.getAttribute('loading') === 'lazy') {
        img.setAttribute('loading', 'eager');
      }
    }

    /* The thumb row scrolls, so the active thumb can sit off-screen after the
       arrows move the main image. Scroll the row itself rather than calling
       scrollIntoView, which would drag the whole page along with it. */
    var thumbRow = root.querySelector('.sol-hero__thumbs');
    var smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function trackThumb() {
      if (!thumbRow || !thumbs[index]) return;
      var t = thumbs[index];
      var left = t.offsetLeft - (thumbRow.clientWidth - t.offsetWidth) / 2;
      left = Math.max(0, Math.min(left, thumbRow.scrollWidth - thumbRow.clientWidth));
      if (thumbRow.scrollTo) {
        thumbRow.scrollTo({ left: left, behavior: smooth ? 'smooth' : 'auto' });
      } else {
        thumbRow.scrollLeft = left;
      }
    }

    for (var t = 0; t < thumbs.length; t++) {
      (function (el) {
        el.addEventListener('click', function () {
          show(parseInt(el.getAttribute('data-sol-thumb'), 10));
        });
      })(thumbs[t]);
    }

    var prev = root.querySelector('[data-sol-prev]');
    var next = root.querySelector('[data-sol-next]');
    if (prev) prev.addEventListener('click', function () { show(index - 1); });
    if (next) next.addEventListener('click', function () { show(index + 1); });

    /* The first slide is marked active by Liquid, so show() has not run yet.
       Settle the videos once on load, which is what stops a video first slide
       from playing when the visitor asked for reduced motion. */
    playActive();

    /* ---- swipe ---- */
    var stage = root.querySelector('.sol-hero__stage');
    if (stage && slides.length > 1) {
      var startX = null;
      stage.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
      stage.addEventListener('touchend', function (e) {
        if (startX === null) return;
        var dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) show(dx < 0 ? index + 1 : index - 1);
        startX = null;
      }, { passive: true });
    }

    /* ---- add to cart (AJAX; never navigates) ----
       The customer keeps their place on the page. Nothing here opens a cart:
       the drawer is the bundle app's, and it reacts to the events below. */
    function notifyCartUpdated() {
      /* Themes and cart-drawer apps each listen for their own name, and an
         event nobody hears costs nothing, so fire the common ones. */
      ['cart:refresh', 'cart:update', 'cart-update'].forEach(function (name) {
        document.dispatchEvent(
          new CustomEvent(name, { bubbles: true, detail: { source: 'sol-hero' } })
        );
      });
    }

    function addToCart(variantId, button) {
      if (!variantId) return;
      var original = button.innerHTML;
      button.disabled = true;
      button.innerHTML = {{ section.settings.adding_label | json }};
      fetch('{{ routes.cart_add_url }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (r) {
          if (!r.ok) throw new Error(r.data && r.data.description ? r.data.description : 'Add to cart failed');
          button.innerHTML = {{ section.settings.added_label | json }};
          notifyCartUpdated();
          /* Back to the normal label so a second bottle is one click away. */
          window.setTimeout(function () {
            button.disabled = false;
            button.innerHTML = original;
          }, 1800);
        })
        .catch(function (err) {
          button.disabled = false;
          button.innerHTML = original;
          /* Slow or flaky network: fall back to a normal form post, which
             adds the item and returns to this page via return_to. */
          var form = root.querySelector('[data-sol-form]');
          if (form) { form.removeAttribute('data-sol-form'); form.submit(); return; }
          window.alert(err.message);
        });
    }

    var form = root.querySelector('[data-sol-form]');
    if (form) {
      form.addEventListener('submit', function (e) {
        if (!form.hasAttribute('data-sol-form')) return;
        e.preventDefault();
        var btn = form.querySelector('[data-sol-atc]');
        addToCart(form.querySelector('input[name="id"]').value, btn);
      });
    }

    /* ---- social proof counter ---- */
    var counter = root.querySelector('[data-sol-count]');
    if (counter && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var cFrom = parseInt(counter.getAttribute('data-from'), 10);
      var cTo = parseInt(counter.getAttribute('data-to'), 10);
      var COUNT_MS = 2000;
      var PAUSE_MS = 10000;

      if (!isNaN(cFrom) && !isNaN(cTo) && cTo > cFrom) {
        var fmt = function (n) {
          try { return n.toLocaleString('en-IN'); } catch (e) { return String(n); }
        };

        var runCount = function () {
          var startTime = null;
          var step = function (now) {
            if (startTime === null) startTime = now;
            var progress = Math.min((now - startTime) / COUNT_MS, 1);
            /* easeOutExpo: fast off the mark, then settles */
            var eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            counter.textContent = fmt(Math.floor(cFrom + eased * (cTo - cFrom)));
            if (progress < 1) {
              window.requestAnimationFrame(step);
            } else {
              counter.textContent = fmt(cTo);
              window.setTimeout(runCount, PAUSE_MS);
            }
          };
          window.requestAnimationFrame(step);
        };

        /* Only start once the row is actually on screen, so the first run
           isn't spent before anybody scrolls down to it. */
        if (window.IntersectionObserver) {
          var seen = false;
          var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting && !seen) { seen = true; io.disconnect(); runCount(); }
            }
          }, { threshold: 0.4 });
          io.observe(counter);
        } else {
          window.setTimeout(runCount, 500);
        }
      }
    }

    /* ---- delivery estimate on the viewer's own clock ---- */
    var deliv = root.querySelector('[data-sol-delivery]');
    if (deliv) {
      var out = deliv.querySelector('[data-sol-delivery-range]');
      var minD = parseInt(deliv.getAttribute('data-min-days'), 10);
      var maxD = parseInt(deliv.getAttribute('data-max-days'), 10);
      if (out && !isNaN(minD) && !isNaN(maxD)) {
        var dayLabel = function (offset) {
          var d = new Date();
          d.setDate(d.getDate() + offset);
          try {
            return d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
          } catch (e) {
            return d.toDateString().slice(0, 10);
          }
        };
        out.textContent = dayLabel(minD) + ' \u2013 ' + dayLabel(maxD);
      }
    }

    /* ---- sticky bar ---- */
    if (sticky) {
      var revealAt = parseInt(sticky.getAttribute('data-reveal-at'), 10) || 620;
      var action = sticky.getAttribute('data-action');
      var revealMode = sticky.getAttribute('data-reveal-mode');
      var ticking = false;

      /* The buy box ends with its FAQ, so that is the anchor. With the FAQ
         switched off, fall back to the whole hero. */
      var revealAnchor = root.querySelector('.sol-bfaq') || root;

      function update() {
        var show;
        if (revealMode === 'after_buy_box') {
          show = revealAnchor.getBoundingClientRect().bottom <= 0;
        } else {
          var y = window.scrollY || document.documentElement.scrollTop;
          show = y > revealAt;
        }
        sticky.classList.toggle('is-visible', show);
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
      }, { passive: true });
      update();

      var stickyBtn = sticky.querySelector('[data-sol-sticky-btn]');
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function () {
          if (action === 'add_to_cart') {
            addToCart(stickyBtn.getAttribute('data-variant-id'), stickyBtn);
            return;
          }

          var target = null;
          if (action === 'scroll_to_atc') {
            /* Send them back to the real buy button, and focus it so the
               keyboard path lands in the same place as the tap. */
            target = root.querySelector('[data-sol-atc]');
          }
          if (!target) target = document.getElementById(sticky.getAttribute('data-offers'));
          if (!target) return;

          var smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
          if (action === 'scroll_to_atc' && target.focus) {
            window.setTimeout(function () { target.focus({ preventScroll: true }); }, smooth ? 450 : 0);
          }
        });
      }
    }
  })();
</script>

