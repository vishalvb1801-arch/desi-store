          "clip": "clip_15",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg15",
      "role": "body",
      "line": "And I couldn't tell her why I wasn't standing there",
