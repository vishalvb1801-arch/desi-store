      "shots": [
        {
          "clip": "clip_24",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg24",
      "role": "body",
      "line": "\"Eight months, Neelu… he won't touch me, won't even hold my hand",
