        },
        {
          "clip": "clip_22",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg23",
      "role": "body",
      "line": "Then one Sunday I came home early, heard her on the phone",
