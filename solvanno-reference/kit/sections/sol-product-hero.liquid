    {%- capture eis_low_stock -%}<div class="sol-lowstock" data-start="{{ section.settings.low_stock_start | default: 40 }}" data-floor="{{ section.settings.low_stock_floor | default: 3 }}">
  <div class="sol-lowstock__row"><span class="sol-lowstock__label">{{ section.settings.low_stock_label | default: "Low stock &mdash; selling fast" }}</span><span class="sol-lowstock__count">Only <b data-ls-count>{{ section.settings.low_stock_start | default: 40 }}</b> left</span></div>
  <div class="sol-lowstock__track"><i data-ls-bar></i></div>
</div>
<style>
  .sol-lowstock{font-family:"DM Sans",-apple-system,sans-serif;}
  .sol-lowstock__row{display:flex;justify-content:space-between;align-items:baseline;margin:0 0 6px;}
  .sol-lowstock__label{font-size:12px;font-weight:600;color:#c43d2e;}
  .sol-lowstock__count{font-size:12px;color:#545a48;}
  .sol-lowstock__count b{color:#c43d2e;font-weight:700;}
  .sol-lowstock__track{height:8px;background:#efe3e0;border-radius:999px;overflow:hidden;}
  .sol-lowstock__track i{display:block;height:100%;width:100%;border-radius:999px;background:linear-gradient(90deg,#e0a526,#c43d2e);transition:width .6s ease;}
</style>
<script>
  (function(){
    var boxes = document.querySelectorAll(".sol-lowstock");
    for (var b = 0; b < boxes.length; b++) {
      (function(box){
        if (box.dataset.lsInit) return;
        box.dataset.lsInit = "1";
        var start = parseInt(box.dataset.start, 10) || 40;
        var floor = parseInt(box.dataset.floor, 10) || 3;
        var countEl = box.querySelector("[data-ls-count]");
        var bar = box.querySelector("[data-ls-bar]");
        var n = start;
        function render(){ countEl.textContent = n; bar.style.width = Math.max(6, (n / start * 100)) + "%"; }
        render();
        var mid = Math.round(start * 0.8);
        var t1 = setInterval(function(){
          if (n > mid) { n = n - 1; render(); } else { clearInterval(t1); slow(); }
        }, 260);
        function slow(){
          var t2 = setInterval(function(){
            if (n > floor) { n = n - 1; render(); } else { clearInterval(t2); }
          }, 3800);
        }
      })(boxes[b]);
    }
  })();
</script>{%- endcapture -%}
