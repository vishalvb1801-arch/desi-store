        "file": "vo.mp3",
        "in": 105.16,
        "out": 108.59
      },
      "shots": [
        {
          "clip": "clip_27",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg28",
      "role": "body",
      "line": "There's someone else, Neelu… what else could he be doing at two?\"",
