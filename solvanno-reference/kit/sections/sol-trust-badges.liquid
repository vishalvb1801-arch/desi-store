{%- comment -%}
  SOL — Trust badges
  ------------------------------------------------------------------
  Deep maroon band: heading, a row of certification badges, closing line.
{%- endcomment -%}

{% render 'sol-fonts' %}

{% style %}
  {% render 'sol-tokens', id: section.id, s: section.settings %}

  @property --sol-trust-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes eisMobileTrustBorder {
    to { --sol-trust-angle: 360deg; }
  }

  .sol-trust {
    background: var(--sol-maroon-deep);
    font-family: var(--sol-sans);
  }
  .sol-trust__inner {
    max-width: var(--sol-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }
  .sol-trust__title {
    font-family: var(--sol-serif);
    font-size: 27px;
    font-weight: 600;
    color: var(--sol-cream-light);
    margin: 0;
    line-height: 1.2;
  }
  .sol-trust__title em { color: var(--sol-gold-light); font-style: italic; }
  .sol-trust__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 10px;
    margin-top: 22px;
  }
  .sol-trust__badge {
    border: 1px solid rgba(227, 196, 111, .4);
    border-radius: 10px;
    padding: 16px 8px;
  }
  .sol-trust__icon {
    width: 44px;
    height: 44px;
    margin: 0 auto 10px;
    border-radius: 999px;
    border: 1.5px solid var(--sol-gold-light);
    color: var(--sol-gold-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.icon_size }}px;
    line-height: 1;
    overflow: hidden;
  }
  .sol-trust__icon img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sol-trust__label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--sol-cream-light);
    line-height: 1.4;
  }
  .sol-trust__note {
    font-family: var(--sol-serif);
    font-style: italic;
    font-size: 14px;
    color: #E9D8B6;
    margin-top: 20px;
  }

  /* ---------- phone-only Magnetic Sensor Light treatment ---------- */
  @media (max-width: 749px) {
    .sol-trust { background: #F5F7FB; }
    .sol-trust__inner {
      padding: 12px 10px 18px;
    }
    .sol-trust__title,
    .sol-trust__note { display: none; }
    .sol-trust__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 12px;
      margin-top: 0;
    }
    .sol-trust__badge {
      min-width: 0;
      border: 2px solid transparent;
      border-radius: 20px;
      padding: 18px 6px 17px;
      background:
        linear-gradient(#FBF8F3, #FBF8F3) padding-box,
        conic-gradient(
          from var(--sol-trust-angle),
          #dde7c2 0deg,
          #dde7c2 275deg,
          #b7ce2e 310deg,
          #2c4a2a 332deg,
          #dde7c2 360deg
        ) border-box;
      animation: eisMobileTrustBorder 3.6s linear infinite;
    }
    .sol-trust__icon {
      width: 34px;
      height: 34px;
      margin-bottom: 7px;
      border: 0;
      color: #2f6b2e;
      font-size: 27px;
      overflow: visible;
    }
    .sol-trust__badge:nth-child(2) .sol-trust__icon {
      color: #b7ce2e;
    }
    .sol-trust__label {
      color: #17271b;
      font-size: 12px;
      line-height: 1.35;
      letter-spacing: .09em;
      overflow-wrap: anywhere;
    }
    @media (prefers-reduced-motion: reduce) {
      .sol-trust__badge { animation: none; }
    }
  }

  /* ---------- desktop & iPad ---------- */
  /* The design drops the maroon band here and shows the three marks as cream
     chips sitting under the gallery column. They cannot move inside the hero
     without duplicating their content or disturbing mobile, so they keep
     their own band and instead take the design's chip treatment, aligned to
     the same left edge and the same 552px column width as the gallery. */
  @media (min-width: 750px) {
    /* The hero now carries these marks in its gallery column, directly
       under the FAQ. This standalone band stays for phones only. */
    .sol-trust { display: none; }
    .sol-trust { background: #fff; }
    .sol-trust__inner {
      max-width: 976px;
      padding: 0 12px 30px;
      text-align: left;
    }
    .sol-trust__title { display: none; }
    .sol-trust__grid {
      max-width: 47%;
      margin-top: 0;
      gap: 12px;
    }
    .sol-trust__badge {
      background: var(--sol-cream);
      border: 1px solid var(--sol-line);
      border-radius: 11px;
      padding: 14px 8px;
    }
    .sol-trust__icon {
      width: 30px;
      height: 30px;
      border: 0;
      color: var(--sol-maroon);
      margin-bottom: 6px;
    }
    .sol-trust__label { color: var(--sol-ink); }
  }

  @media (min-width: 1200px) {
    .sol-trust__inner { max-width: 1280px; }
    .sol-trust__grid { max-width: 552px; }
  }
{% endstyle %}

<div class="sol-trust">
  <div class="sol-trust__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sol-trust__title">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sol-trust__grid">
        {%- for block in section.blocks -%}
          <div class="sol-trust__badge" {{ block.shopify_attributes }}>
            <div class="sol-trust__icon" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 120 | image_tag: widths: '88, 120', sizes: '44px', loading: 'lazy', alt: '' }}
              {%- else -%}
                {{ block.settings.icon }}
              {%- endif -%}
            </div>
            <div class="sol-trust__label">{{ block.settings.label | newline_to_br }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="sol-trust__note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SOL — Trust badges",
  "tag": "section",
  "class": "sol-section sol-section--trust",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept. Use <em>…</em> to highlight words in gold.",
      "default": "Why Over <em>36,243 Families</em>\nTrust SOL"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Closing line",
      "default": "Every batch made to a standard you can verify."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Badges per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 14,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 28,
      "info": "Size of the character inside the ring. The ring itself stays 44px."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_maroon_deep",
      "label": "Background",
      "default": "#1e3a16"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Text",
      "default": "#edf3d6"
    },
    {
      "type": "color",
      "id": "color_gold_light",
      "label": "Gold accent",
      "default": "#c3d34a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon character",
          "default": "⚗",
          "info": "Used when no image is set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image (optional)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Line breaks are kept.",
          "default": "LAB\nTESTED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOL — Trust badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "⚗",
            "label": "LAB\nTESTED"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "☘",
            "label": "15+ AYURVEDIC\nHERBS"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "✷",
            "label": "GMP CERTIFIED\nFACILITY"
          }
        }
      ]
    }
  ]
}
{% endschema %}
