        "file": "vo.mp3",
        "in": 27.14,
        "out": 29.98
      },
      "shots": [
        {
          "clip": "clip_8",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg08",
      "role": "body",
      "line": "And I lay beside the woman I have loved for twenty-four years",
