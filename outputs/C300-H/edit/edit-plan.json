        "file": "vo.mp3",
        "in": 163.7,
        "out": 168.64
      },
      "shots": [
        {
          "clip": "clip_46",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg45",
      "role": "body",
      "line": "Inflammation, locked in deep, where sprays just sit up on the skin",
