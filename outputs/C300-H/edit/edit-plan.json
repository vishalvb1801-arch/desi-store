        "file": "vo.mp3",
        "in": 168.64,
        "out": 171.96
      },
      "shots": [
        {
          "clip": "clip_47",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg46",
      "role": "body",
      "line": "Warm massage works the stiffness loose, so fifteen herbs can settle in",
