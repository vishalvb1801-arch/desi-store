{%- comment -%}
  EIS — Product Hero
  ------------------------------------------------------------------
  Gallery + rating + title + benefit list + offer slot + trust strip,
  plus the mobile sticky Add-to-Cart bar.

  The offer ladder (1 / 3 / 5 bottles) is NOT hard-coded here. The section
  exposes an app-block slot inside "Choose Your Supply" — add the MoonBundle
  block there in the theme customizer and it owns offer selection + Add to Cart.
  The native Add-to-Cart button below it is off by default and exists only as a
  fallback for merchants who aren't running the app.
{%- endcomment -%}

{%- liquid
  assign eis_product = section.settings.product | default: product
  assign eis_variant = eis_product.selected_or_first_available_variant

  assign gallery_images = eis_product.images
  if section.settings.featured_image != blank
    assign hero_image = section.settings.featured_image
  else
    assign hero_image = eis_product.featured_image
  endif
  comment
    The product carries no media yet, so the sticky bar's thumbnail would be
    an empty black square. Fall back to the first gallery block.
  endcomment
  if hero_image == blank
    for block in section.blocks
      if block.type == 'gallery_image' and block.settings.image != blank
        assign hero_image = block.settings.image
        break
      endif
    endfor
  endif

  assign app_block_count = 0
  assign pill_count = 0
  assign benefit_count = 0
  assign badge_count = 0
  assign gallery_block_count = 0
  assign bfaq_count = 0
  for block in section.blocks
    case block.type
      when '@app'
        assign app_block_count = app_block_count | plus: 1
      when 'feature_pill'
        assign pill_count = pill_count | plus: 1
      when 'benefit'
        assign benefit_count = benefit_count | plus: 1
      when 'payment_badge'
        assign badge_count = badge_count | plus: 1
      when 'gallery_image'
        if block.settings.image != blank
          assign gallery_block_count = gallery_block_count | plus: 1
        endif
      when 'buybox_faq'
        assign bfaq_count = bfaq_count | plus: 1
    endcase
  endfor

  comment
    The gallery reads the product's own media first — that is what Shopify
    uses everywhere else, so it has to win. Gallery-image blocks are the
    fallback for a product whose media is not up yet; they disappear on
    their own the moment real media exists.
  endcomment
  assign use_gallery_blocks = false
  assign gallery_count = gallery_images.size
  if gallery_count == 0 and gallery_block_count > 0
    assign use_gallery_blocks = true
    assign gallery_count = gallery_block_count
  endif
  if gallery_count > section.settings.gallery_limit
    assign gallery_count = section.settings.gallery_limit
  endif

  assign has_compare_at = false
  if eis_variant.compare_at_price > eis_variant.price
    assign has_compare_at = true
  endif

  comment
    Filters can't be chained inside an image_tag argument, so alt text and the
    sizes hint are worked out up front.
  endcomment
  assign image_alt = eis_product.title
  assign hero_alt = image_alt | escape
  assign img_sizes ='(min-width: ' | append: section.settings.content_width | append: 'px) ' | append: section.settings.content_width | append: 'px, 100vw'
-%}

{% render 'eis-fonts' %}

{% style %}
  #shopify-section-{{ section.id }} {
    --eis-maroon: {{ section.settings.color_maroon }};
    --eis-maroon-deep: {{ section.settings.color_maroon_deep }};
    --eis-gold: {{ section.settings.color_gold }};
    --eis-cream: {{ section.settings.color_cream }};
    --eis-ink: {{ section.settings.color_text }};
    --eis-muted: {{ section.settings.color_muted }};
    --eis-green: {{ section.settings.color_green }};
    --eis-line: {{ section.settings.color_border }};
    --eis-max: {{ section.settings.content_width }}px;
    --eis-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --eis-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, system-ui, sans-serif;
  }

  .eis-hero {
    max-width: var(--eis-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px;
    background: #fff;
    font-family: var(--eis-sans);
    color: var(--eis-ink);
    -webkit-font-smoothing: antialiased;
  }
  .eis-hero *, .eis-sticky * { box-sizing: border-box; }

  /* ---------- gallery ---------- */
  .eis-hero__stage {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: radial-gradient(120% 90% at 50% 20%, #3A0F10 0%, #150606 70%);
    border: 1px solid #E7D9C3;
  }
  .eis-hero__slides { display: block; }
  .eis-hero__slide { display: none; }
  .eis-hero__slide[data-active] { display: block; }
  .eis-hero__slide img,
  .eis-hero__slide svg {
    display: block;
    width: 100%;
    height: {{ section.settings.image_height }}px;
    object-fit: contain;
    object-position: {{ section.settings.image_position }};
  }
  .eis-hero__pills {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
    pointer-events: none;
  }
  .eis-hero__pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,.94);
    border-radius: 999px;
    padding: 6px 11px 6px 7px;
    max-width: 172px;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  .eis-hero__pill-icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--eis-maroon);
    color: #F6E7C8;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .eis-hero__pill-text { font-size: 9.5px; line-height: 1.25; font-weight: 500; color: var(--eis-ink); }
  .eis-hero__nav {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: flex;
    gap: 8px;
    z-index: 2;
  }
  .eis-hero__nav button {
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 999px;
    background: rgba(255,255,255,.9);
    color: var(--eis-ink);
    font-size: 13px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .eis-hero__thumbs {
    display: flex;
    gap: 7px;
    margin-top: 9px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    /* no bar: the arrows on the main image drive this row, and a half-thumb
       at the edge is what tells people it keeps going */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .eis-hero__thumbs::-webkit-scrollbar { display: none; }
  .eis-hero__thumb {
    flex: 0 0 calc((100% - ({{ section.settings.thumb_columns }} - 1) * 7px) / {{ section.settings.thumb_columns }});
    scroll-snap-align: start;
    aspect-ratio: 1;
    border-radius: 8px;
    border: 1px solid var(--eis-line);
    overflow: hidden;
    background: #150606;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .eis-hero__thumb[aria-current="true"] { border: 2px solid var(--eis-maroon); }
  .eis-hero__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }

  /* ---------- rating ---------- */
  .eis-hero__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: {{ section.settings.rating_gap }}px;
    flex-wrap: wrap;
    font-family: 'Manrope', var(--eis-sans);
  }
  .eis-stars { display: flex; gap: 2px; }
  .eis-stars i {
    font-style: normal;
    font-size: {{ section.settings.rating_star_size }}px;
    line-height: 1;
    color: {{ section.settings.color_star }};
    display: inline-block;
    text-shadow: 0 0 8px {{ section.settings.color_star | color_modify: 'alpha', 0.7 }};
    animation: eisStarPulse 2s ease-in-out infinite;
  }
  .eis-stars i:nth-child(1) { animation-delay: 0s; }
  .eis-stars i:nth-child(2) { animation-delay: .15s; }
  .eis-stars i:nth-child(3) { animation-delay: .3s; }
  .eis-stars i:nth-child(4) { animation-delay: .45s; }
  .eis-stars i:nth-child(5) { animation-delay: .6s; }
  @keyframes eisStarPulse {
    0%, 100% { transform: scale(1); filter: brightness(1); }
    50% { transform: scale(1.2); filter: brightness(1.4); }
  }
  /* A pulsing row is decoration, not information — hold it still for anyone
     who has asked the OS for less motion. */
  @media (prefers-reduced-motion: reduce) {
    .eis-stars i { animation: none; }
  }
  .eis-hero__rating-text {
    font-size: {{ section.settings.rating_text_size }}px;
    font-weight: 400;
    color: {{ section.settings.color_rating_text }};
    white-space: nowrap;
  }
  .eis-hero__rating-text strong { font-weight: 600; }
  .eis-hero__rating-count { font-size: 12px; color: #8A7A63; width: 100%; }

  /* Stars + text sit on one line down to 375px. Below that the row would wrap
     and the copy would drop under the stars, so step both down instead. */
  @media (max-width: 389px) {
    .eis-hero__rating { gap: 6px; }
    .eis-stars i { font-size: {{ section.settings.rating_star_size | times: 0.9 | round: 1 }}px; }
    .eis-hero__rating-text { font-size: {{ section.settings.rating_text_size | times: 0.94 | round: 1 }}px; }
  }
  @media (max-width: 339px) {
    .eis-hero__rating { gap: 5px; }
    .eis-stars i { font-size: {{ section.settings.rating_star_size | times: 0.78 | round: 1 }}px; }
    .eis-hero__rating-text { font-size: {{ section.settings.rating_text_size | times: 0.84 | round: 1 }}px; }
  }

  /* The review card lower down reuses .eis-stars; keep those small, still and
     green rather than inheriting the hero row's gold pulse. */
  .eis-hero__review .eis-stars i {
    width: 15px;
    height: 15px;
    font-size: 10px;
    color: #fff;
    background: var(--eis-green);
    text-shadow: none;
    animation: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- copy ---------- */
  .eis-hero__title {
    font-family: var(--eis-serif);
    font-size: 31px;
    line-height: 1.12;
    font-weight: 600;
    color: var(--eis-maroon);
    margin: {{ section.settings.title_gap }}px 0 0;
  }
  .eis-hero__subtitle { font-size: 14px; line-height: 1.5; color: var(--eis-muted); margin: 10px 0 0; }

  /* ---------- doctors' choice badge ---------- */
  .eis-docs { display: flex; justify-content: center; width: 100%; padding: 6px 0; margin-top: {{ section.settings.doctors_gap }}px; }
  .eis-docs__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: {{ section.settings.doctors_bg }};
    border: 1.5px solid {{ section.settings.doctors_border }};
    border-radius: 50px;
    padding: 5px 14px 5px 6px;
    font-family: 'Manrope', var(--eis-sans);
    max-width: 100%;
  }
  .eis-docs__avatars { display: flex; align-items: center; flex-shrink: 0; }
  .eis-docs__avatars img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 2px solid #fff;
    margin-left: -8px;
    display: block;
  }
  .eis-docs__avatars img:first-child { margin-left: 0; }
  .eis-docs__text { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; white-space: nowrap; }
  .eis-docs__stars { display: inline-flex; align-items: center; gap: 1px; margin-left: 38px; }
  .eis-docs__stars span { color: #F5A623; font-size: 11px; line-height: 1; }
  .eis-docs__row { display: flex; align-items: center; gap: 6px; }
  .eis-docs__count { font-size: 13px; font-weight: 700; color: {{ section.settings.doctors_ink }}; }
  .eis-docs__label { font-size: 13px; font-weight: 500; color: {{ section.settings.doctors_label_ink }}; }
  .eis-docs__verified {
    font-size: 10px;
    background: {{ section.settings.doctors_ink }};
    color: #fff;
    border-radius: 50px;
    padding: 2px 7px;
    font-weight: 600;
    letter-spacing: .3px;
  }
  /* The pill is one unbreakable line; below ~360px it would push past the
     gutter, so shrink it rather than let it overflow. */
  @media (max-width: 359px) {
    .eis-docs__pill { gap: 8px; padding: 4px 11px 4px 5px; }
    .eis-docs__avatars img { width: 30px; height: 30px; }
    .eis-docs__stars { margin-left: 32px; }
    .eis-docs__count, .eis-docs__label { font-size: 12px; }
  }

  .eis-hero__benefits {
    background: var(--eis-cream);
    border: 1px solid #EFE0C9;
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .eis-hero__benefit { display: flex; gap: 11px; align-items: flex-start; }
  .eis-hero__check {
    width: 19px;
    height: 19px;
    border-radius: 999px;
    background: var(--eis-green);
    color: #fff;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    margin-top: 1px;
  }
  .eis-hero__benefit-text { font-size: 13px; line-height: 1.45; }
  .eis-hero__benefit-text span { color: var(--eis-muted); }

  /* ---------- price + offers ---------- */
  .eis-hero__price { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
  .eis-hero__price-now { font-size: 26px; font-weight: 700; color: var(--eis-maroon); font-family: var(--eis-serif); }
  .eis-hero__price-was { font-size: 14px; color: #A79684; text-decoration: line-through; }
  .eis-hero__price-save {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    color: #3B0E0F;
    background: var(--eis-gold);
    border-radius: 4px;
    padding: 3px 8px;
  }
  .eis-hero__price-unit { font-size: 11.5px; color: #8A7A63; width: 100%; }

  .eis-hero__offers-title {
    font-family: var(--eis-serif);
    font-size: 21px;
    font-weight: 600;
    color: var(--eis-ink);
    margin: 24px 0 12px;
  }
  .eis-hero__app-block + .eis-hero__app-block { margin-top: 12px; }
  .eis-hero__slot-empty {
    border: 1px dashed var(--eis-gold);
    border-radius: 11px;
    background: #FDF9F1;
    padding: 18px 16px;
    text-align: center;
  }
  .eis-hero__slot-empty b { display: block; font-size: 13px; margin-bottom: 6px; color: var(--eis-maroon); }
  .eis-hero__slot-empty span { font-size: 11.5px; line-height: 1.5; color: var(--eis-muted); }

  /* ---------- stock + cart ---------- */
  .eis-hero__stock {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--eis-ink);
  }
  .eis-dot { color: var(--eis-green); font-size: 14px; line-height: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .eis-dot--pulse { animation: eisPulse 2s infinite; }
  }
  @keyframes eisPulse { 0%, 100% { opacity: 1 } 50% { opacity: .35 } }
  .eis-hero__stock--out .eis-dot { color: #B0413A; }

  .eis-btn {
    display: block;
    width: 100%;
    border: 0;
    background: var(--eis-maroon);
    color: #FFF7E6;
    font-family: var(--eis-sans);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: .14em;
    text-align: center;
    padding: 19px;
    border-radius: 10px;
    margin-top: 14px;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(123,19,21,.28);
    -webkit-tap-highlight-color: transparent;
  }
  .eis-btn:hover { background: var(--eis-maroon-deep); }
  .eis-btn[disabled] { background: #B9A9A0; box-shadow: none; cursor: not-allowed; }

  /* ---------- social proof row ---------- */
  /* .eis-sp is already taken by the eis-social-proof section, whose styles
     are page-wide — hence the eis-hsp prefix and the explicit background. */
  .eis-hsp {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: {{ section.settings.sp_gap }}px;
    padding: 0 0 15px;
    background: transparent;
    font-family: 'Manrope', var(--eis-sans);
  }
  .eis-hsp__row { display: inline-flex; align-items: center; gap: 12px; flex-wrap: nowrap; max-width: 100%; }
  .eis-hsp__avatars { display: flex; align-items: center; flex-shrink: 0; }
  .eis-hsp__avatars img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2.5px solid {{ section.settings.sp_accent }};
    object-fit: cover;
    margin-left: -10px;
    display: block;
    transition: transform .3s ease;
  }
  .eis-hsp__avatars img:first-child { margin-left: 0; }
  .eis-hsp__avatars img:hover { transform: scale(1.1); z-index: 10; position: relative; }
  .eis-hsp__text { display: flex; align-items: center; gap: 6px; row-gap: 2px; font-size: 17px; font-weight: 600; color: #333; flex-wrap: wrap; white-space: nowrap; }
  .eis-hsp__count { font-weight: 800; color: {{ section.settings.sp_accent }}; font-size: 18px; font-variant-numeric: tabular-nums; }
  .eis-hsp__dot { color: #ccc; font-size: 16px; margin: 0 2px; }
  .eis-hsp__stars { display: inline-flex; align-items: center; gap: 1px; }
  .eis-hsp__stars span { color: {{ section.settings.sp_accent }}; font-size: 18px; line-height: 1; }
  .eis-hsp__rating { font-weight: 700; color: #333; font-size: 17px; margin-left: 3px; }
  .eis-hsp__score { display: inline-flex; align-items: center; gap: 3px; flex-basis: 100%; }
  /* The pasted design is one unbroken line, which needs ~505px of column.
     The buy box is capped at 480px, so that line can never fit at any
     viewport — the stars and rating always take their own row, and the
     separator dot that divided them goes away with it. */
  .eis-hsp__dot { display: none; }
  @media (max-width: 429px) {
    .eis-hsp__row { gap: 9px; }
    .eis-hsp__avatars img { width: 38px; height: 38px; border-width: 2px; margin-left: -9px; }
    .eis-hsp__text { font-size: 14px; gap: 4px; }
    .eis-hsp__count { font-size: 15px; }
    .eis-hsp__stars span { font-size: 14px; }
    .eis-hsp__rating { font-size: 14px; }
  }
  @media (max-width: 359px) {
    .eis-hsp__avatars img { width: 33px; height: 33px; margin-left: -8px; }
    .eis-hsp__text { font-size: 12.5px; }
    .eis-hsp__count { font-size: 13.5px; }
    .eis-hsp__stars span { font-size: 12.5px; }
    .eis-hsp__rating { font-size: 12.5px; }
  }

  /* ---------- payment methods ---------- */
  .eis-pm { margin-top: 6px; }
  .eis-pm__row { display: flex; align-items: center; justify-content: space-between; gap: 3px; }
  .eis-pm__tile {
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--eis-line);
    border-radius: 5px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    overflow: hidden;
  }
  .eis-pm__tile svg, .eis-pm__tile img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .eis-pm__note { font-size: 11px; color: var(--eis-muted); text-align: center; margin: 7px 0 0; }

  /* ---------- low stock + delivery ---------- */
  .eis-stockbar { margin-top: 16px; }
  .eis-stockbar__head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
  .eis-stockbar__label { font-size: 13px; font-weight: 700; color: #A11B1B; }
  .eis-stockbar__pct { font-size: 11.5px; color: var(--eis-muted); }
  .eis-stockbar__track { height: 9px; border-radius: 999px; background: #F0E4E4; overflow: hidden; }
  .eis-stockbar__fill {
    height: 100%;
    width: {{ section.settings.stock_percent }}%;
    border-radius: 999px;
    background: linear-gradient(90deg, #D63232, #A11B1B);
    animation: eisStockPulse 2.2s ease-in-out infinite;
  }
  @keyframes eisStockPulse { 0%, 100% { opacity: 1; } 50% { opacity: .62; } }
  @media (prefers-reduced-motion: reduce) { .eis-stockbar__fill { animation: none; } }
  .eis-deliv {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 11px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--eis-ink);
  }
  .eis-deliv__icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--eis-green);
    color: #fff;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .eis-deliv b { font-weight: 700; }
  .eis-deliv__note { display: block; font-size: 12px; color: var(--eis-muted); margin-top: 1px; }

  /* ---------- counterfeit warning ---------- */
  .eis-warn {
    background: #FDF2F2;
    border: 2px dashed #D37373;
    padding: 16px;
    border-radius: 4px;
    margin: 15px 0 0;
    font-family: var(--eis-sans);
  }
  .eis-warn__head {
    display: flex;
    align-items: center;
    margin-bottom: 8px;
    color: #A94442;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: .5px;
  }
  .eis-warn__icon {
    background: #A94442;
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    font-size: 12px;
    flex: none;
  }
  .eis-warn__body p { margin: 0 0 8px; font-size: 14px; line-height: 1.5; color: #834040; }
  .eis-warn__body p:last-child { margin-bottom: 0; }
  .eis-warn__body strong { color: #A94442; }
  .eis-warn__body a { color: #834040; text-decoration: underline; font-weight: 500; }

  /* ---------- buy-box FAQ ---------- */
  /* Full-bleed cream: pull back out through the hero's side padding so the
     background runs the width of the buy box, then put the padding back on
     so the cards still line up with everything above them. */
  .eis-bfaq {
    margin: 16px -{{ section.settings.padding_x }}px 0;
    padding: 16px {{ section.settings.padding_x }}px;
    background: var(--eis-cream);
    border: 0;
    border-radius: 0;
  }
  .eis-bfaq__title {
    font-family: var(--eis-serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--eis-maroon);
    margin: 2px 0 12px;
    text-align: center;
  }
  .eis-bfaq__item {
    background: #fff;
    border: 1px solid #EFE0C9;
    border-radius: 11px;
    margin-bottom: 10px;
    overflow: hidden;
  }
  .eis-bfaq__item:last-child { margin-bottom: 0; }
  .eis-bfaq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 15px;
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--eis-ink);
    -webkit-tap-highlight-color: transparent;
  }
  .eis-bfaq__item summary::-webkit-details-marker { display: none; }
  .eis-bfaq__sign {
    flex: none;
    width: 18px;
    text-align: center;
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
    color: var(--eis-maroon);
  }
  .eis-bfaq__sign::after { content: '+'; }
  .eis-bfaq__item[open] .eis-bfaq__sign::after { content: '\00D7'; }
  .eis-bfaq__answer { padding: 0 15px 14px; }
  .eis-bfaq__answer p { margin: 0 0 8px; font-size: 13.5px; line-height: 1.55; color: var(--eis-muted); }
  .eis-bfaq__answer p:last-child { margin-bottom: 0; }
  @media (max-width: 359px) {
    .eis-bfaq__item summary { padding: 12px 12px; font-size: 14px; }
    .eis-bfaq__answer { padding: 0 12px 12px; }
  }

  .eis-pay { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
  .eis-pay span {
    border: 1px solid var(--eis-line);
    border-radius: 4px;
    padding: 4px 7px;
    font-size: 8px;
    font-weight: 700;
    color: var(--eis-muted);
    letter-spacing: .04em;
  }
  .eis-pay span.is-highlight { border-color: var(--eis-green); color: var(--eis-green); }
  .eis-hero__cod {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--eis-green);
  }

  .eis-hero__guarantee {
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid #EFE0C9;
    border-radius: 10px;
    padding: 13px;
    margin-top: 14px;
    background: var(--eis-cream);
  }
  .eis-hero__guarantee-icon {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--eis-gold);
    color: #3B0E0F;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex: none;
  }
  .eis-hero__guarantee b { font-size: 12.5px; display: block; }
  .eis-hero__guarantee a { font-size: 11px; color: var(--eis-maroon); }

  /* ---------- hero review ---------- */
  .eis-hero__review { border: 1px solid #EFE3D2; border-radius: 11px; padding: 14px; margin-top: 14px; }
  .eis-hero__review .eis-stars { margin-bottom: 9px; }
  .eis-hero__review-quote { font-size: 13px; line-height: 1.5; color: #3B322C; }
  .eis-hero__review-by { display: flex; align-items: center; gap: 9px; margin-top: 11px; }
  .eis-hero__avatar {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    flex: none;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #EDE1CE 0 5px, #F9F1E4 5px 10px);
  }
  .eis-hero__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .eis-hero__review-name-row { display: flex; align-items: center; gap: 5px; }
  .eis-hero__review-name { font-size: 12px; font-weight: 700; }
  .eis-hero__google { width: 14px; height: 14px; flex: none; display: block; }
  .eis-hero__review-meta { font-size: 10.5px; color: var(--eis-green); }

  /* ---------- sticky bar ---------- */
  .eis-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .eis-sticky__inner {
    width: 100%;
    max-width: var(--eis-max);
    background: rgba(255,255,255,.98);
    border-top: 1px solid #EFE0C9;
    padding: 11px 14px;
    padding-bottom: calc(11px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 7px;
    box-shadow: 0 -8px 22px rgba(59,14,15,.1);
    pointer-events: auto;
    transform: translateY(120%);
    transition: transform .25s ease;
    font-family: var(--eis-sans);
  }
  @media (prefers-reduced-motion: reduce) { .eis-sticky__inner { transition: none; } }
  .eis-sticky.is-visible .eis-sticky__inner { transform: translateY(0); }
  .eis-sticky__row { display: flex; align-items: center; gap: 11px; }
  /* On the narrowest phones the thumbnail costs 57px the title needs more. */
  @media (max-width: 359px) { .eis-sticky__row .eis-sticky__thumb { display: none; } }
  .eis-sticky__thumb {
    width: 46px;
    height: 46px;
    border-radius: 9px;
    overflow: hidden;
    background: #150606;
    flex: none;
    align-self: center;
  }
  .eis-sticky__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .eis-sticky__copy { flex: 1; min-width: 0; padding-top: 1px; }
  .eis-sticky__name {
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--eis-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .eis-sticky__price { font-size: 11px; color: #8A7A63; }
  .eis-sticky__price s { color: #B7A692; }
  /* Its own full-width strip: on a 390px phone the copy column is ~155px and
     this line needs ~226px, so inline next to the title it would always clip. */
  .eis-sticky__rating {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }
  .eis-sticky__rating i {
    font-style: normal;
    font-size: 10px;
    line-height: 1;
    color: {{ section.settings.color_star }};
    letter-spacing: .5px;
  }
  .eis-sticky__rating span {
    font-size: 10.5px;
    color: #6A5B4D;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .eis-sticky__btn {
    position: relative;
    overflow: hidden;
    background: var(--eis-maroon);
    color: #FFF7E6;
    border: 0;
    font-family: var(--eis-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .09em;
    padding: 15px 18px;
    border-radius: 9px;
    cursor: pointer;
    flex: none;
    align-self: center;
    white-space: nowrap;
    animation: eisCtaPulse 2.6s ease-in-out infinite;
    transition: background .2s ease, transform .2s cubic-bezier(.34,1.56,.64,1);
    -webkit-tap-highlight-color: transparent;
  }
  .eis-sticky__btn:hover { background: var(--eis-maroon-deep); }
  .eis-sticky__btn:active { transform: scale(.96); }
  .eis-sticky__btn[disabled] { background: #B9A9A0; cursor: not-allowed; animation: none; }
  .eis-sticky__sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    background: linear-gradient(90deg, rgba(255,247,230,0), rgba(255,247,230,.28), rgba(255,247,230,0));
    animation: eisCtaSheen 3.4s ease-in-out infinite;
    pointer-events: none;
  }
  .eis-sticky__btn span:not(.eis-sticky__sheen) { position: relative; }
  @keyframes eisCtaPulse {
    0%, 100% { box-shadow: 0 5px 14px rgba(123,19,21,.30), 0 0 0 0 rgba(201,162,74,0); }
    50% { box-shadow: 0 7px 20px rgba(123,19,21,.38), 0 0 0 5px rgba(201,162,74,.22); }
  }
  @keyframes eisCtaSheen {
    0% { transform: translateX(-130%) skewX(-18deg); }
    55% { transform: translateX(240%) skewX(-18deg); }
    100% { transform: translateX(240%) skewX(-18deg); }
  }
  /* The pulse and sheen are decoration; hold them still on request. */
  @media (prefers-reduced-motion: reduce) {
    .eis-sticky__btn { animation: none; transition: none; }
    .eis-sticky__sheen { animation: none; opacity: 0; }
  }
  {%- if section.settings.sticky_on_desktop %}
  /* Desktop drops the thumbnail and lets the title carry the bar. */
  @media (min-width: 750px) {
    .eis-sticky__inner { max-width: 1240px; padding: 14px 28px; gap: 22px; }
    .eis-sticky__inner .eis-sticky__thumb { display: none; }
    .eis-sticky__name { font-family: var(--eis-serif); font-size: 19px; font-weight: 600; line-height: 1.2; color: var(--eis-maroon); }
    .eis-sticky__rating i { font-size: 12px; }
    .eis-sticky__rating span { font-size: 12px; }
    .eis-sticky__btn { font-size: 15px; letter-spacing: .13em; padding: 19px 42px; border-radius: 10px; }
    .eis-sticky__btn:hover { transform: translateY(-2px) scale(1.02); }
    .eis-sticky__btn:active { transform: translateY(0) scale(.98); }
  }
  {%- else %}
  @media (min-width: 750px) { .eis-sticky { display: none; } }
  {%- endif %}

  /* ---------- larger screens: same layout, a touch more air ---------- */
  @media (min-width: 560px) {
    .eis-hero__title { font-size: 34px; }
    .eis-hero__subtitle { font-size: 15px; }
    .eis-hero__benefit-text { font-size: 13.5px; }
  }
{% endstyle %}

<div class="eis-hero" id="EisHero-{{ section.id }}" data-eis-hero>
  {%- if eis_product == blank -%}
    <div class="eis-hero__slot-empty">
      <b>No product selected</b>
      <span>Open this section in the theme customizer and pick a product, or add the section to a product template.</span>
    </div>
  {%- else -%}

    {%- comment -%} ---------- gallery ---------- {%- endcomment -%}
    <div class="eis-hero__stage">
      {%- if pill_count > 0 -%}
        <div class="eis-hero__pills">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature_pill' -%}
              <div class="eis-hero__pill" {{ block.shopify_attributes }}>
                <div class="eis-hero__pill-icon" aria-hidden="true">{{ block.settings.icon }}</div>
                <div class="eis-hero__pill-text">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="eis-hero__slides" data-eis-slides>
        {%- if use_gallery_blocks -%}
          {%- assign slide_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.image != blank and slide_i < section.settings.gallery_limit -%}
              <div class="eis-hero__slide" data-eis-slide="{{ slide_i }}" {% if slide_i == 0 %}data-active{% endif %} {{ block.shopify_attributes }}>
                {{
                  block.settings.image
                  | image_url: width: 1080
                  | image_tag:
                    widths: '360, 480, 720, 900, 1080',
                    sizes: img_sizes,
                    loading: 'lazy',
                    alt: hero_alt
                }}
              </div>
              {%- assign slide_i = slide_i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif gallery_images.size > 0 -%}
          {%- for image in gallery_images limit: section.settings.gallery_limit -%}
            {%- liquid
              # only the first image is part of the initial paint
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
              endif
              assign slide_alt = image.alt | default: image_alt | escape
            -%}
            <div class="eis-hero__slide" data-eis-slide="{{ forloop.index0 }}" {% if forloop.first %}data-active{% endif %}>
              {{
                image
                | image_url: width: 1080
                | image_tag:
                  widths: '360, 480, 720, 900, 1080',
                  sizes: img_sizes,
                  loading: img_loading,
                  fetchpriority: img_priority,
                  alt: slide_alt
              }}
            </div>
          {%- endfor -%}
        {%- elsif hero_image != blank -%}
          <div class="eis-hero__slide" data-eis-slide="0" data-active>
            {{
              hero_image
              | image_url: width: 1080
              | image_tag:
                widths: '360, 480, 720, 900, 1080',
                sizes: img_sizes,
                loading: 'eager',
                fetchpriority: 'high',
                alt: hero_alt
            }}
          </div>
        {%- else -%}
          <div class="eis-hero__slide" data-eis-slide="0" data-active>
            {{ 'product-1' | placeholder_svg_tag: 'eis-placeholder' }}
          </div>
        {%- endif -%}
      </div>

      {%- if gallery_count > 1 -%}
        <div class="eis-hero__nav">
          <button type="button" data-eis-prev aria-label="Previous image">&lsaquo;</button>
          <button type="button" data-eis-next aria-label="Next image">&rsaquo;</button>
        </div>
      {%- endif -%}
    </div>

    {%- if gallery_count > 1 -%}
      <div class="eis-hero__thumbs" role="group" aria-label="Product images">
        {%- if use_gallery_blocks -%}
          {%- assign thumb_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.image != blank and thumb_i < section.settings.gallery_limit -%}
              <button
                type="button"
                class="eis-hero__thumb"
                data-eis-thumb="{{ thumb_i }}"
                aria-current="{% if thumb_i == 0 %}true{% else %}false{% endif %}"
                aria-label="Show image {{ thumb_i | plus: 1 }}"
              >
                {{ block.settings.image | image_url: width: 200 | image_tag: widths: '100, 160, 200', sizes: '20vw', loading: 'lazy', alt: '' }}
              </button>
              {%- assign thumb_i = thumb_i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for image in gallery_images limit: section.settings.gallery_limit -%}
            <button
              type="button"
              class="eis-hero__thumb"
              data-eis-thumb="{{ forloop.index0 }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Show image {{ forloop.index }}"
            >
              {{ image | image_url: width: 200 | image_tag: widths: '100, 160, 200', sizes: '20vw', loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- rating ---------- {%- endcomment -%}
    {%- if section.settings.show_rating -%}
      <div class="eis-hero__rating">
        <div class="eis-stars" aria-hidden="true">
          {%- for i in (1..section.settings.rating_stars) -%}<i>★</i>{%- endfor -%}
        </div>
        {%- if section.settings.rating_text != blank -%}
          <div class="eis-hero__rating-text">{{ section.settings.rating_text }}</div>
        {%- endif -%}
        {%- if section.settings.rating_count_text != blank -%}
          <div class="eis-hero__rating-count">{{ section.settings.rating_count_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- title ---------- {%- endcomment -%}
    {%- assign heading = section.settings.heading | default: eis_product.title -%}
    <h1 class="eis-hero__title">{{ heading | newline_to_br }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="eis-hero__subtitle">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- comment -%} ---------- doctors' choice badge ---------- {%- endcomment -%}
    {%- if section.settings.show_doctors -%}
      <div class="eis-docs">
        <div class="eis-docs__pill">
          <div class="eis-docs__avatars">
            {%- for i in (1..2) -%}
              {%- if i == 1 -%}
                {%- assign doc_img = section.settings.doctor_image_1 -%}
                {%- assign doc_url = section.settings.doctor_image_url_1 -%}
              {%- else -%}
                {%- assign doc_img = section.settings.doctor_image_2 -%}
                {%- assign doc_url = section.settings.doctor_image_url_2 -%}
              {%- endif -%}
              {%- if doc_img != blank -%}
                {{ doc_img | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48, sizes: '34px' }}
              {%- elsif doc_url != blank -%}
                <img src="{{ doc_url }}" alt="" width="48" height="48" loading="lazy">
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="eis-docs__text">
            <span class="eis-docs__stars" aria-hidden="true">
              {%- for i in (1..5) -%}<span>&#9733;</span>{%- endfor -%}
            </span>
            <div class="eis-docs__row">
              {%- if section.settings.doctors_count != blank -%}
                <span class="eis-docs__count">{{ section.settings.doctors_count }}</span>
              {%- endif -%}
              {%- if section.settings.doctors_label != blank -%}
                <span class="eis-docs__label">{{ section.settings.doctors_label }}</span>
              {%- endif -%}
              {%- if section.settings.doctors_badge != blank -%}
                <span class="eis-docs__verified">{{ section.settings.doctors_badge }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ---------- benefit bullets ---------- {%- endcomment -%}
    {%- if benefit_count > 0 -%}
      <div class="eis-hero__benefits">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="eis-hero__benefit" {{ block.shopify_attributes }}>
              <div class="eis-hero__check" aria-hidden="true">✓</div>
              <div class="eis-hero__benefit-text">
                <strong>{{ block.settings.title }}</strong> <span>{{ block.settings.text }}</span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- price ---------- {%- endcomment -%}
    {%- if section.settings.show_price -%}
      <div class="eis-hero__price">
        <span class="eis-hero__price-now">{{ eis_variant.price | money }}</span>
        {%- if has_compare_at -%}
          <s class="eis-hero__price-was">{{ eis_variant.compare_at_price | money }}</s>
          {%- assign saved = eis_variant.compare_at_price | minus: eis_variant.price | times: 100.0 | divided_by: eis_variant.compare_at_price | round -%}
          <span class="eis-hero__price-save">SAVE {{ saved }}%</span>
        {%- endif -%}
        {%- if section.settings.price_note != blank -%}
          <span class="eis-hero__price-unit">{{ section.settings.price_note }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      ---------- offer slot (MoonBundle app block goes here) ----------
      Any app block added to this section renders inside this container.
    {%- endcomment -%}
    <div class="eis-hero__offers" id="EisOffers-{{ section.id }}">
      {%- if section.settings.offers_heading != blank -%}
        <h2 class="eis-hero__offers-title">{{ section.settings.offers_heading }}</h2>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="eis-hero__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      {%- if app_block_count == 0 and request.design_mode -%}
        <div class="eis-hero__slot-empty">
          <b>Offer ladder slot — empty</b>
          <span>
            Click <em>Add block</em> on this section and choose your MoonBundle bundle/quantity-break
            block. It renders here and handles offer selection and Add to Cart.
            This message is only visible to you in the customizer.
          </span>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- stock line ---------- {%- endcomment -%}
    {%- if section.settings.show_stock -%}
      {%- if eis_product.available -%}
        <div class="eis-hero__stock">
          <span class="eis-dot eis-dot--pulse" aria-hidden="true">●</span>
          {{ section.settings.stock_text }}
        </div>
      {%- else -%}
        <div class="eis-hero__stock eis-hero__stock--out">
          <span class="eis-dot" aria-hidden="true">●</span>
          {{ section.settings.out_of_stock_text }}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      ---------- fallback Add to Cart ----------
      Off by default: MoonBundle owns the buy button. Turn on only if the app
      block isn't in use.
    {%- endcomment -%}
    {%- if section.settings.show_fallback_atc -%}
      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        data-eis-form
        {% if eis_variant == blank or eis_product.available == false %}data-unavailable{% endif %}
      >
        <input type="hidden" name="id" value="{{ eis_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        {%- comment -%}
          Without JS the form posts normally, so return_to has to carry the
          same destination the fetch path uses.
        {%- endcomment -%}
        {%- if section.settings.atc_destination == 'checkout' -%}
          <input type="hidden" name="return_to" value="/checkout">
        {%- endif -%}
        <button
          type="submit"
          class="eis-btn"
          data-eis-atc
          {% unless eis_product.available %}disabled{% endunless %}
        >
          {%- if eis_product.available -%}{{ section.settings.atc_label }}{%- else -%}{{ section.settings.sold_out_label }}{%- endif -%}
        </button>
      </form>
    {%- endif -%}

    {%- comment -%} ---------- social proof row ---------- {%- endcomment -%}
    {%- if section.settings.show_social_proof -%}
      <div class="eis-hsp">
        <div class="eis-hsp__row">
          <div class="eis-hsp__avatars">
            {%- for i in (1..3) -%}
              {%- liquid
                case i
                  when 1
                    assign sp_img = section.settings.sp_avatar_1
                    assign sp_url = section.settings.sp_avatar_url_1
                  when 2
                    assign sp_img = section.settings.sp_avatar_2
                    assign sp_url = section.settings.sp_avatar_url_2
                  else
                    assign sp_img = section.settings.sp_avatar_3
                    assign sp_url = section.settings.sp_avatar_url_3
                endcase
              -%}
              {%- if sp_img != blank -%}
                {{ sp_img | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 60, height: 60, sizes: '44px' }}
              {%- elsif sp_url != blank -%}
                <img src="{{ sp_url }}" alt="" width="60" height="60" loading="lazy">
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="eis-hsp__text">
            <span
              class="eis-hsp__count"
              data-eis-count
              data-from="{{ section.settings.sp_count_from }}"
              data-to="{{ section.settings.sp_count_to }}"
            >{{ section.settings.sp_count_to }}</span>
            <span>{{ section.settings.sp_label }}</span>
            <span class="eis-hsp__dot" aria-hidden="true">&bull;</span>
            <span class="eis-hsp__score">
              <span class="eis-hsp__stars" aria-hidden="true">
                {%- for i in (1..5) -%}<span>&#9733;</span>{%- endfor -%}
              </span>
              <span class="eis-hsp__rating">{{ section.settings.sp_rating }}</span>
            </span>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ---------- payment methods ---------- {%- endcomment -%}
    {%- if section.settings.show_pay_marks -%}
      {%- assign pay_marks = section.settings.pay_marks | split: ',' -%}
      <div class="eis-pm">
        <div class="eis-pm__row">
          {%- for raw_mark in pay_marks -%}
            {%- assign pay_mark = raw_mark | strip -%}
            {%- if pay_mark != blank -%}
              <span class="eis-pm__tile">{% render 'eis-pay-mark', mark: pay_mark %}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.pay_note != blank -%}
          <p class="eis-pm__note">{{ section.settings.pay_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- low stock bar + delivery estimate ---------- {%- endcomment -%}
    {%- if section.settings.show_stockbar -%}
      <div class="eis-stockbar">
        <div class="eis-stockbar__head">
          <span class="eis-stockbar__label">{{ section.settings.stock_label }}</span>
          {%- if section.settings.stock_note != blank -%}
            <span class="eis-stockbar__pct">{{ section.settings.stock_note }}</span>
          {%- endif -%}
        </div>
        <div
          class="eis-stockbar__track"
          role="progressbar"
          aria-valuenow="{{ section.settings.stock_percent }}"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label="{{ section.settings.stock_label | escape }}"
        >
          <div class="eis-stockbar__fill"></div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_delivery -%}
      {%- comment -%}
        Liquid renders the server-side estimate so the line is never blank;
        the script below recomputes it on the viewer's own clock, because a
        cached page would otherwise show a stale date.
      {%- endcomment -%}
      {%- assign now_seconds = 'now' | date: '%s' | plus: 0 -%}
      {%- assign min_days = section.settings.delivery_min_days -%}
      {%- assign max_days = section.settings.delivery_max_days -%}
      {%- assign from_seconds = min_days | times: 86400 | plus: now_seconds -%}
      {%- assign to_seconds = max_days | times: 86400 | plus: now_seconds -%}
      <div
        class="eis-deliv"
        data-eis-delivery
        data-min-days="{{ min_days }}"
        data-max-days="{{ max_days }}"
      >
        <span class="eis-deliv__icon" aria-hidden="true">&#10003;</span>
        <span>
          {{ section.settings.delivery_label }}
          <b data-eis-delivery-range>{{ from_seconds | date: '%a, %-d %b' }} &ndash; {{ to_seconds | date: '%a, %-d %b' }}</b>
          {%- if section.settings.delivery_note != blank -%}
            <span class="eis-deliv__note">{{ section.settings.delivery_note }}</span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- comment -%} ---------- counterfeit warning ---------- {%- endcomment -%}
    {%- if section.settings.show_warning -%}
      <div class="eis-warn">
        <div class="eis-warn__head">
          <span class="eis-warn__icon" aria-hidden="true">!</span>
          <span>{{ section.settings.warning_title }}</span>
        </div>
        <div class="eis-warn__body">{{ section.settings.warning_body }}</div>
      </div>
    {%- endif -%}

    {%- comment -%}
      ---------- buy-box FAQ ----------
      Plain <details>, so every answer is closed on load and stays reachable
      with JavaScript off.
    {%- endcomment -%}
    {%- if bfaq_count > 0 -%}
      <div class="eis-bfaq">
        {%- if section.settings.bfaq_title != blank -%}
          <h2 class="eis-bfaq__title">{{ section.settings.bfaq_title }}</h2>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'buybox_faq' -%}
            <details class="eis-bfaq__item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <span class="eis-bfaq__sign" aria-hidden="true"></span>
              </summary>
              <div class="eis-bfaq__answer">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- payment badges + COD ---------- {%- endcomment -%}
    {%- if badge_count > 0 -%}
      <div class="eis-pay">
        {%- for block in section.blocks -%}
          {%- if block.type == 'payment_badge' -%}
            <span class="{% if block.settings.highlight %}is-highlight{% endif %}" {{ block.shopify_attributes }}>
              {{- block.settings.label -}}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cod_text != blank -%}
      <div class="eis-hero__cod">
        <span aria-hidden="true">✓</span>{{ section.settings.cod_text }}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- guarantee strip ---------- {%- endcomment -%}
    {%- if section.settings.show_guarantee -%}
      <div class="eis-hero__guarantee">
        <div class="eis-hero__guarantee-icon" aria-hidden="true">{{ section.settings.guarantee_icon }}</div>
        <div>
          <b>{{ section.settings.guarantee_title }}</b>
          {%- if section.settings.guarantee_link_text != blank -%}
            <a href="{{ section.settings.guarantee_link | default: '#guarantee' }}">
              {{- section.settings.guarantee_link_text -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ---------- hero review card ---------- {%- endcomment -%}
    {%- if section.settings.show_review -%}
      <div class="eis-hero__review">
        <div class="eis-stars" aria-hidden="true">
          {%- for i in (1..section.settings.review_stars) -%}<i>★</i>{%- endfor -%}
        </div>
        <div class="eis-hero__review-quote">{{ section.settings.review_quote }}</div>
        <div class="eis-hero__review-by">
          <div class="eis-hero__avatar">
            {%- if section.settings.review_avatar != blank -%}
              {{ section.settings.review_avatar | image_url: width: 80 | image_tag: widths: '56, 80', sizes: '28px', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </div>
          <div>
            <div class="eis-hero__review-name-row">
              <div class="eis-hero__review-name">{{ section.settings.review_name }}</div>
              {%- if section.settings.review_google -%}
                <svg class="eis-hero__google" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Google review">
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                  <path fill="#FBBC05" d="M10.53 28.59a14.5 14.5 0 0 1 0-9.18l-7.98-6.19a24.0 24.0 0 0 0 0 21.56l7.98-6.19z"/>
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
              {%- endif -%}
            </div>
            <div class="eis-hero__review-meta">{{ section.settings.review_meta }}</div>
          </div>
        </div>
      </div>
    {%- endif -%}

  {%- endif -%}
</div>

{%- comment -%} ---------- sticky bar ---------- {%- endcomment -%}
{%- if section.settings.show_sticky and eis_product != blank -%}
  <div
    class="eis-sticky"
    data-eis-sticky
    data-reveal-at="{{ section.settings.sticky_reveal_at }}"
    data-reveal-mode="{{ section.settings.sticky_reveal_mode }}"
    data-action="{{ section.settings.sticky_action }}"
    data-offers="EisOffers-{{ section.id }}"
    data-hero="EisHero-{{ section.id }}"
  >
    <div class="eis-sticky__inner">
      {%- comment -%}
        Same copy as the buy box's rating row, read from the same settings so
        the two can't drift apart.
      {%- endcomment -%}
      {%- if section.settings.sticky_show_rating and section.settings.rating_text != blank -%}
        <div class="eis-sticky__rating">
          <i aria-hidden="true">{% for i in (1..section.settings.rating_stars) %}&#9733;{% endfor %}</i>
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}
      <div class="eis-sticky__row">
      <div class="eis-sticky__thumb">
        {%- if hero_image != blank -%}
          {{ hero_image | image_url: width: 120 | image_tag: widths: '80, 120', sizes: '40px', loading: 'lazy', alt: '' }}
        {%- endif -%}
      </div>
      <div class="eis-sticky__copy">
        <div class="eis-sticky__name">{{ section.settings.sticky_title | default: eis_product.title }}</div>
        {%- if section.settings.sticky_show_price -%}
          <div class="eis-sticky__price">
            {{ eis_variant.price | money }}
            {%- if has_compare_at %} <s>{{ eis_variant.compare_at_price | money }}</s>{% endif -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="eis-sticky__btn"
        data-eis-sticky-btn
        data-variant-id="{{ eis_variant.id }}"
        {% unless eis_product.available %}disabled{% endunless %}
      >
        <span class="eis-sticky__sheen" aria-hidden="true"></span>
        <span>{%- if eis_product.available -%}{{ section.settings.sticky_label }}{%- else -%}{{ section.settings.sold_out_label }}{%- endif -%}</span>
      </button>
      </div>
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('EisHero-{{ section.id }}');
    var sticky = document.querySelector('[data-eis-sticky][data-offers="EisOffers-{{ section.id }}"]');
    if (!root) return;

    /* ---- gallery ---- */
    var slides = root.querySelectorAll('[data-eis-slide]');
    var thumbs = root.querySelectorAll('[data-eis-thumb]');
    var index = 0;

    function show(next) {
      if (!slides.length) return;
      index = (next + slides.length) % slides.length;
      for (var i = 0; i < slides.length; i++) {
        if (i === index) {
          slides[i].setAttribute('data-active', '');
        } else {
          slides[i].removeAttribute('data-active');
        }
      }
      for (var t = 0; t < thumbs.length; t++) {
        thumbs[t].setAttribute('aria-current', t === index ? 'true' : 'false');
      }
      trackThumb();
    }

    /* The thumb row scrolls, so the active thumb can sit off-screen after the
       arrows move the main image. Scroll the row itself rather than calling
       scrollIntoView, which would drag the whole page along with it. */
    var thumbRow = root.querySelector('.eis-hero__thumbs');
    var smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function trackThumb() {
      if (!thumbRow || !thumbs[index]) return;
      var t = thumbs[index];
      var left = t.offsetLeft - (thumbRow.clientWidth - t.offsetWidth) / 2;
      left = Math.max(0, Math.min(left, thumbRow.scrollWidth - thumbRow.clientWidth));
      if (thumbRow.scrollTo) {
        thumbRow.scrollTo({ left: left, behavior: smooth ? 'smooth' : 'auto' });
      } else {
        thumbRow.scrollLeft = left;
      }
    }

    for (var t = 0; t < thumbs.length; t++) {
      (function (el) {
        el.addEventListener('click', function () {
          show(parseInt(el.getAttribute('data-eis-thumb'), 10));
        });
      })(thumbs[t]);
    }

    var prev = root.querySelector('[data-eis-prev]');
    var next = root.querySelector('[data-eis-next]');
    if (prev) prev.addEventListener('click', function () { show(index - 1); });
    if (next) next.addEventListener('click', function () { show(index + 1); });

    /* ---- swipe ---- */
    var stage = root.querySelector('.eis-hero__stage');
    if (stage && slides.length > 1) {
      var startX = null;
      stage.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
      stage.addEventListener('touchend', function (e) {
        if (startX === null) return;
        var dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) show(dx < 0 ? index + 1 : index - 1);
        startX = null;
      }, { passive: true });
    }

    /* ---- add to cart (AJAX, then go to the cart or straight to checkout) ---- */
    var ATC_DESTINATION = {% if section.settings.atc_destination == 'checkout' %}'/checkout'{% else %}'{{ routes.cart_url }}'{% endif %};

    function addToCart(variantId, button) {
      if (!variantId) return;
      var original = button.innerHTML;
      button.disabled = true;
      button.innerHTML = {{ section.settings.adding_label | json }};
      fetch('{{ routes.cart_add_url }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (r) {
          if (!r.ok) throw new Error(r.data && r.data.description ? r.data.description : 'Add to cart failed');
          window.location.href = ATC_DESTINATION;
        })
        .catch(function (err) {
          button.disabled = false;
          button.innerHTML = original;
          /* Slow or flaky network: fall back to a normal form post so the
             customer still gets to the cart. */
          var form = root.querySelector('[data-eis-form]');
          if (form) { form.removeAttribute('data-eis-form'); form.submit(); return; }
          window.alert(err.message);
        });
    }

    var form = root.querySelector('[data-eis-form]');
    if (form) {
      form.addEventListener('submit', function (e) {
        if (!form.hasAttribute('data-eis-form')) return;
        e.preventDefault();
        var btn = form.querySelector('[data-eis-atc]');
        addToCart(form.querySelector('input[name="id"]').value, btn);
      });
    }

    /* ---- social proof counter ---- */
    var counter = root.querySelector('[data-eis-count]');
    if (counter && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var cFrom = parseInt(counter.getAttribute('data-from'), 10);
      var cTo = parseInt(counter.getAttribute('data-to'), 10);
      var COUNT_MS = 2000;
      var PAUSE_MS = 10000;

      if (!isNaN(cFrom) && !isNaN(cTo) && cTo > cFrom) {
        var fmt = function (n) {
          try { return n.toLocaleString('en-IN'); } catch (e) { return String(n); }
        };

        var runCount = function () {
          var startTime = null;
          var step = function (now) {
            if (startTime === null) startTime = now;
            var progress = Math.min((now - startTime) / COUNT_MS, 1);
            /* easeOutExpo: fast off the mark, then settles */
            var eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            counter.textContent = fmt(Math.floor(cFrom + eased * (cTo - cFrom)));
            if (progress < 1) {
              window.requestAnimationFrame(step);
            } else {
              counter.textContent = fmt(cTo);
              window.setTimeout(runCount, PAUSE_MS);
            }
          };
          window.requestAnimationFrame(step);
        };

        /* Only start once the row is actually on screen, so the first run
           isn't spent before anybody scrolls down to it. */
        if (window.IntersectionObserver) {
          var seen = false;
          var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting && !seen) { seen = true; io.disconnect(); runCount(); }
            }
          }, { threshold: 0.4 });
          io.observe(counter);
        } else {
          window.setTimeout(runCount, 500);
        }
      }
    }

    /* ---- delivery estimate on the viewer's own clock ---- */
    var deliv = root.querySelector('[data-eis-delivery]');
    if (deliv) {
      var out = deliv.querySelector('[data-eis-delivery-range]');
      var minD = parseInt(deliv.getAttribute('data-min-days'), 10);
      var maxD = parseInt(deliv.getAttribute('data-max-days'), 10);
      if (out && !isNaN(minD) && !isNaN(maxD)) {
        var dayLabel = function (offset) {
          var d = new Date();
          d.setDate(d.getDate() + offset);
          try {
            return d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
          } catch (e) {
            return d.toDateString().slice(0, 10);
          }
        };
        out.textContent = dayLabel(minD) + ' \u2013 ' + dayLabel(maxD);
      }
    }

    /* ---- sticky bar ---- */
    if (sticky) {
      var revealAt = parseInt(sticky.getAttribute('data-reveal-at'), 10) || 620;
      var action = sticky.getAttribute('data-action');
      var revealMode = sticky.getAttribute('data-reveal-mode');
      var ticking = false;

      /* The buy box ends with its FAQ, so that is the anchor. With the FAQ
         switched off, fall back to the whole hero. */
      var revealAnchor = root.querySelector('.eis-bfaq') || root;

      function update() {
        var show;
        if (revealMode === 'after_buy_box') {
          show = revealAnchor.getBoundingClientRect().bottom <= 0;
        } else {
          var y = window.scrollY || document.documentElement.scrollTop;
          show = y > revealAt;
        }
        sticky.classList.toggle('is-visible', show);
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
      }, { passive: true });
      update();

      var stickyBtn = sticky.querySelector('[data-eis-sticky-btn]');
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function () {
          if (action === 'add_to_cart') {
            addToCart(stickyBtn.getAttribute('data-variant-id'), stickyBtn);
            return;
          }

          var target = null;
          if (action === 'scroll_to_atc') {
            /* Send them back to the real buy button, and focus it so the
               keyboard path lands in the same place as the tap. */
            target = root.querySelector('[data-eis-atc]');
          }
          if (!target) target = document.getElementById(sticky.getAttribute('data-offers'));
          if (!target) return;

          var smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
          if (action === 'scroll_to_atc' && target.focus) {
            window.setTimeout(function () { target.focus({ preventScroll: true }); }, smooth ? 450 : 0);
          }
        });
      }
    }
  })();
</script>

{% schema %}
{
  "name": "EIS — Product hero",
  "tag": "section",
  "class": "eis-section eis-section--hero",
  "max_blocks": 24,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty on a product template to use the current product."
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Fallback / sticky-bar image",
      "info": "Optional. Used when the product has no images, and for the sticky bar thumbnail."
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Main image height",
      "min": 260,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 380
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Main image focus",
      "options": [
        {
          "value": "center center",
          "label": "Centre"
        },
        {
          "value": "70% center",
          "label": "Right of centre"
        },
        {
          "value": "30% center",
          "label": "Left of centre"
        }
      ],
      "default": "70% center"
    },
    {
      "type": "range",
      "id": "gallery_limit",
      "label": "Max images to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "thumb_columns",
      "label": "Thumbnails in view",
      "info": "The row scrolls. A half thumbnail at the edge (4.5, 5.5) is what tells people there are more images.",
      "min": 3,
      "max": 7,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating row",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Filled stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated <strong>4.8 / 5.0</strong> | 'Excellent'"
    },
    {
      "type": "text",
      "id": "rating_count_text",
      "label": "Second line",
      "info": "Optional. Leave empty to keep the rating on one line."
    },
    {
      "type": "range",
      "id": "rating_star_size",
      "label": "Star size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "rating_text_size",
      "label": "Rating text size",
      "min": 11,
