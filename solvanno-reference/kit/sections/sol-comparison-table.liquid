{%- comment -%} SOL — Comparison table (table-based; host-theme proof) {%- endcomment -%}
{% render 'sol-fonts' %}

{% style %}
  {% render 'sol-tokens', id: section.id, s: section.settings %}
  #shopify-section-{{ section.id }} .sol-cmp { background: var(--sol-cream); font-family: var(--sol-sans); color: var(--sol-ink); }
  #shopify-section-{{ section.id }} .sol-cmp__inner { max-width: var(--sol-max); margin: 0 auto; padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .sol-cmp__title { font-family: var(--sol-serif); font-size: {{ section.settings.heading_size }}px; font-weight: 600; line-height: 1.06; text-transform: uppercase; color: var(--sol-maroon); text-align: left; margin: 0 0 18px; }

  #shopify-section-{{ section.id }} .sol-cmp__wrap { position: relative; margin-top: {{ section.settings.bottle_size | minus: 24 }}px; }
  #shopify-section-{{ section.id }} .sol-cmp__table { display: table !important; width: 100% !important; table-layout: fixed !important; border-collapse: separate !important; border-spacing: 9px 0 !important; margin: 0 !important; }
  #shopify-section-{{ section.id }} .sol-cmp__table col.c-brand,
  #shopify-section-{{ section.id }} .sol-cmp__table col.c-other { width: {{ section.settings.col_width }}px; }
  #shopify-section-{{ section.id }} .sol-cmp__table thead,
  #shopify-section-{{ section.id }} .sol-cmp__table tbody { display: table-row-group !important; }
  #shopify-section-{{ section.id }} .sol-cmp__table tr { display: table-row !important; }
  #shopify-section-{{ section.id }} .sol-cmp__th, #shopify-section-{{ section.id }} .sol-cmp__td { display: table-cell !important; float: none !important; }

  #shopify-section-{{ section.id }} .sol-cmp__th { text-align: center; font-size: 11px; font-weight: 700; line-height: 1.2; letter-spacing: .04em; text-transform: uppercase; padding: 11px 6px; border-radius: 13px 13px 0 0; vertical-align: middle; }
  #shopify-section-{{ section.id }} .sol-cmp__th--feat { background: {{ section.settings.color_card }}; border: 1px solid var(--sol-line); border-bottom: 0; color: var(--sol-soft); }
  #shopify-section-{{ section.id }} .sol-cmp__th--brand { background: var(--sol-maroon); color: var(--sol-cream-light); position: relative; }
  #shopify-section-{{ section.id }} .sol-cmp__th--other { background: {{ section.settings.color_tint }}; color: var(--sol-muted); }

  #shopify-section-{{ section.id }} .sol-cmp__td { height: {{ section.settings.row_height }}px; vertical-align: middle; }
  #shopify-section-{{ section.id }} .sol-cmp__td--feat { background: {{ section.settings.color_card }}; border-left: 1px solid var(--sol-line); border-right: 1px solid var(--sol-line); border-bottom: 1px solid var(--sol-line); padding: 10px 13px; }
  #shopify-section-{{ section.id }} .sol-cmp__td--brand { background: var(--sol-maroon); border-bottom: 1px solid rgba(255,255,255,.28); text-align: center; }
  #shopify-section-{{ section.id }} .sol-cmp__td--other { background: {{ section.settings.color_tint }}; border-bottom: 1px solid var(--sol-line); text-align: center; }
  #shopify-section-{{ section.id }} tbody tr:last-child .sol-cmp__td { border-bottom: 0; border-radius: 0 0 13px 13px; }

  #shopify-section-{{ section.id }} .sol-cmp__featwrap { display: flex; align-items: center; gap: 11px; }
  #shopify-section-{{ section.id }} .sol-cmp__ic { flex: none; width: 34px; height: 34px; border-radius: 999px; border: 1.4px solid var(--sol-maroon); color: var(--sol-maroon); display: flex; align-items: center; justify-content: center; font-size: 17px; }
  #shopify-section-{{ section.id }} .sol-cmp__ic .sol-icon { width: 1em; height: 1em; display: block; }
  #shopify-section-{{ section.id }} .sol-cmp__lbl { font-size: 13.5px; font-weight: 600; line-height: 1.3; }
  #shopify-section-{{ section.id }} .sol-cmp__yes { width: 30px; height: 30px; display: inline-block; vertical-align: middle; }
  #shopify-section-{{ section.id }} .sol-cmp__no { width: 19px; height: 19px; display: inline-block; vertical-align: middle; }

  #shopify-section-{{ section.id }} .sol-cmp__bottle { position: absolute; left: 50%; bottom: calc(100% - 10px); transform: translateX(-50%); height: {{ section.settings.bottle_size }}px; width: auto; max-width: none; object-fit: contain; filter: drop-shadow(0 10px 16px rgba(0,0,0,.45)); pointer-events: none; }
  #shopify-section-{{ section.id }} .sol-cmp__note { font-size: 12px; line-height: 1.55; color: var(--sol-soft); text-align: center; margin: 16px 0 0; }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .sol-cmp__inner { max-width: 900px; }
    #shopify-section-{{ section.id }} .sol-cmp__table col.c-brand,
    #shopify-section-{{ section.id }} .sol-cmp__table col.c-other { width: 170px; }
    #shopify-section-{{ section.id }} .sol-cmp__title { font-size: {{ section.settings.heading_size | times: 125 | divided_by: 100 }}px; }
    #shopify-section-{{ section.id }} .sol-cmp__th { font-size: 14px; padding: 14px 10px; }
    #shopify-section-{{ section.id }} .sol-cmp__td { height: {{ section.settings.row_height | times: 125 | divided_by: 100 }}px; }
    #shopify-section-{{ section.id }} .sol-cmp__td--feat { padding: 12px 16px; }
    #shopify-section-{{ section.id }} .sol-cmp__ic { width: 42px; height: 42px; font-size: 21px; }
    #shopify-section-{{ section.id }} .sol-cmp__lbl { font-size: 15px; }
    #shopify-section-{{ section.id }} .sol-cmp__wrap { margin-top: {{ section.settings.bottle_size | times: 150 | divided_by: 100 | minus: 24 }}px; }
    #shopify-section-{{ section.id }} .sol-cmp__bottle { height: {{ section.settings.bottle_size | times: 150 | divided_by: 100 }}px; }
    #shopify-section-{{ section.id }} .sol-cmp__yes { width: 38px; height: 38px; }
    #shopify-section-{{ section.id }} .sol-cmp__no { width: 24px; height: 24px; }
  }
{% endstyle %}

{%- capture yes_brand -%}<svg class="sol-cmp__yes" viewBox="0 0 44 44" aria-hidden="true"><path fill="{{ section.settings.color_cream_light }}" d="M22 3.3Q28-.41 31.35 5.81Q38.4 5.6 38.19 12.65Q44.41 16 40.7 22Q44.41 28 38.19 31.35Q38.4 38.4 31.35 38.19Q28 44.41 22 40.7Q16 44.41 12.65 38.19Q5.6 38.4 5.81 31.35Q-.41 28 3.3 22Q-.41 16 5.81 12.65Q5.6 5.6 12.65 5.81Q16-.41 22 3.3Z"/><path d="M14.8 22.3l5 5 9.4-10.1" fill="none" stroke="{{ section.settings.color_maroon }}" stroke-width="3.3" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture no_light -%}<svg class="sol-cmp__no" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13" fill="none" stroke="{{ section.settings.color_cream_light }}" stroke-width="1.9" stroke-linecap="round"/></svg>{%- endcapture -%}
{%- capture yes_other -%}<svg class="sol-cmp__yes" viewBox="0 0 44 44" aria-hidden="true"><path fill="{{ section.settings.color_maroon }}" d="M22 3.3Q28-.41 31.35 5.81Q38.4 5.6 38.19 12.65Q44.41 16 40.7 22Q44.41 28 38.19 31.35Q38.4 38.4 31.35 38.19Q28 44.41 22 40.7Q16 44.41 12.65 38.19Q5.6 38.4 5.81 31.35Q-.41 28 3.3 22Q-.41 16 5.81 12.65Q5.6 5.6 12.65 5.81Q16-.41 22 3.3Z"/><path d="M14.8 22.3l5 5 9.4-10.1" fill="none" stroke="{{ section.settings.color_cream_light }}" stroke-width="3.3" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture no_muted -%}<svg class="sol-cmp__no" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13" fill="none" stroke="{{ section.settings.color_muted }}" stroke-width="1.9" stroke-linecap="round"/></svg>{%- endcapture -%}

<div class="sol-cmp">
  <div class="sol-cmp__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sol-cmp__title">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}
    <div class="sol-cmp__wrap">
      <table class="sol-cmp__table">
        <colgroup><col class="c-feat"><col class="c-brand"><col class="c-other"></colgroup>
        <thead>
          <tr>
            <th class="sol-cmp__th sol-cmp__th--feat">{{ section.settings.compare_label }}</th>
            <th class="sol-cmp__th sol-cmp__th--brand">
              {%- if section.settings.bottle_image != blank -%}
                {{ section.settings.bottle_image | image_url: width: 320 | image_tag: widths: '80,120,180,320', sizes: '80px', loading: 'lazy', class: 'sol-cmp__bottle', alt: '' }}
              {%- else -%}
                <img class="sol-cmp__bottle" src="https://cdn.shopify.com/s/files/1/0779/1601/2763/files/Product_Image_New.png?v=1788648726" loading="lazy" alt="">
              {%- endif -%}
              {{ section.settings.brand_label }}
            </th>
            <th class="sol-cmp__th sol-cmp__th--other">{{ section.settings.other_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td class="sol-cmp__td sol-cmp__td--feat">
                <span class="sol-cmp__featwrap">
                  <span class="sol-cmp__ic" aria-hidden="true">{% render 'sol-icon', name: block.settings.icon %}</span>
                  <span class="sol-cmp__lbl">{{ block.settings.label }}</span>
                </span>
              </td>
              <td class="sol-cmp__td sol-cmp__td--brand">{%- if block.settings.us -%}{{ yes_brand }}{%- else -%}{{ no_light }}{%- endif -%}</td>
              <td class="sol-cmp__td sol-cmp__td--other">{%- if block.settings.them -%}{{ yes_other }}{%- else -%}{{ no_muted }}{%- endif -%}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank -%}
      <p class="sol-cmp__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SOL — Comparison table",
  "tag": "section",
  "class": "sol-section sol-section--compare",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept. Shown in capitals.",
      "default": "Why Our Oil Outlasts\nSprays & Balms"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "info": "Sits in the feature column, beside the bottle. At 26px the headline fits inside the bottle's headroom and costs the section no height at all; larger and it starts pushing the table down. Desktop steps up to 125%.",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "text",
      "id": "compare_label",
      "label": "Feature column header",
      "default": "Compare"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Our column header",
      "default": "SOL Oil"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Their column header",
      "default": "Sprays, Balms & Gels"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Closing note"
    },
    {
      "type": "header",
      "content": "Bottle"
    },
    {
      "type": "image_picker",
      "id": "bottle_image",
      "label": "Bottle cut-out",
      "info": "Transparent PNG. Hangs over the top of our column."
    },
    {
      "type": "range",
      "id": "bottle_size",
      "label": "Bottle height",
      "info": "Phone height. Desktop scales to 150% of it, phones under 390px to 82%.",
      "min": 70,
      "max": 220,
      "step": 5,
      "unit": "px",
      "default": 130
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Background",
      "default": "#f3f7e4"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Feature card",
      "default": "#fcfef6"
    },
    {
      "type": "color",
      "id": "color_maroon",
      "label": "Heading & our column",
      "default": "#2f6b2e"
    },
    {
      "type": "color",
      "id": "color_tint",
      "label": "Their column",
      "default": "#F4E7DA"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Tick",
      "default": "#edf3d6"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Feature text",
      "default": "#17271b"
    },
    {
      "type": "color",
      "id": "color_soft",
      "label": "Muted labels",
      "default": "#8A7A63"
    },
    {
      "type": "color",
      "id": "color_muted",
      "label": "Crosses",
      "default": "#9A8F82"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Hairlines",
      "default": "#dde7c2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "col_width",
      "label": "Comparison column width",
      "info": "Desktop steps up to 120% of this; phones under 390px step down, so the feature label keeps its width.",
      "min": 60,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 78
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "info": "Every row is at least this tall, so one-line and two-line features sit on the same rhythm. Desktop steps up to 125% of it.",
      "min": 44,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 62
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 1180,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature",
          "default": "15+ herbs, no chemicals"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
