        "out": 131.96
      },
      "shots": [
        {
          "clip": "clip_36",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg35",
      "role": "body",
      "line": "Said \"Is THIS her? Is this the other woman?\" and she fell in my embrace",
