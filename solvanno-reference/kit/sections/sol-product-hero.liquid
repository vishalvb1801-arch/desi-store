    <div id="sp-{{ section.id }}">
      <div class="social-proof-wrapper">
        <div class="sp-row1">
          <div class="sp-avatars">
            <img src="https://cdn.shopify.com/s/files/1/0779/1601/2763/files/m4.jpg?v=1788725451" alt="Customer">
            <img src="https://cdn.shopify.com/s/files/1/0779/1601/2763/files/ChatGPT_Image_Sep_6_2026_09_19_05_PM.png?v=1788709775" alt="Customer">
            <img src="https://cdn.shopify.com/s/files/1/0779/1601/2763/files/ChatGPT_Image_Sep_6_2026_08_10_42_PM.png?v=1788705668" alt="Customer">
          </div>
          <div class="sp-count-inline"><span class="sp-count" id="sp-counter-{{ section.id }}">10000</span><span>+ Happy Customers</span></div>
        </div>
        <div class="sp-row2"><span class="sp-stars"><span class="sp-star">&#9733;</span><span class="sp-star">&#9733;</span><span class="sp-star">&#9733;</span><span class="sp-star">&#9733;</span><span class="sp-star">&#9733;</span></span><span class="sp-rating">4.8/5</span></div>
      </div>
    </div>
    <script>
      (function(){
        var startFrom = 10000, target = 36243, dur = 2000, pause = 10000;
        function ease(t){ return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }
        function run(){
          var c = document.getElementById("sp-counter-{{ section.id }}");
          if (!c) return;
          var t0 = performance.now();
          function step(now){
            var p = Math.min((now - t0) / dur, 1);
            c.textContent = Math.floor(startFrom + ease(p) * (target - startFrom)).toLocaleString("en-US");
            if (p < 1) { requestAnimationFrame(step); }
            else { c.textContent = target.toLocaleString("en-US"); setTimeout(run, pause); }
          }
          requestAnimationFrame(step);
        }
        setTimeout(run, 500);
      })();
    </script>

