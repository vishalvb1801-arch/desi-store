{%- comment -%}
  EIS — FAQ accordion
  ------------------------------------------------------------------
  Built on <details>/<summary>, so every answer is readable and openable
  before JavaScript runs. The script only adds "one open at a time".
{%- endcomment -%}

{% render 'eis-fonts' %}

{% style %}
  {% render 'eis-tokens', id: section.id, s: section.settings %}

  .eis-faq {
    background: var(--eis-cream);
    font-family: var(--eis-sans);
    color: var(--eis-ink);
  }
  .eis-faq__inner {
    max-width: var(--eis-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .eis-faq__head { text-align: center; }
  .eis-faq__eyebrow {
    display: inline-block;
    font-size: 10px;
    letter-spacing: .18em;
    color: var(--eis-soft);
    border: 1px solid #E2D2B8;
    border-radius: 999px;
    padding: 4px 12px;
  }
  .eis-faq__title {
    font-family: var(--eis-serif);
    font-size: 27px;
    font-weight: 600;
    color: var(--eis-maroon);
    margin: 12px 0 20px;
    line-height: 1.15;
  }
  .eis-faq__item {
    background: #fff;
    border: 1px solid #EFE0C9;
    border-radius: 10px;
    padding: 15px;
    margin-bottom: 9px;
  }
  .eis-faq__item summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    cursor: pointer;
    list-style: none;
    font-size: 13.5px;
    font-weight: 700;
    -webkit-tap-highlight-color: transparent;
  }
  .eis-faq__item summary::-webkit-details-marker { display: none; }
  .eis-faq__sign {
    font-size: 17px;
    line-height: 1;
    color: var(--eis-maroon);
    flex: none;
  }
  .eis-faq__sign::after { content: '+'; }
  .eis-faq__item[open] .eis-faq__sign::after { content: '−'; }
  .eis-faq__answer {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--eis-muted);
    margin-top: 10px;
  }
  .eis-faq__answer p { margin: 0 0 8px; }
  .eis-faq__answer p:last-child { margin-bottom: 0; }
  .eis-faq__answer a { color: var(--eis-maroon); }
{% endstyle %}

<div class="eis-faq">
  <div class="eis-faq__inner" data-eis-faq>
    <div class="eis-faq__head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="eis-faq__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="eis-faq__title">{{ section.settings.heading | newline_to_br }}</h2>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <details
        class="eis-faq__item"
        {% if forloop.first and section.settings.open_first %}open{% endif %}
        {{ block.shopify_attributes }}
      >
        <summary>
          <span>{{ block.settings.question }}</span>
          <span class="eis-faq__sign" aria-hidden="true"></span>
        </summary>
        <div class="eis-faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var wrap = document.querySelector('#shopify-section-{{ section.id }} [data-eis-faq]');
    if (!wrap) return;
    var items = wrap.querySelectorAll('.eis-faq__item');

    {%- if section.settings.one_at_a_time %}
    for (var i = 0; i < items.length; i++) {
      items[i].addEventListener('toggle', function () {
        if (!this.open) return;
        for (var j = 0; j < items.length; j++) {
          if (items[j] !== this) items[j].removeAttribute('open');
        }
      });
    }
    {%- endif %}
  })();
</script>

{%- if section.settings.enable_seo_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "EIS — FAQ accordion",
  "tag": "section",
  "class": "eis-section eis-section--faq",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "Frequently Asked\nQuestions"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "one_at_a_time",
      "label": "Only one answer open at a time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_seo_schema",
      "label": "Add FAQ structured data for Google",
      "default": true,
      "info": "Lets these questions appear as rich results in search. Turn off if another app already outputs FAQ schema on this page."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Background",
      "default": "#FBF3E7"
    },
    {
      "type": "color",
      "id": "color_maroon",
      "label": "Heading",
      "default": "#7B1315"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Question text",
      "default": "#2A1C18"
    },
    {
      "type": "color",
      "id": "color_muted",
      "label": "Answer text",
      "default": "#5E5147"
    },
    {
      "type": "color",
      "id": "color_soft",
      "label": "Eyebrow text",
      "default": "#8A7A63"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Why do I need this oil?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Because most balms only warm the skin.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EIS — FAQ accordion",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Why do I need this oil?",
            "answer": "<p>Because most balms only warm the skin. EIS is a Mahanarayan-and-sesame oil base carrying 15+ herbs into the muscle and joint, so relief goes deeper and holds longer — for knees, lower back, shoulders and everyday stiffness.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What's actually in it?",
            "answer": "<p>Nirgundi, Rasna, Ashwagandha, Nilgiri (eucalyptus), Gandhapura, Pudina, Lawang, Dalchini, Kapoor, Sunthi, Erand Mool and more — in a Til Taila (sesame) and Mahanarayan oil base. No synthetic actives.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How and when do I apply it?",
            "answer": "<p>Warm a little oil, apply to the affected area and massage in circular motion for 5–10 minutes. Best at night before bed; twice daily during flare-ups. External use only.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is there a guarantee?",
            "answer": "<p>Yes — use it nightly for 7 days. If you don't feel a difference, contact us and we'll refund every rupee. No forms, no arguing.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "When will it arrive?",
            "answer": "<p>Orders ship within 24 hours and reach most Indian pin codes in 3–5 days. You'll get a tracking link by SMS and WhatsApp.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
