        "file": "vo.mp3",
        "in": 29.98,
        "out": 33.96
      },
      "shots": [
        {
          "clip": "clip_9",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg09",
      "role": "body",
      "line": "Two feet away, listening to a sound I still can hear",
      "vo": {
        "file": "vo.mp3",
        "in": 33.96,
        "out": 37.02
      },
      "shots": [
        {
          "clip": "clip_10",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg10",
      "role": "body",
      "line": "Her pretending to be sleeping, so I wouldn't see her tears",
