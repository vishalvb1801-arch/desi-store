          "clip": "clip_27",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg27",
      "role": "body",
      "line": "There's someone else, Neelu… what else could he be doing at two?\"",
