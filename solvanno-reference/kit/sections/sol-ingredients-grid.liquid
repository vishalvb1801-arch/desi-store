{%- comment -%}
  SOL — Ingredients grid
  ------------------------------------------------------------------
  Herb cards, each with an expandable "MORE INFO" detail. Built on
  <details>/<summary> so the detail is reachable without JavaScript.

  A card with no image falls back to the design's two-tone herb dot, mixed
  from the block's own colour settings.
{%- endcomment -%}

{% render 'sol-fonts' %}

{% style %}
  {% render 'sol-tokens', id: section.id, s: section.settings %}

  .sol-herbs {
    background: {{ section.settings.color_background }};
    font-family: var(--sol-sans);
    color: var(--sol-ink);
  }
  .sol-herbs__inner {
    max-width: var(--sol-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .sol-herbs__title {
    font-family: var(--sol-serif);
    font-size: 29px;
    font-weight: 600;
    color: var(--sol-maroon);
    text-align: center;
    margin: 0;
    line-height: 1.15;
  }
  .sol-herbs__intro {
    font-size: 13px;
    line-height: 1.55;
    color: var(--sol-muted);
    text-align: center;
    margin: 12px 0 20px;
  }
  .sol-herbs__intro strong { color: var(--sol-ink); }
  .sol-herbs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 10px;
  }
  .sol-herbs__card {
    border: 1px solid #EFE0C9;
    border-radius: 11px;
    padding: 14px 10px;
    text-align: center;
    background: var(--sol-cream);
    min-width: 0;
  }
  .sol-herbs__dot {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius: {{ section.settings.image_radius }}px;
    margin: 0 0 10px;
    overflow: hidden;
  }
  .sol-herbs__dot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sol-herbs__name {
    font-family: var(--sol-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--sol-maroon);
  }
  .sol-herbs__role { font-size: 11px; color: var(--sol-muted); margin-top: 4px; line-height: 1.35; }
  .sol-herbs__detail { list-style: none; }
  .sol-herbs__detail summary {
    list-style: none;
    cursor: pointer;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--sol-maroon);
    border: 1px solid #E2D2B8;
    border-radius: 999px;
    padding: 4px 9px;
    display: inline-block;
    margin-top: 10px;
    background: #fff;
    -webkit-tap-highlight-color: transparent;
  }
  .sol-herbs__detail summary::-webkit-details-marker { display: none; }
  .sol-herbs__detail summary::after { content: ' +'; }
  .sol-herbs__detail[open] summary::after { content: ' −'; }
  .sol-herbs__body {
    font-size: 11px;
    color: var(--sol-muted);
    line-height: 1.45;
    margin-top: 8px;
    text-align: left;
  }
  .sol-herbs__body p { margin: 0 0 6px; }
  .sol-herbs__body p:last-child { margin-bottom: 0; }
  .sol-herbs__note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--sol-soft);
    text-align: center;
    margin: 16px 0 0;
  }
  .sol-herbs__head { position: relative; }
  .sol-herbs__bottle { display: none; }
  .sol-herbs__scroll { display: none; }

  /* Tipped bottles are a phone-only device — they'd read as clutter wide. */
  @media (max-width: 749px) {
    /* Clip sideways only, so a rotated bottle can never push the page into a
       horizontal scroll, but its cap is free to rise over the section above
       instead of being sliced flat at the top edge. `overflow: hidden` is the
       fallback where `clip` is unsupported (Safari < 16). */
    .sol-herbs--bottles { overflow: hidden; }
    /* Ingredient cards swipe sideways on phones. */
    .sol-herbs__grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding-bottom: 14px;
      scrollbar-width: none;
    }
    .sol-herbs__grid::-webkit-scrollbar { display: none; }
    .sol-herbs__card { flex: 0 0 78%; scroll-snap-align: start; }
    /* always-visible custom scroll indicator */
    .sol-herbs__scroll {
      display: block;
      height: 6px;
      width: 120px;
      max-width: 55%;
      margin: 12px auto 0;
      background: #e3e6d6;
      border-radius: 999px;
      position: relative;
      overflow: hidden;
    }
    .sol-herbs__scrollthumb {
      position: absolute;
      top: 0;
      left: 0;
      height: 6px;
      width: 40%;
      background: #9cae01;
      border-radius: 999px;
    }
    @supports (overflow: clip) {
      .sol-herbs--bottles { overflow: clip visible; }
    }
    .sol-herbs--bottles .sol-herbs__head {
      min-height: {{ section.settings.bottle_row_height }}px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sol-herbs--bottles .sol-herbs__title {
      padding-left: {{ section.settings.heading_gutter }}%;
      padding-right: {{ section.settings.heading_gutter }}%;
      position: relative;
      z-index: 1;
    }
    .sol-herbs--bottles .sol-herbs__bottle {
      display: block;
      position: absolute;
      top: 50%;
      margin-top: {{ section.settings.bottle_offset_y }}px;
      width: {{ section.settings.bottle_width }}%;
      pointer-events: none;
      -webkit-user-select: none;
      user-select: none;
      /* Shadow lives on the wrapper, rotation on the image inside it, so the
         bottle tips over while its shadow still falls straight down. */
      filter: drop-shadow(0 10px 14px rgba(0, 0, 0, {{ section.settings.bottle_shadow | times: 0.01 }}));
    }
    .sol-herbs__bottle img {
      display: block;
      width: 100%;
      height: auto;
      max-width: none;
    }
    .sol-herbs__bottle--l {
      left: -{{ section.settings.bottle_bleed }}px;
      transform: translateY(-50%);
    }
    .sol-herbs__bottle--l img { transform: rotate({{ section.settings.bottle_angle }}deg); }
    .sol-herbs__bottle--r {
      right: -{{ section.settings.bottle_bleed }}px;
      transform: translateY(-50%);
    }
    .sol-herbs__bottle--r img { transform: rotate(-{{ section.settings.bottle_angle }}deg); }
  }

  /* ---------- desktop & iPad ---------- */
  @media (min-width: 750px) {
    .sol-herbs__inner { max-width: 976px; }
    .sol-herbs__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  }
  @media (min-width: 1200px) {
    .sol-herbs__inner { max-width: 1280px; }
    .sol-herbs__grid { gap: 24px; }
  }
{% endstyle %}

{%- assign sol_bottles_on = section.settings.show_bottles -%}
{%- assign sol_bottle_fallback = 'https://cdn.shopify.com/s/files/1/0779/1601/2763/files/ChatGPT_Image_Jun_5_2026_05_43_11_PM.png?v=1780661613' -%}

<div class="sol-herbs{% if sol_bottles_on %} sol-herbs--bottles{% endif %}">
  <div class="sol-herbs__inner">
    {%- if section.settings.heading != blank or sol_bottles_on -%}
      <div class="sol-herbs__head">
        {%- if sol_bottles_on -%}
          <div class="sol-herbs__bottle sol-herbs__bottle--l">
            {%- if section.settings.bottle_image != blank -%}
              {{ section.settings.bottle_image | image_url: width: 460 | image_tag: widths: '160, 240, 320, 460', sizes: '30vw', loading: 'lazy', alt: '' }}
            {%- else -%}
              <img src="{{ sol_bottle_fallback }}" width="460" height="460" loading="lazy" alt="">
            {%- endif -%}
          </div>
          <div class="sol-herbs__bottle sol-herbs__bottle--r">
            {%- if section.settings.bottle_image != blank -%}
              {{ section.settings.bottle_image | image_url: width: 460 | image_tag: widths: '160, 240, 320, 460', sizes: '30vw', loading: 'lazy', alt: '' }}
            {%- else -%}
              <img src="{{ sol_bottle_fallback }}" width="460" height="460" loading="lazy" alt="">
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sol-herbs__title">{{ section.settings.heading | newline_to_br }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="sol-herbs__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="sol-herbs__grid">
      {%- for block in section.blocks -%}
        <div class="sol-herbs__card" {{ block.shopify_attributes }}>
          <div
            class="sol-herbs__dot"
            {% if block.settings.image == blank %}
              style="background: radial-gradient(circle at 35% 30%, {{ block.settings.color_from }}, {{ block.settings.color_to }})"
            {% endif %}
            aria-hidden="true"
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 480
                | image_tag: widths: '160, 240, 320, 480', sizes: '45vw', loading: 'lazy', alt: ''
              }}
            {%- endif -%}
          </div>

          <div class="sol-herbs__name">{{ block.settings.name }}</div>
          {%- if block.settings.role != blank -%}
            <div class="sol-herbs__role">{{ block.settings.role }}</div>
          {%- endif -%}

          {%- if block.settings.detail != blank -%}
            <details class="sol-herbs__detail">
              <summary>{{ section.settings.more_label }}</summary>
              <div class="sol-herbs__body">{{ block.settings.detail }}</div>
            </details>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="sol-herbs__scroll" aria-hidden="true"><span class="sol-herbs__scrollthumb"></span></div>

    {%- if section.settings.note != blank -%}
      <p class="sol-herbs__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }}');
    if (!root) return;
    var grid = root.querySelector('.sol-herbs__grid');
    var bar = root.querySelector('.sol-herbs__scroll');
    var thumb = root.querySelector('.sol-herbs__scrollthumb');
    if (!grid || !bar || !thumb) return;
    function update() {
      var sw = grid.scrollWidth, cw = grid.clientWidth;
      if (sw <= cw + 2) { bar.style.display = 'none'; return; }
      bar.style.display = 'block';
      var tw = Math.max((cw / sw) * 100, 16);
      thumb.style.width = tw + '%';
      var pos = grid.scrollLeft / (sw - cw);
      thumb.style.left = (pos * (100 - tw)) + '%';
    }
    grid.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "SOL — Ingredients grid",
  "tag": "section",
  "class": "sol-section sol-section--herbs",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "15 Herbs. Deeper,\nLonger Relief."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "info": "Basic HTML like <strong> works.",
      "default": "SOL works differently from a balm — it <strong>absorbs into the muscle and joint</strong> instead of sitting on the surface."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Expand button label",
      "default": "MORE INFO"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Closing note",
      "default": "Each herb has a role — inflammation, mobility, recovery, penetration and comfort — working together in a sesame & Mahanarayan oil base."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards per row",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Herb image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "3 / 2", "label": "Landscape, wider" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Tipped bottles (mobile only)"
    },
    {
      "type": "checkbox",
      "id": "show_bottles",
      "label": "Show a bottle each side of the heading",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "bottle_image",
      "label": "Bottle cut-out",
      "info": "Upright PNG with a transparent background and no baked-in shadow — the tilt and the shadow are both added here."
    },
    {
      "type": "range",
      "id": "bottle_angle",
      "label": "Tilt",
      "info": "Both bottles lean inward, towards the heading.",
      "min": 0,
      "max": 75,
      "step": 5,
      "unit": "°",
      "default": 45
    },
    {
      "type": "range",
      "id": "bottle_width",
      "label": "Bottle width",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "%",
      "default": 28
    },
    {
      "type": "range",
      "id": "bottle_bleed",
      "label": "Bleed past the edge",
      "info": "A tall bottle laid at 45° sweeps wide, so most of its length is meant to run off the screen.",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "bottle_offset_y",
      "label": "Nudge up or down",
      "info": "Negative moves the bottles up, over the section above. Far enough and they start covering its text.",
      "min": -140,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": -48
    },
    {
      "type": "range",
      "id": "bottle_row_height",
      "label": "Heading row height",
      "min": 100,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "heading_gutter",
      "label": "Space kept clear for the heading",
      "info": "This is padding — raising it narrows the heading. Lower it if the heading wraps onto extra rows.",
      "min": 0,
      "max": 34,
      "step": 2,
      "unit": "%",
      "default": 24
    },
    {
      "type": "range",
      "id": "bottle_shadow",
      "label": "Shadow strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Card background",
      "default": "#f4f6e9"
