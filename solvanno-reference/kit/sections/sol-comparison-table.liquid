            },
            {
              "value": "spark",
              "label": "Spark"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "flask",
              "label": "Lab flask"
            },
            {
              "value": "families",
              "label": "Family"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "discount",
              "label": "Discount"
            },
            {
              "value": "motion",
              "label": "Motion sensor"
            },
            {
              "value": "bulb",
              "label": "Light bulb"
            },
            {
              "value": "magnet",
              "label": "Magnet"
            },
            {
              "value": "usb",
              "label": "USB"
            },
            {
              "value": "bolt",
              "label": "Energy"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "checkbox",
          "id": "us",
          "label": "We have it",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "them",
          "label": "They have it",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOL — Comparison table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "icon": "leaf",
            "label": "15+ herbs, no chemicals"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "spark",
