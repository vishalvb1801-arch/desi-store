{%- comment -%}
  EIS — Social proof
  ------------------------------------------------------------------
  Maroon band: a strip of customer faces, an aggregate rating, the headline,
  then a swipeable row of review cards with verified badges and benefit chips.

  Both rows are horizontal snap scrollers. The face strip scrolls on its own;
  the review row drives the segmented indicator underneath, which also acts as
  a control — tap a segment to jump to that card.

  Blocks with no image render the design's striped placeholder, so the layout
  is right before the real photos arrive.
{%- endcomment -%}

{% render 'eis-fonts' %}

{%- liquid
  assign face_count = 0
  assign review_count = 0
  for block in section.blocks
    case block.type
      when 'face'
        assign face_count = face_count | plus: 1
      when 'review'
        assign review_count = review_count | plus: 1
    endcase
  endfor
-%}

{% style %}
  {% render 'eis-tokens', id: section.id, s: section.settings %}

  .eis-sp {
    background: var(--eis-maroon-deep);
    font-family: var(--eis-sans);
  }
  .eis-sp__inner {
    max-width: var(--eis-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  /* ---------- face strip ---------- */
  .eis-sp__faces {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 0 16px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .eis-sp__faces::-webkit-scrollbar { display: none; }
  .eis-sp__face {
    /* face_size_mobile, not face_size: the live template has a face_size of
       100 saved against it from the theme editor, and a saved value always
       beats a schema default, so raising the default alone changed nothing.
       A new id has nothing saved against it, so its default applies and the
       stale 100 is ignored. Renaming means this ships in the section file
       instead of the template, which carries edits worth keeping. */
    flex: 0 0 {{ section.settings.face_size_mobile }}px;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    border: 1.5px solid var(--eis-gold-light);
    background: repeating-linear-gradient(135deg, #7A2A2B 0 8px, #6A1E20 8px 16px);
  }
  .eis-sp__face img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---------- rating ---------- */
  .eis-sp__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 20px;
    padding: 0 16px;
    flex-wrap: wrap;
  }
  .eis-sp__stars { display: flex; gap: 3px; }
  .eis-sp__stars i {
    width: 20px;
    height: 20px;
    background: var(--eis-green);
    color: #fff;
    font-size: 12px;
    font-style: normal;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
  }
  .eis-sp__rated {
    font-size: 13px;
    font-weight: 600;
    color: var(--eis-cream-light);
  }

  /* ---------- headline ---------- */
  .eis-sp__title {
    font-family: var(--eis-serif);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.18;
    color: var(--eis-cream-light);
    text-align: center;
    margin: 16px 0 22px;
    padding: 0 16px;
  }
  .eis-sp__title em { color: var(--eis-gold-light); font-style: normal; }

  /* ---------- review row ---------- */
  .eis-sp__track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 16px 2px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .eis-sp__track::-webkit-scrollbar { display: none; }
  .eis-sp__card {
    flex: 0 0 calc((100% - 32px - ({{ section.settings.cards_in_view }} - 1) * 10px) / {{ section.settings.cards_in_view }});
    min-width: 0;
    scroll-snap-align: center;
    background: #fff;
    border-radius: 12px;
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .eis-sp__card .eis-sp__stars i { width: 17px; height: 17px; font-size: 10px; }
  .eis-sp__quote {
    font-size: 13px;
    line-height: 1.5;
    color: #3B322C;
    flex: 1;
  }
  .eis-sp__by {
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 1px solid #EFE3D2;
    padding-top: 10px;
  }
  .eis-sp__avatar {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    flex: none;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #EDE1CE 0 5px, #F9F1E4 5px 10px);
  }
  .eis-sp__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .eis-sp__who { flex: 1; min-width: 0; }
  .eis-sp__name { font-size: 12px; font-weight: 700; color: var(--eis-ink); }
  .eis-sp__city { font-size: 10px; color: var(--eis-muted); }
  .eis-sp__verified {
    display: flex;
    align-items: center;
    gap: 3px;
    flex: none;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--eis-green);
  }
  .eis-sp__tags { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .eis-sp__tag {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--eis-green);
  }

  /* ---------- segmented indicator ---------- */
  .eis-sp__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    padding: 0 16px;
  }
  .eis-sp__dot {
    height: 3px;
    width: 14px;
    padding: 0;
    border: 0;
    border-radius: 99px;
    background: rgba(246, 231, 200, .3);
    cursor: pointer;
    transition: width .18s ease, background .18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .eis-sp__dot[aria-current="true"] { width: 30px; background: var(--eis-cream-light); }
  .eis-sp__dot:focus-visible { outline: 2px solid var(--eis-gold-light); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .eis-sp__dot { transition: none; } }

  @media (min-width: 560px) {
    .eis-sp__title { font-size: 34px; }
  }

  /* ---------- desktop & iPad ---------- */
  @media (min-width: 750px) {
    .eis-sp__inner { max-width: 976px; padding-left: 12px; padding-right: 12px; }
    .eis-sp__title { font-size: 34px; }
    /* One row of however many faces exist, sized to fill it. auto-fit with a
       minmax floor was dropping to four columns whenever the row could not
       fit five at the floor width, which broke the strip into 4 + 1 between
       750-999px and again at 1200-1279px. Counting the blocks cannot wrap. */
    .eis-sp__faces {
      display: grid;
      grid-template-columns: repeat({{ face_count }}, minmax(0, 1fr));
      gap: 16px;
      overflow: visible;
      padding: 0;
      /* The strip breaks out of the section's content column. Held to the
         column it could never exceed 232px a face however wide the monitor
         was; on its own width it keeps growing. 40px of slack rather than
         the section's 24px because 100vw counts the scrollbar and the
         difference would be a sideways scroll. Centred on the viewport:
         the parent is already centred, so 50% plus a half-width pull back
         lands in the middle whatever the parent's own width is. */
      width: min(1560px, calc(100vw - 40px));
      margin-left: 50%;
      transform: translateX(-50%);
    }
    .eis-sp__face { flex: initial; width: auto; }
    .eis-sp__track { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; overflow: visible; padding: 0; }
    .eis-sp__card { flex: initial; width: auto; min-width: 0; scroll-snap-align: none; }
    .eis-sp__dots { display: none; }
  }
  @media (min-width: 1200px) {
    .eis-sp__inner { max-width: 1280px; }
    .eis-sp__title { font-size: 42px; }
    .eis-sp__faces { gap: 20px; }
    .eis-sp__track { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  }
{% endstyle %}

<div class="eis-sp">
  <div class="eis-sp__inner">

    {%- if face_count > 0 -%}
      <div class="eis-sp__faces">
        {%- for block in section.blocks -%}
          {%- if block.type == 'face' -%}
            <div class="eis-sp__face" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '90px', loading: 'lazy', alt: '' }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_rating -%}
      <div class="eis-sp__rating">
        <div class="eis-sp__stars" aria-hidden="true">
          {%- for i in (1..section.settings.rating_stars) -%}<i>★</i>{%- endfor -%}
        </div>
        {%- if section.settings.rating_label != blank -%}
          <span class="eis-sp__rated">{{ section.settings.rating_label }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="eis-sp__title">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}

    {%- if review_count > 0 -%}
      <div class="eis-sp__track" data-eis-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="eis-sp__card" {{ block.shopify_attributes }}>
              <div class="eis-sp__stars" aria-hidden="true">
                {%- for i in (1..block.settings.stars) -%}<i>★</i>{%- endfor -%}
              </div>

              <div class="eis-sp__quote">{{ block.settings.quote }}</div>

              {%- if block.settings.tag_1 != blank or block.settings.tag_2 != blank -%}
                <div class="eis-sp__tags">
                  {%- if block.settings.tag_1 != blank -%}
                    <span class="eis-sp__tag"><span aria-hidden="true">&#10004;</span>{{ block.settings.tag_1 }}</span>
                  {%- endif -%}
                  {%- if block.settings.tag_2 != blank -%}
                    <span class="eis-sp__tag"><span aria-hidden="true">&#10004;</span>{{ block.settings.tag_2 }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="eis-sp__by">
                <div class="eis-sp__avatar">
                  {%- if block.settings.avatar != blank -%}
                    {{ block.settings.avatar | image_url: width: 90 | image_tag: widths: '60, 90', sizes: '30px', loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </div>
                <div class="eis-sp__who">
                  <div class="eis-sp__name">{{ block.settings.name }}</div>
                  {%- if block.settings.city != blank -%}
                    <div class="eis-sp__city">{{ block.settings.city }}</div>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_verified -%}
                  <span class="eis-sp__verified"><span aria-hidden="true">&#10004;</span>{{ section.settings.verified_label }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="eis-sp__dots" data-eis-dots role="tablist" aria-label="Choose a review"></div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-eis-track]');
    var dots = root.querySelector('[data-eis-dots]');
    if (!track || !dots) return;

    var cards = track.querySelectorAll('.eis-sp__card');
    if (cards.length < 2) { dots.style.display = 'none'; return; }

    /* One dot per card, each a real control rather than decoration. */
    for (var i = 0; i < cards.length; i++) {
      (function (index) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'eis-sp__dot';
        b.setAttribute('aria-label', 'Review ' + (index + 1) + ' of ' + cards.length);
        b.addEventListener('click', function () {
          track.scrollTo({
            left: cards[index].offsetLeft - track.offsetLeft,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
          });
        });
        dots.appendChild(b);
      })(i);
    }

    var buttons = dots.querySelectorAll('.eis-sp__dot');

    function sync() {
      /* nearest card to the middle of the viewport wins */
      var mid = track.scrollLeft + track.clientWidth / 2;
      var best = 0;
      var bestDist = Infinity;
      for (var i = 0; i < cards.length; i++) {
        var c = cards[i].offsetLeft - track.offsetLeft + cards[i].offsetWidth / 2;
        var d = Math.abs(c - mid);
        if (d < bestDist) { bestDist = d; best = i; }
      }
      for (var j = 0; j < buttons.length; j++) {
        buttons[j].setAttribute('aria-current', j === best ? 'true' : 'false');
      }
    }

    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  })();
</script>

{% schema %}
{
  "name": "EIS — Social proof",
  "tag": "section",
  "class": "eis-section eis-section--social",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept. Use <em>…</em> to highlight words in gold.",
      "default": "EIS Has Transformed\nThe Lives of <em>36,243+</em>"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show the rating row",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Filled stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating text",
      "default": "Rated 4.8 / 5.0"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified badge text",
      "default": "Verified"
    },
    {
      "type": "range",
      "id": "cards_in_view",
      "label": "Reviews in view",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.2,
      "info": "1.2 shows one whole card plus a sliver of the next, which is what tells people the row scrolls."
    },
    {
      "type": "range",
      "id": "face_size_mobile",
      "label": "Face strip size",
