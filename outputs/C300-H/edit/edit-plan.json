        "file": "vo.mp3",
        "in": 37.02,
        "out": 40.22
      },
      "shots": [
        {
          "clip": "clip_11",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg12",
      "role": "body",
      "line": "Nobody tells you it's not one night… it's the first of a hundred like that",
