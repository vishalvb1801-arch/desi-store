        "file": "vo.mp3",
        "in": 158.72,
        "out": 163.7
      },
      "shots": [
        {
          "clip": "clip_45",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg44",
      "role": "body",
      "line": "She said \"It's not your age, jaan… it's what your tablets never reach",
