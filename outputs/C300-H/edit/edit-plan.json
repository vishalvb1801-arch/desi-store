        "file": "vo.mp3",
        "in": 98.66,
        "out": 101.92
      },
      "shots": [
        {
          "clip": "clip_25",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg25",
      "role": "body",
      "line": "I've dyed my greys, I've lost six kilos, and I still don't understand",
