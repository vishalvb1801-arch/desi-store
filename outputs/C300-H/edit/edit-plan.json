        "file": "vo.mp3",
        "in": 143.6,
        "out": 146.96
      },
      "shots": [
        {
          "clip": "clip_41",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg40",
      "role": "body",
      "line": "What I did for him each night, ten minutes, before he'd sleep\"",
