        "file": "vo.mp3",
        "in": 135.3,
        "out": 137.3
      },
      "shots": [
        {
          "clip": "clip_38",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg37",
      "role": "body",
      "line": "Than the lie that nearly took her… but she already had a plan",
