{%- comment -%}
  SOL — Announcement bar
  ------------------------------------------------------------------
  One message, or several, running as a continuous right-to-left
  marquee. Sits above the header.

  The track holds two identical copies of the message list and slides
  by exactly -50%, so the loop is seamless. Each copy is forced to at
  least the full bar width, which keeps the loop gapless even when the
  messages are shorter than the viewport.

  Spacing between messages is a real flex `gap`, so it stays even no
  matter how many messages there are. `space-around` then shares out
  any leftover width, which only happens on wide screens.

  Motion is CSS-only — no JavaScript. Where the visitor has asked for
  reduced motion the marquee is replaced by a centred, wrapped block
  showing every message at once.
{%- endcomment -%}

{% render 'sol-fonts' %}

{%- liquid
  assign pad = section.settings.padding_block
  assign pad_mobile = pad | minus: 3
  if pad_mobile < 6
    assign pad_mobile = 6
  endif
  assign gap = section.settings.item_gap
  assign gap_mobile = gap | times: 6 | divided_by: 10
  if gap_mobile < 14
    assign gap_mobile = 14
  endif
-%}

{% style %}
  {% render 'sol-tokens', id: section.id, s: section.settings %}

  .sol-announce {
    background: var(--sol-maroon-deep);
    font-family: var(--sol-sans);
  }
  .sol-announce__viewport {
    display: flex;
    overflow: hidden;
    padding: {{ pad }}px 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
  }
  .sol-announce__track {
    display: flex;
    flex: none;
    width: max-content;
    min-width: 200%;
    animation: sol-announce-scroll {{ section.settings.scroll_seconds }}s linear infinite;
    will-change: transform;
  }
  .sol-announce__viewport:hover .sol-announce__track,
  .sol-announce__viewport:focus-within .sol-announce__track {
    animation-play-state: paused;
  }
  @keyframes sol-announce-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .sol-announce__group {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: {{ gap }}px;
    padding-right: {{ gap }}px;
  }
  .sol-announce__item {
    display: inline-flex;
    align-items: center;
    gap: .62em;
    font-size: {{ section.settings.font_size }}px;
    color: var(--sol-cream-light);
    text-decoration: none;
    white-space: nowrap;
  }
  a.sol-announce__item:hover { color: var(--sol-gold-light); }
  a.sol-announce__item:focus-visible { outline: 2px solid var(--sol-gold-light); outline-offset: 3px; }
  .sol-announce__msg {
    letter-spacing: .09em;
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1.35;
  }
  .sol-icon {
    width: 1.22em;
    height: 1.22em;
    flex: none;
    color: var(--sol-gold);
    display: block;
  }
  .sol-announce__sep {
    color: var(--sol-gold);
    font-size: {{ section.settings.font_size }}px;
    line-height: 1.35;
    opacity: .7;
    white-space: nowrap;
  }

  @media (max-width: 749px) {
    .sol-announce__viewport { padding: {{ pad_mobile }}px 0; }
    .sol-announce__group { gap: {{ gap_mobile }}px; padding-right: {{ gap_mobile }}px; }
  }

  /* No animation: show every message at once, wrapped and centred. */
  @media (prefers-reduced-motion: reduce) {
    .sol-announce__viewport {
      -webkit-mask-image: none;
      mask-image: none;
      overflow: visible;
    }
    .sol-announce__track {
      animation: none;
      width: 100%;
      min-width: 0;
    }
    .sol-announce__group--clone { display: none; }
    .sol-announce__group {
      flex: 1 1 auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px {{ gap_mobile }}px;
      padding: 0 14px;
      max-width: var(--sol-max);
      margin: 0 auto;
    }
    .sol-announce__sep { display: none; }
  }
{% endstyle %}

{%- capture eis_announce_items -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.link != blank -%}
      <a class="sol-announce__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {%- render 'sol-icon', name: block.settings.icon -%}
        <span class="sol-announce__msg">{{- block.settings.text -}}</span>
      </a>
    {%- else -%}
      <span class="sol-announce__item" {{ block.shopify_attributes }}>
        {%- render 'sol-icon', name: block.settings.icon -%}
        <span class="sol-announce__msg">{{- block.settings.text -}}</span>
      </span>
    {%- endif -%}
    <span class="sol-announce__sep" aria-hidden="true">{{- section.settings.separator -}}</span>
  {%- else -%}
    <span class="sol-announce__item">
      <span class="sol-announce__msg">{{- section.settings.fallback_text -}}</span>
    </span>
    <span class="sol-announce__sep" aria-hidden="true">{{- section.settings.separator -}}</span>
  {%- endfor -%}
{%- endcapture -%}

{%- capture eis_announce_clone -%}
  {%- for block in section.blocks -%}
    <span class="sol-announce__item">
      {%- render 'sol-icon', name: block.settings.icon -%}
      <span class="sol-announce__msg">{{- block.settings.text -}}</span>
    </span>
    <span class="sol-announce__sep">{{- section.settings.separator -}}</span>
  {%- else -%}
    <span class="sol-announce__item">
      <span class="sol-announce__msg">{{- section.settings.fallback_text -}}</span>
    </span>
    <span class="sol-announce__sep">{{- section.settings.separator -}}</span>
  {%- endfor -%}
{%- endcapture -%}

<div class="sol-announce">
  <div class="sol-announce__viewport">
    <div class="sol-announce__track">
      <div class="sol-announce__group">{{ eis_announce_items }}</div>
      <div class="sol-announce__group sol-announce__group--clone" aria-hidden="true">{{ eis_announce_clone }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SOL — Announcement bar",
  "tag": "section",
  "class": "sol-section sol-section--announce",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Message (used when there are no blocks)",
      "default": "Delivery in 3-4 days"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between messages",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "scroll_seconds",
      "label": "Seconds for one full loop (lower = faster)",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 24
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between messages",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 9,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Bar height (padding above and below)",
      "min": 6,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_maroon_deep",
      "label": "Background",
      "default": "#1e3a16"
    },
    {
      "type": "color",
      "id": "color_cream_light",
      "label": "Text",
      "default": "#edf3d6"
    },
    {
      "type": "color",
      "id": "color_gold",
      "label": "Icons and separator",
      "default": "#9cae01"
    },
    {
      "type": "color",
      "id": "color_gold_light",
      "label": "Link hover",
      "default": "#c3d34a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width (reduced-motion fallback only)",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 480
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Delivery in 3-4 days"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "truck", "label": "Delivery van" },
            { "value": "families", "label": "Family / people" },
            { "value": "discount", "label": "Percent" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" },
            { "value": "heart", "label": "Heart" },
            { "value": "spark", "label": "Spark" }
          ],
          "default": "truck"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOL — Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": { "text": "Delivery in 3-4 days", "icon": "truck" }
        },
        {
          "type": "message",
          "settings": { "text": "36,243+ Families Without Pain", "icon": "families" }
        },
        {
          "type": "message",
          "settings": { "text": "Extra Discount On Prepaid", "icon": "discount" }
        }
      ]
    }
  ]
}
{% endschema %}
