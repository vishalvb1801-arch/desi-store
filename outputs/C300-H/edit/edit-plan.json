        "file": "vo.mp3",
        "in": 91.44,
        "out": 95.32
      },
      "shots": [
        {
          "clip": "clip_23",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg24",
      "role": "body",
      "line": "Crying to her sister Neelu, saying things I'd never known",
      "vo": {
        "file": "vo.mp3",
        "in": 95.32,
        "out": 98.66
      },
      "shots": [
        {
          "clip": "clip_24",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg25",
      "role": "body",
      "line": "\"Eight months, Neelu… he won't touch me, won't even hold my hand",
      "vo": {
        "file": "vo.mp3",
        "in": 98.66,
        "out": 101.92
      },
      "shots": [
        {
          "clip": "clip_25",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg26",
      "role": "body",
      "line": "I've dyed my greys, I've lost six kilos, and I still don't understand",
      "vo": {
        "file": "vo.mp3",
        "in": 101.92,
        "out": 105.16
      },
      "shots": [
        {
          "clip": "clip_26",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg27",
      "role": "body",
      "line": "He's on that balcony at 2 AM, on his phone… and I know who",
