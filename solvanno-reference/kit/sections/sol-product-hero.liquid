<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600&display=swap');
  .stock-delivery-wrapper{text-align:center;width:100%;font-family:'Manrope',-apple-system,sans-serif;padding:8px 0;}
  .estimated-delivery{display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:14px;font-weight:500;color:#555;}
  .country-flag{width:20px;height:15px;border-radius:2px;object-fit:cover;display:none;}
</style>
<div class="stock-delivery-wrapper">
