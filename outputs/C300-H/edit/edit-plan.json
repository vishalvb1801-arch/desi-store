        "file": "vo.mp3",
        "in": 118.64,
        "out": 121.88
      },
      "shots": [
        {
          "clip": "clip_33",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg32",
      "role": "body",
      "line": "Just what I'd typed at 2 AM… and it wasn't who she'd blamed",
