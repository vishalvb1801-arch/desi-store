          "clip": "clip_54",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg52",
      "role": "body",
      "line": "She whispered \"Tired?\" and I gave the answer she'd waited eight months for",
      "vo": {
        "file": "vo.mp3",
        "in": 202.66,
        "out": 206.62
      },
      "shots": [
        {
          "clip": "clip_55",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg53",
      "role": "body",
      "line": "\"Not tonight, jaan… not ever again\"",
      "vo": {
        "file": "vo.mp3",
        "in": 206.62,
        "out": 209.72
      },
      "shots": [
        {
          "clip": "clip_56",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg54",
      "role": "body",
      "line": "She switched off the lamp, and this time she turned my way",
      "vo": {
        "file": "vo.mp3",
        "in": 209.72,
        "out": 215.2
      },
      "shots": [
        {
          "clip": "clip_57",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg55",
      "role": "body",
      "line": "\"I'm not tired, jaan\"… no more lying 'bout why",
      "vo": {
        "file": "vo.mp3",
        "in": 215.2,
        "out": 219.93
      },
      "shots": [
        {
          "clip": "clip_58",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg56",
      "role": "body",
      "line": "To every man two feet from his wife",
      "vo": {
        "file": "vo.mp3",
        "in": 219.93,
        "out": 222.68
      },
      "shots": [
        {
          "clip": "clip_59",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg57",
      "role": "body",
      "line": "Saying \"just tired\" every night",
      "vo": {
        "file": "vo.mp3",
        "in": 222.68,
        "out": 224.62
      },
      "shots": [
        {
          "clip": "clip_60",
          "fit": "trim"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg58",
      "role": "body",
      "line": "She doesn't think you're tired… she thinks it's her",
      "vo": {
        "file": "vo.mp3",
        "in": 224.62,
        "out": 228.7
      },
      "shots": [
        {
          "clip": "clip_61",
          "fit": "slow"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    },
    {
      "id": "seg59",
      "role": "cta",
      "line": "Tell her why.",
      "vo": {
        "file": "vo.mp3",
        "in": 228.7,
        "out": 235.05
      },
      "shots": [
        {
          "clip": "clip_49",
          "fit": "trim",
          "duration": 1.31
        },
        {
          "clip": "clip_44",
          "fit": "hold"
        }
      ],
      "transitionIn": {
        "type": "cut"
      }
    }
  ],
  "captions": {
    "enabled": true,
    "style": {
      "font": "Montserrat-ExtraBold",
      "fallbackFont": "NotoSansDevanagari-Bold",
      "size": 72,
      "color": "#FFF4DC",
      "strokeColor": "#770A08",
      "strokeWidth": 8,
      "y": 0.72,
      "maxCharsPerLine": 44,
      "highlightColor": "#F2C14E"
    },
    "items": [
      {
        "segment": "seg01",
        "start": 3.68,
        "end": 5.52,
        "text": "Wore the *red saree*\nfrom our wedding"
      },
      {
        "segment": "seg01",
        "start": 5.52,
        "end": 7.04,
        "text": "whispered\nNo excuses tonight"
      },
      {
        "segment": "seg02",
        "start": 0.0,
        "end": 1.78,
        "text": "But I'd been\nhiding something"
      },
      {
        "segment": "seg02",
        "start": 1.78,
        "end": 3.22,
        "text": "something\nI couldn't let her see"
      },
      {
        "segment": "seg03",
        "start": 0.0,
        "end": 1.62,
        "text": "So I said the\nonly words"
      },
      {
        "segment": "seg03",
        "start": 1.62,
        "end": 3.42,
        "text": "that kept her\nfar away from me"
      },
      {
        "segment": "seg04",
        "start": 0.0,
        "end": 4.58,
        "text": "I'm just *tired*, jaan…\nit's been a long day…"
      },
      {
        "segment": "seg04",
        "start": 4.58,
        "end": 6.38,
        "text": "it's been a long day"
      },
      {
        "segment": "seg05",
        "start": 0.0,
        "end": 2.28,
        "text": "Ten-forty on the\nclock, she smiled"
      },
      {
        "segment": "seg05",
        "start": 2.28,
        "end": 3.54,
        "text": "and then she said okay"
      },
      {
        "segment": "seg06",
        "start": 0.0,
        "end": 1.74,
        "text": "But that okay was\nhiding a question"
      },
      {
        "segment": "seg06",
        "start": 1.74,
        "end": 3.54,
        "text": "she would carry\nevery day"
      },
      {
        "segment": "seg07",
        "start": 0.0,
        "end": 1.42,
        "text": "She switched\noff the lamp"
      },
      {
        "segment": "seg07",
        "start": 1.42,
        "end": 2.84,
        "text": "and turned\nthe other way"
      },
      {
        "segment": "seg08",
        "start": 0.0,
        "end": 2.72,
        "text": "And I lay beside the\nwoman I have loved"
      },
      {
        "segment": "seg08",
        "start": 2.72,
        "end": 3.98,
        "text": "for twenty-four years"
      },
      {
        "segment": "seg09",
        "start": 0.0,
        "end": 1.34,
        "text": "Two feet away,\nlistening"
      },
      {
        "segment": "seg09",
        "start": 1.34,
        "end": 3.06,
        "text": "to a sound\nI still can hear"
      },
      {
        "segment": "seg10",
        "start": 0.0,
        "end": 1.58,
        "text": "Her pretending\nto be sleeping"
      },
      {
        "segment": "seg10",
        "start": 1.58,
        "end": 3.2,
        "text": "so I wouldn't\nsee her tears"
      },
      {
        "segment": "seg11",
        "start": 0.0,
        "end": 2.16,
        "text": "Nobody tells you it's\nnot one night…"
      },
      {
        "segment": "seg11",
        "start": 2.16,
        "end": 4.62,
        "text": "it's the first of\na hundred like that"
      },
      {
        "segment": "seg12",
        "start": 0.0,
        "end": 2.58,
        "text": "I kept one secret\nin my glovebox"
      },
      {
        "segment": "seg12",
        "start": 2.58,
        "end": 4.22,
        "text": "another in my\noffice drawer"
      },
      {
        "segment": "seg13",
        "start": 0.0,
        "end": 1.52,
        "text": "And every night\nby ten-fifteen"
      },
      {
        "segment": "seg13",
        "start": 1.52,
        "end": 3.22,
        "text": "I was too\n*tired* once more"
      },
      {
        "segment": "seg14",
        "start": 0.0,
        "end": 1.64,
        "text": "Sat out my nephew's\nwedding while"
      },
      {
        "segment": "seg14",
        "start": 1.64,
        "end": 3.6,
        "text": "she danced and looked\nat my chair"
      },
      {
        "segment": "seg15",
        "start": 0.0,
        "end": 1.44,
        "text": "And I couldn't\ntell her why"
      },
      {
        "segment": "seg15",
        "start": 1.44,
        "end": 2.82,
        "text": "I wasn't\nstanding there"
      },
      {
        "segment": "seg16",
        "start": 0.0,
        "end": 1.96,
        "text": "Then at *2 AM*\nI'd slip out of"
      },
      {
        "segment": "seg16",
        "start": 1.96,
        "end": 3.2,
        "text": "our bed and\nshut the door"
      },
      {
        "segment": "seg17",
        "start": 0.0,
        "end": 1.24,
        "text": "Out on the balcony"
      },
      {
        "segment": "seg17",
        "start": 1.24,
        "end": 3.04,
        "text": "my phone glowing…\nand she saw"
      },
      {
        "segment": "seg18",
        "start": 0.0,
        "end": 6.86,
        "text": "I'm just *tired*, jaan…"
      },
      {
        "segment": "seg19",
        "start": 0.0,
        "end": 2.36,
        "text": "Same three words\nevery night"
      },
      {
        "segment": "seg19",
        "start": 2.36,
        "end": 6.2,
        "text": "under the\nbedroom light"
      },
      {
        "segment": "seg20",
        "start": 0.0,
        "end": 4.54,
        "text": "I'm just *tired*, jaan…"
      },
      {
        "segment": "seg21",
        "start": 0.0,
        "end": 5.34,
        "text": "But I'm *tired*…"
      },
      {
        "segment": "seg21",
        "start": 5.34,
        "end": 8.9,
        "text": "of lying 'bout why"
      },
      {
        "segment": "seg22",
        "start": 0.0,
        "end": 2.68,
        "text": "Then one Sunday\nI came home early"
      },
      {
        "segment": "seg22",
        "start": 2.68,
        "end": 3.88,
        "text": "heard her on the phone"
      },
      {
        "segment": "seg23",
        "start": 0.0,
        "end": 1.71,
        "text": "Crying to her\nsister Neelu"
      },
      {
        "segment": "seg23",
        "start": 1.71,
        "end": 3.34,
        "text": "saying things\nI'd never known"
      },
      {
        "segment": "seg24",
        "start": 0.0,
        "end": 1.86,
        "text": "*Eight months*, Neelu…\nhe won't touch me"
      },
      {
        "segment": "seg24",
        "start": 1.86,
        "end": 3.26,
        "text": "won't even\nhold my hand"
      },
      {
        "segment": "seg25",
        "start": 0.0,
        "end": 1.86,
        "text": "I've dyed my greys,\nI've lost six kilos"
      },
      {
        "segment": "seg25",
        "start": 1.86,
        "end": 3.24,
        "text": "and I still\ndon't understand"
      },
      {
        "segment": "seg26",
        "start": 0.0,
        "end": 2.04,
        "text": "He's on that\nbalcony at *2 AM*"
      },
      {
        "segment": "seg26",
        "start": 2.04,
        "end": 3.43,
        "text": "on his phone…\nand I know who"
      },
      {
        "segment": "seg27",
        "start": 0.0,
        "end": 1.45,
        "text": "There's someone\nelse, Neelu…"
      },
      {
        "segment": "seg27",
        "start": 1.45,
        "end": 3.35,
        "text": "what else could\nhe be doing at two?"
      },
      {
        "segment": "seg28",
        "start": 0.0,
        "end": 1.72,
        "text": "And I stood there\nin that hallway"
      },
      {
        "segment": "seg28",
        "start": 1.72,
        "end": 3.24,
        "text": "watching my\nlittle lie grow"
      },
      {
        "segment": "seg29",
        "start": 0.0,
        "end": 1.76,
        "text": "Into something worse\nthan the truth…"
      },
      {
        "segment": "seg29",
        "start": 1.76,
        "end": 3.46,
        "text": "and the worst\nwas yet to show"
      },
      {
        "segment": "seg30",
        "start": 0.0,
        "end": 1.72,
        "text": "She scrolled through\nevery message"
      },
      {
        "segment": "seg30",
        "start": 1.72,
        "end": 3.24,
        "text": "every call,\nand found no name"
      },
      {
        "segment": "seg31",
        "start": 0.0,
        "end": 1.96,
        "text": "Just what I'd\ntyped at *2 AM*…"
      },
      {
        "segment": "seg31",
        "start": 1.96,
        "end": 3.42,
        "text": "and it wasn't\nwho she'd blamed"
      },
      {
        "segment": "seg32",
        "start": 0.0,
        "end": 1.62,
        "text": "*Back pain*\nonly at night…"
      },
      {
        "segment": "seg32",
        "start": 1.62,
        "end": 3.58,
        "text": "How do I hide it\nfrom my wife?"
      },
      {
        "segment": "seg33",
        "start": 0.0,
        "end": 1.46,
        "text": "She stood there\nin the doorway"
      },
      {
        "segment": "seg33",
        "start": 1.46,
        "end": 3.08,
        "text": "held that phone up\nto my face"
      },
      {
        "segment": "seg34",
        "start": 0.0,
        "end": 1.88,
        "text": "Said Is THIS her? Is\nthis the *other woman*?"
      },
      {
        "segment": "seg34",
        "start": 1.88,
        "end": 3.34,
        "text": "and she fell\nin my embrace"
      },
      {
        "segment": "seg35",
        "start": 0.0,
        "end": 1.12,
        "text": "'Cause in my head,\nthe truth"
      },
      {
        "segment": "seg35",
        "start": 1.12,
        "end": 2.0,
        "text": "made me less of a man"
      },
      {
        "segment": "seg36",
        "start": 0.0,
        "end": 2.46,
        "text": "Than the lie… but\nshe already had a plan"
      },
      {
        "segment": "seg37",
        "start": 0.0,
        "end": 2.54,
        "text": "Next morning she\ncalled her mother back"
      },
      {
        "segment": "seg37",
        "start": 2.54,
        "end": 3.84,
        "text": "in Nashik on the phone"
      },
      {
        "segment": "seg38",
        "start": 0.0,
        "end": 1.92,
        "text": "Ma said Your Papa's\nback went at fifty…"
      },
      {
        "segment": "seg38",
        "start": 1.92,
        "end": 3.36,
        "text": "and there's something\nI never told"
      },
      {
        "segment": "seg39",
        "start": 0.0,
        "end": 1.57,
        "text": "What I did for\nhim each night"
      },
      {
        "segment": "seg39",
        "start": 1.57,
        "end": 2.98,
        "text": "ten minutes,\nbefore he'd sleep"
      },
      {
        "segment": "seg40",
        "start": 0.0,
        "end": 1.26,
        "text": "That night there\nwas something"
      },
      {
        "segment": "seg40",
        "start": 1.26,
        "end": 3.72,
        "text": "on my pillow, and a\npromise she would keep"
      },
      {
        "segment": "seg41",
        "start": 0.0,
        "end": 1.42,
        "text": "An amber bottle"
      },
      {
        "segment": "seg41",
        "start": 1.42,
        "end": 3.75,
        "text": "*EIS* Ayurvedic\nPain Relief Oil"
      },
      {
        "segment": "seg41",
        "start": 3.75,
        "end": 5.06,
        "text": "*fifteen herbs* inside"
      },
      {
        "segment": "seg42",
        "start": 0.0,
        "end": 1.42,
        "text": "I laughed,\nAnother oil?"
      },
      {
        "segment": "seg42",
        "start": 1.42,
        "end": 3.28,
        "text": "She said Lie down.\nTurn over."
      },
      {
        "segment": "seg42",
        "start": 3.28,
        "end": 4.98,
        "text": "Then decide."
      },
      {
        "segment": "seg43",
        "start": 0.0,
        "end": 2.56,
        "text": "She said It's\nnot your age, jaan…"
      },
      {
        "segment": "seg43",
        "start": 2.56,
        "end": 4.94,
        "text": "it's what your\n*tablets* never reach"
      },
      {
        "segment": "seg44",
        "start": 0.0,
        "end": 1.6,
        "text": "*Inflammation*,\nlocked in deep"
      },
      {
        "segment": "seg44",
        "start": 1.6,
        "end": 3.32,
        "text": "where sprays just\nsit up on the skin"
      },
      {
        "segment": "seg45",
        "start": 0.0,
        "end": 1.98,
        "text": "*Warm massage* works\nthe stiffness loose"
      },
      {
        "segment": "seg45",
        "start": 1.98,
        "end": 3.7,
        "text": "so *fifteen herbs*\ncan settle in"
      },
      {
        "segment": "seg46",
        "start": 0.0,
        "end": 2.72,
        "text": "Mahanarayan,\nNirgundi, Ashwagandha"
      },
      {
        "segment": "seg46",
        "start": 2.72,
        "end": 4.56,
        "text": "camphor, mint"
      },
      {
        "segment": "seg47",
        "start": 0.0,
        "end": 2.46,
        "text": "Night one,\nher hands on my back"
      },
      {
        "segment": "seg47",
        "start": 2.46,
        "end": 4.28,
        "text": "first time she'd\ntouched me in a year"
      },
      {
        "segment": "seg48",
        "start": 0.0,
        "end": 2.54,
        "text": "Night three, I slept\nstraight through…"
      },
      {
        "segment": "seg48",
        "start": 2.54,
        "end": 5.04,
        "text": "and woke to find her\nwatching me in tears"
      },
      {
        "segment": "seg49",
        "start": 0.0,
        "end": 1.96,
        "text": "*Week six*,\nback on morning walks"
      },
      {
        "segment": "seg49",
        "start": 1.96,
        "end": 5.2,
        "text": "standing tall,\nand Friday was near"
      },
      {
        "segment": "seg50",
        "start": 0.0,
        "end": 2.42,
        "text": "That Friday\nI stayed up"
      },
      {
        "segment": "seg50",
        "start": 2.42,
        "end": 3.92,
        "text": "didn't fall\nasleep at ten"
      },
      {
        "segment": "seg51",
        "start": 0.0,
        "end": 2.08,
        "text": "She came out in\nthat *red saree*"
      },
      {
        "segment": "seg51",
        "start": 2.08,
        "end": 4.0,
        "text": "nervous like our\nfirst night again"
      },
      {
        "segment": "seg52",
        "start": 0.0,
        "end": 2.34,
        "text": "She whispered *Tired*?\nand I gave the answer"
      },
      {
        "segment": "seg52",
        "start": 2.34,
        "end": 3.96,
        "text": "she'd waited\n*eight months* for"
      },
      {
        "segment": "seg53",
        "start": 0.0,
        "end": 3.1,
        "text": "Not tonight, jaan…\nnot ever again"
      },
      {
        "segment": "seg54",
        "start": 0.0,
        "end": 3.28,
        "text": "She switched\noff the lamp"
      },
      {
        "segment": "seg54",
        "start": 3.28,
        "end": 5.48,
        "text": "and this time\nshe turned my way"
      },
      {
        "segment": "seg55",
        "start": 0.0,
        "end": 2.56,
        "text": "I'm *not tired*, jaan…"
      },
      {
        "segment": "seg55",
        "start": 2.56,
        "end": 4.73,
        "text": "no more lying\n'bout why"
      },
      {
        "segment": "seg56",
        "start": 0.0,
        "end": 2.75,
        "text": "To every man two feet\nfrom his wife"
      },
      {
        "segment": "seg57",
        "start": 0.0,
        "end": 1.94,
        "text": "Saying just *tired*\nevery night"
      },
      {
        "segment": "seg58",
        "start": 0.0,
        "end": 2.04,
        "text": "She doesn't think\nyou're *tired*…"
      },
      {
        "segment": "seg58",
        "start": 2.04,
        "end": 4.08,
        "text": "she thinks it's her"
      },
      {
        "segment": "seg59",
        "start": 0.0,
        "end": 6.35,
        "text": "Tell her why."
      }
    ]
  },
